#!/usr/bin/env bash

set -u

notify() {
    command -v dunstify >/dev/null 2>&1 || return
    dunstify --app-name Bluetooth --stack-tag bluetooth-profile --timeout 2000 \
        "$1" "${2:-}" >/dev/null 2>&1 || true
}

source=$(pactl list sources 2>/dev/null | awk '
    $1 == "Name:" && $2 ~ /^bluez_input\./ { print $2; exit }
')
if [[ -z $source ]]; then
    notify "Bluetooth microphone unavailable" "No connected HFP microphone"
    exit
fi

pactl set-source-mute "$source" toggle
muted=$(pactl get-source-mute "$source" | awk '{ print $2 }')
bluetooth-profile-led --once
if [[ $muted == yes ]]; then
    notify "Bluetooth microphone" "Microphone muted"
else
    notify "Bluetooth microphone" "Microphone active"
fi

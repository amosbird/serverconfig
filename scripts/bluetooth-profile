#!/usr/bin/env bash

set -u

metadata=(pw-metadata -n default)
mode_key=freeclip.session.desired-mode
command_key=freeclip.session.command
request_key=freeclip.session.request-id

notify() {
    command -v dunstify >/dev/null 2>&1 || return
    dunstify --app-name Bluetooth --stack-tag bluetooth-profile --timeout 2000 \
        "$1" "${2:-}" >/dev/null 2>&1 || true
}

read_value() {
    "${metadata[@]}" 0 "$1" 2>/dev/null | sed -n \
        "s/.*value:'\"\\([^\"]*\\)\"'.*/\\1/p" | tail -n 1
}

write_json() {
    "${metadata[@]}" 0 "$1" "\"$2\"" Spa:String:JSON >/dev/null
}

request() {
    write_json "$request_key" "$(date +%s%N)-$$"
}

case ${1:-toggle} in
a2dp|hfp)
    mode=$1
    write_json "$mode_key" "$mode" || exit 1
    write_json "$command_key" apply || exit 1
    request
    notify "Bluetooth profile" "$( [[ $mode == hfp ]] && printf HFP/mSBC || printf A2DP )"
    ;;
toggle)
    case $(read_value "$mode_key") in
    hfp) mode=a2dp ;;
    *) mode=hfp ;;
    esac
    write_json "$mode_key" "$mode" || exit 1
    write_json "$command_key" apply || exit 1
    request
    notify "Bluetooth profile" "$( [[ $mode == hfp ]] && printf HFP/mSBC || printf A2DP )"
    ;;
retry)
    write_json "$command_key" retry || exit 1
    request
    notify "Bluetooth profile" "Retry requested"
    ;;
status)
    mode=$(read_value "$mode_key")
    state=$(read_value freeclip.session.state)
    error=$(read_value freeclip.session.error)
    if [[ ${2:-} == --json ]]; then
        printf '{"desired_mode":"%s","state":"%s","error":"%s"}\n' \
            "$mode" "$state" "$error"
    else
        printf 'desired mode: %s\nstate: %s\n' "${mode:-unknown}" "${state:-unknown}"
        [[ -z $error ]] || printf 'error: %s\n' "$error"
    fi
    ;;
*)
    printf 'usage: %s [toggle|a2dp|hfp|retry|status [--json]]\n' "${0##*/}" >&2
    exit 2
    ;;
esac

#!/usr/bin/env python3

import json
import subprocess
import time

PROBE_NAME = "bluetooth-sco-watchdog"
DEBOUNCE_SECONDS = 0.2


class SystemOps:
    @staticmethod
    def _list(kind):
        result = subprocess.run(
            ["pactl", "--format=json", "list", kind],
            capture_output=True,
            check=False,
            text=True,
        )
        if result.returncode:
            return []
        try:
            return json.loads(result.stdout)
        except json.JSONDecodeError:
            return []

    def snapshot(self):
        return (
            self._list("sinks"),
            self._list("sources"),
            self._list("sink-inputs"),
            self._list("source-outputs"),
        )

    def defaults(self):
        sink = subprocess.run(
            ["pactl", "get-default-sink"], capture_output=True, check=False, text=True
        )
        source = subprocess.run(
            ["pactl", "get-default-source"], capture_output=True, check=False, text=True
        )
        return sink.stdout.strip(), source.stdout.strip()

    @staticmethod
    def call(*args):
        subprocess.run(["pactl", *args], check=False)


class Router:
    def __init__(self, ops):
        self.ops = ops
        self.sink = None
        self.source = None
        self.sink_inputs = set()
        self.source_outputs = set()

    def route(self):
        sinks, sources, sink_inputs, source_outputs = self.ops.snapshot()
        default_sink, default_source = self.ops.defaults()
        sink = next((item for item in sinks if item["name"].startswith("bluez_output.")), None)
        source = next(
            (item for item in sources if item["name"].startswith("bluez_input.")), None
        )

        if sink:
            name = sink["name"]
            identity = sink["index"], name
            active_inputs = {str(stream["index"]) for stream in sink_inputs}
            self.sink_inputs.intersection_update(active_inputs)
            if default_sink != name:
                self.ops.call("set-default-sink", name)
            if identity != self.sink:
                self.ops.call("set-sink-mute", name, "0")
                self.sink = identity
            for stream in sink_inputs:
                index = str(stream["index"])
                if stream.get("sink") != sink["index"]:
                    self.ops.call("move-sink-input", index, name)
                if index not in self.sink_inputs:
                    self.ops.call("set-sink-input-mute", index, "0")
                    self.sink_inputs.add(index)
        else:
            self.sink = None
            self.sink_inputs.clear()

        if source:
            name = source["name"]
            identity = source["index"], name
            active_outputs = {str(stream["index"]) for stream in source_outputs}
            self.source_outputs.intersection_update(active_outputs)
            if default_source != name:
                self.ops.call("set-default-source", name)
            if identity != self.source:
                self.ops.call("set-source-mute", name, "0")
                self.source = identity
            for stream in source_outputs:
                properties = stream.get("properties", {})
                if properties.get("application.name") == PROBE_NAME:
                    continue
                index = str(stream["index"])
                if stream.get("source") != source["index"]:
                    self.ops.call("move-source-output", index, name)
                if index not in self.source_outputs:
                    self.ops.call("set-source-output-mute", index, "0")
                    self.source_outputs.add(index)
        else:
            self.source = None
            self.source_outputs.clear()


def main():
    router = Router(SystemOps())
    router.route()
    process = subprocess.Popen(
        ["pactl", "subscribe"], stdout=subprocess.PIPE, text=True
    )
    assert process.stdout is not None
    for event in process.stdout:
        if any(
            name in event
            for name in (
                "on card",
                "on server",
                "on sink",
                "on source",
                "on sink-input",
                "on source-output",
            )
        ):
            # shortcut: debounce event bursts; replace with native PipeWire bindings if routing grows.
            time.sleep(DEBOUNCE_SECONDS)
            router.route()


if __name__ == "__main__":
    main()

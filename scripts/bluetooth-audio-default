#!/usr/bin/env python3

import json
import os
import pathlib
import subprocess
import time

PROBE_NAME = "bluetooth-sco-watchdog"
STATE_DIR = pathlib.Path(
    os.environ.get("XDG_STATE_HOME", pathlib.Path.home() / ".local/state")
) / "audio-mute"
DEBOUNCE_SECONDS = 0.2


class SystemOps:
    @staticmethod
    def _list(kind):
        result = subprocess.run(
            ["pactl", "--format=json", "list", kind],
            capture_output=True,
            check=False,
            text=True,
        )
        if result.returncode:
            return []
        try:
            return json.loads(result.stdout)
        except json.JSONDecodeError:
            return []

    def snapshot(self):
        return (
            self._list("sinks"),
            self._list("sources"),
            self._list("sink-inputs"),
            self._list("source-outputs"),
        )

    def defaults(self):
        sink = subprocess.run(
            ["pactl", "get-default-sink"], capture_output=True, check=False, text=True
        )
        source = subprocess.run(
            ["pactl", "get-default-source"], capture_output=True, check=False, text=True
        )
        return sink.stdout.strip(), source.stdout.strip()

    @staticmethod
    def _read_mute_intent(name):
        try:
            value = (STATE_DIR / name).read_text().strip()
        except OSError:
            return None
        return value == "1" if value in {"0", "1"} else None

    def desired_mutes(self):
        return self._read_mute_intent("speaker"), self._read_mute_intent("microphone")

    @staticmethod
    def call(*args):
        subprocess.run(["pactl", *args], check=False)


class Router:
    def __init__(self, ops):
        self.ops = ops
        self.sink = None
        self.source = None

    def route(self):
        sinks, sources, sink_inputs, source_outputs = self.ops.snapshot()
        default_sink, default_source = self.ops.defaults()
        sink_mute, source_mute = self.ops.desired_mutes()
        sink = next((item for item in sinks if item["name"].startswith("bluez_output.")), None)
        source = next(
            (item for item in sources if item["name"].startswith("bluez_input.")), None
        )

        if sink:
            name = sink["name"]
            identity = sink["index"], name
            if default_sink != name:
                self.ops.call("set-default-sink", name)
            if identity != self.sink and sink_mute is not None:
                self.ops.call("set-sink-mute", name, str(int(sink_mute)))
            self.sink = identity
            for stream in sink_inputs:
                index = str(stream["index"])
                if stream.get("sink") != sink["index"]:
                    self.ops.call("move-sink-input", index, name)
        else:
            self.sink = None

        if source:
            name = source["name"]
            identity = source["index"], name
            if default_source != name:
                self.ops.call("set-default-source", name)
            if identity != self.source and source_mute is not None:
                self.ops.call("set-source-mute", name, str(int(source_mute)))
            self.source = identity
            for stream in source_outputs:
                properties = stream.get("properties", {})
                if properties.get("application.name") == PROBE_NAME:
                    continue
                index = str(stream["index"])
                if stream.get("source") != source["index"]:
                    self.ops.call("move-source-output", index, name)
        else:
            self.source = None


def main():
    router = Router(SystemOps())
    router.route()
    process = subprocess.Popen(
        ["pactl", "subscribe"], stdout=subprocess.PIPE, text=True
    )
    assert process.stdout is not None
    for event in process.stdout:
        if any(
            name in event
            for name in (
                "on card",
                "on server",
                "on sink",
                "on source",
                "on sink-input",
                "on source-output",
            )
        ):
            # shortcut: debounce event bursts; replace with native PipeWire bindings if routing grows.
            time.sleep(DEBOUNCE_SECONDS)
            router.route()


if __name__ == "__main__":
    main()

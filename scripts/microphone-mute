#!/usr/bin/env bash

set -u

notify() {
    command -v dunstify >/dev/null 2>&1 || return
    dunstify --app-name Microphone --stack-tag microphone-mute --timeout 2000 \
        "$1" >/dev/null 2>&1 || true
}

if ! pactl set-source-mute @DEFAULT_SOURCE@ toggle; then
    notify "Microphone unavailable"
    exit 1
fi

muted=$(pactl get-source-mute @DEFAULT_SOURCE@ | awk '{ print $2 }')
audio-mute-state microphone
audio-mute-led --once
if [[ $muted == yes ]]; then
    notify "Microphone muted"
else
    notify "Microphone active"
fi

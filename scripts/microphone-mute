#!/usr/bin/env bash

set -euo pipefail

target=@DEFAULT_AUDIO_SOURCE@
notify() {
    command -v dunstify >/dev/null 2>&1 || return
    dunstify --app-name Microphone --stack-tag microphone-mute --timeout 2000 \
        "$1" >/dev/null 2>&1 || true
}

if ! wpctl set-mute "$target" toggle; then
    notify "Microphone unavailable"
    exit 1
fi

status=$(wpctl get-volume "$target")
command -v audio-mute-led >/dev/null 2>&1 && audio-mute-led --once
if [[ $status == *MUTED* ]]; then
    notify "Microphone muted"
else
    notify "Microphone active"
fi

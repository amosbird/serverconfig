#!/usr/bin/env bash

set -euo pipefail

needs_git_pkg_rebuild() {
    local pkg_name="$1"
    local remote_url="$2"

    pacman -Q "$pkg_name" >/dev/null 2>&1 || return 1

    local pkg_line remote_line installed remote
    pkg_line=$(pacman -Q "$pkg_name")
    if [[ "$pkg_line" =~ \.g([0-9a-f]+)-[0-9]+$ ]]; then
        installed="${BASH_REMATCH[1]}"
    else
        return 1
    fi

    remote_line=$(git ls-remote "$remote_url" HEAD)
    read -r remote _ <<< "$remote_line"
    remote="${remote:0:${#installed}}"

    [ -n "$installed" ] && [ -n "$remote" ] && [ "$installed" != "$remote" ]
}

vcs_packages=(
    "kitty-git"
    "freerdp-git"
    "xkeysnail-git"
)

vcs_remotes=(
    "https://github.com/amosbird/kitty.git"
    "https://github.com/amosbird/FreeRDP.git"
    "https://github.com/amosbird/xkeysnail.git"
)

rebuild_packages=()

# The DKMS build runs from a pacman hook and prints nothing but a dot every
# three seconds, which is indistinguishable from a hang. Echo the tail of its
# make.log while the wrapped command runs.
dkms_watch_logs() {
    local root="${DKMS_LOG_ROOT:-/var/lib/dkms}"
    local start last="" log stamp
    local -a parts
    start=$(date +%s)
    while :; do
        sleep 5
        log=$(find "$root" -name make.log -printf '%T@ %p\n' 2>/dev/null |
            sort -nr | head -1 | cut -d' ' -f2-)
        [[ -n "$log" ]] || continue
        stamp=$(stat -c %Y "$log" 2>/dev/null) || continue
        (( stamp >= start )) || continue
        [[ "$stamp" == "$last" ]] && continue
        last="$stamp"
        IFS=/ read -r -a parts <<< "${log#"$root"/}"
        printf '  [dkms %s/%s %s] %s\n' "${parts[0]}" "${parts[1]}" \
            "$(date -d "@$stamp" +%H:%M:%S)" "$(tail -n 1 "$log" | cut -c1-100)"
    done
}

run_watched() {
    local watcher rc=0
    dkms_watch_logs &
    watcher=$!
    "$@" || rc=$?
    kill "$watcher" 2>/dev/null || true
    wait "$watcher" 2>/dev/null || true
    return "$rc"
}

paru -Sy --noconfirm archlinux-keyring
run_watched paru -Syu --noconfirm

tmp_dir=$(mktemp -d)
trap 'rm -rf "$tmp_dir"' EXIT

pids=()
for i in "${!vcs_packages[@]}"; do
    pkg_name="${vcs_packages[$i]}"
    remote_url="${vcs_remotes[$i]}"
    (
        if needs_git_pkg_rebuild "$pkg_name" "$remote_url"; then
            printf '%s\n' "$pkg_name" > "$tmp_dir/$i"
        fi
    ) &
    pids+=("$!")
done

for pid in "${pids[@]}"; do
    wait "$pid"
done

# shortcut: only rebuild the explicitly managed VCS packages; add other local packages
# to vcs_packages/vcs_remotes if they also need automatic ABI rebuilds
while read -r repository pkg_name; do
    [[ "$repository" == foreign ]] || continue
    for i in "${!vcs_packages[@]}"; do
        if [[ "$pkg_name" == "${vcs_packages[$i]}" ]]; then
            printf '%s\n' "$pkg_name" > "$tmp_dir/$i"
        fi
    done
done < <(checkrebuild)

for i in "${!vcs_packages[@]}"; do
    marker="$tmp_dir/$i"
    if [ -f "$marker" ]; then
        rebuild_packages+=("$(<"$marker")")
    fi
done

if ((${#rebuild_packages[@]} > 0)); then
    run_watched paru -S --noconfirm --rebuild "${rebuild_packages[@]}"
fi

# A hook that fails only warns, leaving the module stuck at "added"/"built".
stuck=$(dkms status 2>/dev/null | grep -v ': installed$' || true)
if [[ -n "$stuck" ]]; then
    printf '警告：以下 DKMS 模块未安装成功：\n%s\n' "$stuck" >&2
fi

"$HOME/scripts/update-mambatools"

if [[ -x "$HOME/.local/bin/mise" ]]; then
    export GITHUB_TOKEN=${GITHUB_TOKEN:-$(pass show github/api-token 2>/dev/null)}
    "$HOME/.local/bin/mise" self-update -y
    "$HOME/.local/bin/mise" upgrade -y
    "$HOME/.local/bin/mise" prune -y
    "$HOME/.local/bin/mise" bin-paths | while IFS= read -r bin; do
        [[ -d "$bin" ]] || continue
        for f in "$bin"/*; do
            if [[ -f "$f" && -x "$f" ]]; then
                ln -sf "$f" "$HOME/.local/bin/"
            fi
        done
    done
fi

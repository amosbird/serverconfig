#!/usr/bin/env bash

if [[ $# -gt 1 ]]; then
    printf 'usage: luakit [URL_OR_PATH]\n' >&2
    exit 2
fi

if [[ $# -eq 0 ]]; then
    exec "${ABUSH_CHROMIUM_LAUNCHER:-"$HOME"/scripts/chromium}"
fi

value=$1
if [[ -e $value ]]; then
    value=$(python3 - "$value" <<'PY'
import pathlib
import sys

print(pathlib.Path(sys.argv[1]).resolve().as_uri())
PY
    ) || exit
fi

exec "${ABUSH_CHROMIUM_LAUNCHER:-"$HOME"/scripts/chromium}" "$value"

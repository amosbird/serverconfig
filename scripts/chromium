#!/usr/bin/env bash

profile=${ABUSH_CHROME_PROFILE:-"$HOME/.config/google-chrome-main"}
chrome=${ABUSH_CHROME_BIN:-/usr/bin/google-chrome-stable}
root=${ABUSH_SERVERCONFIG_ROOT:-/home/amos/git/serverconfig}
host="$profile/NativeMessagingHosts/io.github.amosbird.browser_router.json"
mkdir -p "$(dirname "$host")"
ln -sf "$root/chromium/external-links/native-host.json" "$host"

focus_main_group() {
    printf '%s' '[[["group","f"]],"toscreen",[],{},true]' \
        | nc -U -N "$HOME/.cache/qtile/qtilesocket.$DISPLAY" >/dev/null
}

chrome_args=(
    --user-data-dir="$profile"
    --no-default-browser-check
    --silent-debugger-extension-api
    --remote-debugging-port=9222
    --restore-last-session
    --hide-crash-restore-bubble
    --disable-features=OverscrollHistoryNavigation,TouchpadOverscrollHistoryNavigation
    --disable-smooth-scrolling
)

start_chrome() {
    "$chrome" "${chrome_args[@]}"
}

launch_chrome() {
    exec "$chrome" "${chrome_args[@]}"
}

update_external_links_profile() {
    "$root/scripts/update-external-links-profile" "$profile"
}

profile_is_running() {
    local status
    if python3 "$root/scripts/chrome-profile-running.py" \
        "${ABUSH_PROC_ROOT:-/proc}" "$profile"; then
        return 0
    else
        status=$?
    fi
    if [[ $status -ne 1 ]]; then
        printf 'chromium: unable to inspect Chrome profile processes\n' >&2
        exit "$status"
    fi
    return 1
}

focus_group=true
if [[ ${1:-} == --current-group ]]; then
    focus_group=false
    shift
fi

if [[ $# -eq 1 && $1 != -* ]]; then
    url=$1
    if [[ $url != http://* && $url != https://* && $url != file:///* ]]; then
        printf 'chromium: unsupported URL scheme\n' >&2
        exit 2
    fi
    chrome_running=false
    if profile_is_running; then
        chrome_running=true
    fi
    if [[ -z ${XDG_RUNTIME_DIR:-} ]]; then
        printf 'chromium: XDG_RUNTIME_DIR is unavailable\n' >&2
        exit 1
    fi
    request_id=$(python3 - <<'PY'
import uuid
print(uuid.uuid4().hex)
PY
    ) || exit
    timeout=${ABUSH_ORDINARY_OPEN_TIMEOUT:-30}
    deadline_ms=$(python3 - "$timeout" <<'PY'
import sys
import time

timeout = float(sys.argv[1])
if timeout <= 0 or timeout > 60:
    raise SystemExit("ordinary-open timeout is outside its safe range")
print(int(time.time() * 1000 + timeout * 1000))
PY
    ) || exit
    lease_path=
    if ! $chrome_running; then
        update_external_links_profile || exit
        lease_output=${XDG_RUNTIME_DIR}/abush/ordinary-launch-metadata.$request_id
        mkdir -p "$(dirname "$lease_output")"
        chmod 700 "$(dirname "$lease_output")"
        rm -f "$lease_output"
        if ! ABUSH_ORDINARY_OPEN_REQUEST_ID="$request_id" \
            ABUSH_ORDINARY_OPEN_DEADLINE_MS="$deadline_ms" \
            ABUSH_ORDINARY_OPEN_WRITE_LEASE=1 \
            ABUSH_ORDINARY_OPEN_LEASE_ONLY=1 \
            ABUSH_ORDINARY_OPEN_LEASE_METADATA="$lease_output" \
            ABUSH_CHROME_PROFILE="$profile" \
            python3 "$root/scripts/ordinary-open-client.py" "$url"; then
            rm -f "$lease_output"
            exit 1
        fi
        lease_path=$(python3 -c \
            'import json,sys; print(json.load(open(sys.argv[1]))["lease_path"])' \
            "$lease_output") || {
            rm -f "$lease_output"
            exit 1
        }
        rm -f "$lease_output"
        start_chrome >/dev/null 2>&1 &
    fi
    ABUSH_ORDINARY_OPEN_REQUEST_ID="$request_id" \
        ABUSH_ORDINARY_OPEN_DEADLINE_MS="$deadline_ms" \
        ABUSH_ORDINARY_OPEN_LEASE_PATH="$lease_path" \
        ABUSH_CHROME_PROFILE="$profile" \
        exec python3 "$root/scripts/ordinary-open-client.py" "$url"
fi

if [[ $# -gt 0 ]]; then
    printf 'chromium: flags and app launches require a dedicated profile launcher\n' >&2
    exit 2
fi

if ! profile_is_running; then
    update_external_links_profile || exit
fi
if $focus_group; then
    focus_main_group
fi
launch_chrome

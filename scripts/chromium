#!/usr/bin/env bash

profile="$HOME/.config/google-chrome-main"
host="$profile/NativeMessagingHosts/io.github.amosbird.browser_router.json"
mkdir -p "$(dirname "$host")"
ln -sf /home/amos/git/serverconfig/chromium/external-links/native-host.json "$host"

focus_main_group() {
    printf '%s' '[[["group","f"]],"toscreen",[],{},true]' \
        | nc -U -N "$HOME/.cache/qtile/qtilesocket.$DISPLAY" >/dev/null
}

focus_group=true
if [[ ${1:-} == --current-group ]]; then
    focus_group=false
    shift
else
    focus_main_group
fi

if chromium-remote "$@"; then
    if $focus_group; then
        focus_main_group
    fi
    exit
fi

exec /usr/bin/google-chrome-stable \
    --user-data-dir="$profile" \
    --no-default-browser-check \
    --remote-debugging-port=9222 \
    --restore-last-session \
    --hide-crash-restore-bubble \
    --disable-features=OverscrollHistoryNavigation,TouchpadOverscrollHistoryNavigation \
    --disable-smooth-scrolling \
    "$@"

#!/usr/bin/env bash

if [[ $# -ne 1 ]]; then
    printf 'usage: chromium URL\n' >&2
    exit 2
fi

url=$1
profile=${ABUSH_CHROME_PROFILE:-$HOME/.config/google-chrome-main}
chrome=${ABUSH_CHROME_BIN:-/usr/bin/google-chrome-stable}
root=${ABUSH_SERVERCONFIG_ROOT:-/home/amos/git/serverconfig}
host="$profile/NativeMessagingHosts/io.github.amosbird.browser_router.json"
mkdir -p "$(dirname "$host")"
ln -sf "$root/chromium/external-links/native-host.json" "$host"

proc_root=${ABUSH_PROC_ROOT:-/proc}
chrome_running() {
    local process cmdline
    for process in "$proc_root"/[0-9]*/cmdline; do
        [[ -r $process ]] || continue
        cmdline=$(tr '\0' '\n' < "$process" 2>/dev/null) || continue
        if grep -Fqx -- "--user-data-dir=$profile" <<< "$cmdline"; then
            return 0
        fi
    done
    return 1
}

if ! chrome_running; then
    "$chrome" \
        --user-data-dir="$profile" \
        --no-default-browser-check \
        --silent-debugger-extension-api \
        --remote-debugging-port=9222 \
        --restore-last-session \
        --hide-crash-restore-bubble \
        --disable-features=OverscrollHistoryNavigation,TouchpadOverscrollHistoryNavigation \
        --disable-smooth-scrolling \
        >/dev/null 2>&1 &
fi

exec python3 "$root/scripts/ordinary-open-client.py" "$url"

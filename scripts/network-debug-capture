#!/usr/bin/env bash
set -uo pipefail

SYSTEMCTL=${SYSTEMCTL:-/usr/bin/systemctl}
TIMEOUT=${TIMEOUT:-/usr/bin/timeout}
TCPDUMP=${TCPDUMP:-/usr/bin/tcpdump}
RING_DIR=${RING_DIR:-/var/log/network-debug/ring}
MAX_TEXT_BYTES=1048576

diagnostic_commands=()
deep_wlan_pid=
deep_tail_pid=

sanitize_note() {
    LC_ALL=C tr -d '[:cntrl:]'
}

append_manifest() {
    local incident=$1 rc=$2 label=$3 phase=$4 truncated=${5:-false}
    if $truncated; then
        printf '%s\ttruncated=true\t%s\t%s\n' "$rc" "$label" "$phase" >>"$incident/manifest.tsv"
    else
        printf '%s\t%s\t%s\n' "$rc" "$label" "$phase" >>"$incident/manifest.tsv"
    fi
}

record_command() {
    local incident=$1 phase=$2 label=$3 limit=$4
    shift 4
    local output="$incident/$phase/${label//[^A-Za-z0-9_.-]/_}.txt" temp rc size truncated=false
    mkdir -p "$incident/$phase"
    temp=$(mktemp "$incident/$phase/.${label//[^A-Za-z0-9_.-]/_}.XXXXXX") || return 1
    # shortcut: RLIMIT_FSIZE is the kernel-enforced 1 MiB ceiling; retain the partial output and rc.
    if (ulimit -f 1024; "$TIMEOUT" --kill-after=2s "$limit" "$@") >"$temp" 2>&1; then
        rc=0
    else
        rc=$?
    fi
    size=$(stat -c %s "$temp")
    if ((size >= MAX_TEXT_BYTES)); then
        truncated=true
    fi
    head -c "$MAX_TEXT_BYTES" "$temp" >"$output"
    rm -f "$temp"
    append_manifest "$incident" "$rc" "$label" "$phase" "$truncated"
    return 0
}

run_snapshot() {
    local incident=$1 phase=$2 entry label limit command
    if ((${#diagnostic_commands[@]})); then
        for entry in "${diagnostic_commands[@]}"; do
            IFS='|' read -r label limit command entry <<<"$entry"
            record_command "$incident" "$phase" "$label" "$limit" "$command" "$entry"
        done
        return
    fi

    record_command "$incident" "$phase" date 5 /usr/bin/date --iso-8601=seconds
    record_command "$incident" "$phase" uname 5 /usr/bin/uname -a
    record_command "$incident" "$phase" uptime 5 /usr/bin/uptime
    record_command "$incident" "$phase" iw-link 5 /usr/bin/iw dev wlan0 link
    record_command "$incident" "$phase" ip-addr 5 /usr/bin/ip addr show
    record_command "$incident" "$phase" ip-rule 5 /usr/bin/ip rule show
    for entry in main 52 ioa 20 230 cn; do
        record_command "$incident" "$phase" "ip-route-$entry" 5 /usr/bin/ip route show table "$entry"
    done
    record_command "$incident" "$phase" iptables-mangle 10 /usr/bin/iptables-save -t mangle
    record_command "$incident" "$phase" iptables-nat 10 /usr/bin/iptables-save -t nat
    record_command "$incident" "$phase" nft-ruleset 10 /usr/bin/nft list ruleset
    record_command "$incident" "$phase" conntrack 10 /usr/bin/conntrack -L -p udp
    record_command "$incident" "$phase" ss-tailscaled 5 /usr/bin/ss -uapn
    record_command "$incident" "$phase" sysctl-src-valid-mark 5 /usr/sbin/sysctl net.ipv4.conf.all.src_valid_mark
    record_command "$incident" "$phase" sysctl-rp-filter 5 /usr/sbin/sysctl -a --pattern 'net.ipv4.conf.*.rp_filter'
    record_command "$incident" "$phase" tailscale-version 10 /usr/bin/tailscale version
    record_command "$incident" "$phase" tailscale-status 10 /usr/bin/tailscale status --json
    record_command "$incident" "$phase" tailscale-prefs 10 /usr/bin/tailscale debug prefs
    record_command "$incident" "$phase" tailscale-netcheck 20 /usr/bin/tailscale netcheck
    record_command "$incident" "$phase" tailscale-metrics 10 /usr/bin/tailscale debug metrics
    record_command "$incident" "$phase" tailscale-derp-map 10 /usr/bin/tailscale debug derp-map
    for entry in tailscaled systemd-networkd network-reconfigure smartdns ngnclient; do
        record_command "$incident" "$phase" "journal-$entry" 15 \
            /usr/bin/journalctl -b -u "$entry" --since=-15min -n 5000 --no-pager
    done
}

wait_service_state() {
    local service=$1 expected=$2 state
    # shortcut: five 200 ms polls bound asynchronous systemd job settlement to about one second.
    for _ in 1 2 3 4 5; do
        state=$("$TIMEOUT" --kill-after=1s 3 "$SYSTEMCTL" is-active "$service" 2>/dev/null || true)
        [ "$state" = "$expected" ] && return 0
        sleep 0.2
    done
    return 1
}

restore_recorder() {
    local incident=$1 service=$2
    "$TIMEOUT" --kill-after=2s 15 "$SYSTEMCTL" start "$service" >/dev/null 2>&1 || true
    if wait_service_state "$service" active; then
        append_manifest "$incident" 0 'recorder start' freeze
        return 0
    fi
    append_manifest "$incident" 1 'recorder start' freeze
    return 1
}

freeze_ring() (
    local incident=$1 service=$2 initial_active=false restored=false result=0 state
    : >>"$incident/manifest.tsv"
    state=$("$TIMEOUT" --kill-after=2s 15 "$SYSTEMCTL" is-active "$service" 2>/dev/null || true)
    if [ "$state" = active ]; then
        initial_active=true
        append_manifest "$incident" 0 'recorder initially active' freeze
    elif [ "$state" = inactive ]; then
        append_manifest "$incident" 0 'recorder initially inactive' freeze
    else
        append_manifest "$incident" 1 'recorder initial state' freeze
        return 1
    fi

    trap 'if $initial_active && ! $restored; then restore_recorder "$incident" "$service" || result=1; fi' EXIT
    if $initial_active; then
        "$TIMEOUT" --kill-after=2s 15 "$SYSTEMCTL" stop "$service" >/dev/null 2>&1 || true
        if wait_service_state "$service" inactive; then
            append_manifest "$incident" 0 'recorder stop' freeze
        else
            append_manifest "$incident" 1 'recorder stop' freeze
            return 1
        fi
    else
        append_manifest "$incident" 0 'recorder stop skipped (initially inactive)' freeze
    fi

    mkdir -p "$incident/ring"
    if [ -d "$RING_DIR" ] && cp -a "$RING_DIR"/. "$incident/ring"/; then
        append_manifest "$incident" 0 'ring copy' freeze
    else
        append_manifest "$incident" 1 'ring copy' freeze
        return 1
    fi

    if $initial_active; then
        if restore_recorder "$incident" "$service"; then
            restored=true
        else
            restored=true
            return 1
        fi
    else
        append_manifest "$incident" 0 'recorder start skipped (initially inactive)' freeze
    fi
    return "$result"
)

start_deep() {
    local incident=$1 duration=$2
    "$TIMEOUT" --signal=INT --kill-after=5s "$duration" "$TCPDUMP" -p -i wlan0 -s 96 -n \
        -C 8 -W 1 -w "$incident/wlan0.pcap" 'udp port 3478 or udp port 41641' \
        >"$incident/wlan0-tcpdump.txt" 2>&1 &
    deep_wlan_pid=$!
    "$TIMEOUT" --signal=INT --kill-after=5s "$duration" "$TCPDUMP" -p -i tailscale0 -s 96 -n \
        -C 8 -W 1 -w "$incident/tailscale0.pcap" 'udp port 3478' \
        >"$incident/tailscale0-tcpdump.txt" 2>&1 &
    deep_tail_pid=$!
}

wait_deep() {
    local incident=$1 wlan_rc tail_rc
    if wait "$deep_wlan_pid"; then wlan_rc=0; else wlan_rc=$?; fi
    if wait "$deep_tail_pid"; then tail_rc=0; else tail_rc=$?; fi
    append_manifest "$incident" "$wlan_rc" 'tcpdump wlan0' capture
    append_manifest "$incident" "$tail_rc" 'tcpdump tailscale0' capture
}

prune_incidents() {
    local base=$1 path i
    local -a paths
    mapfile -t paths < <(find "$base" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' |
        sort -nr | cut -d' ' -f2-)
    if ((${#paths[@]} > 5)); then
        for ((i = 5; i < ${#paths[@]}; i++)); do
            path=${paths[i]}
            [[ $path == "$base"/* ]] && rm -rf -- "$path"
        done
    fi
}

capture_main() (
    local base=$1 service=$2 duration=$3 bugreport=$4 lock=$5
    shift 5
    local timestamp incident note=${*:-} lock_fd
    umask 077
    install -d -m 0700 "$(dirname "$lock")"
    exec {lock_fd}>"$lock"
    if ! flock -n "$lock_fd"; then
        printf 'FAILED: another network debug capture is running\n' >&2
        return 1
    fi

    install -d -m 0700 "$base"
    timestamp=$(date -u +%Y%m%dT%H%M%SZ)
    incident=$(mktemp -d "$base/$timestamp.XXXXXX") || return 1
    chmod 0700 "$incident"
    : >"$incident/manifest.tsv"
    if [ -n "$note" ]; then
        printf '%s' "$note" | sanitize_note >"$incident/note.txt"
    fi

    if ! freeze_ring "$incident" "$service"; then
        find "$incident" -type d -exec chmod 0700 {} +
        find "$incident" -type f -exec chmod 0600 {} +
        prune_incidents "$base"
        printf 'FAILED: recorder freeze/copy/restore failed; evidence retained: %s\n' "$incident" >&2
        return 1
    fi
    start_deep "$incident" "$duration"
    run_snapshot "$incident" before
    wait_deep "$incident"
    run_snapshot "$incident" after
    if $bugreport; then
        record_command "$incident" after tailscale-bugreport 120 /usr/bin/tailscale bugreport --diagnose
    fi
    find "$incident" -type d -exec chmod 0700 {} +
    find "$incident" -type f -exec chmod 0600 {} +
    prune_incidents "$base"
    printf 'Network debug capture complete: %s\n' "$incident"
    printf 'If required after preserving evidence, run tailscale down manually.\n'
)

main() {
    local bugreport=false
    if [ "${EUID:-$(id -u)}" -ne 0 ]; then
        exec sudo -n -- "$0" "$@"
    fi
    if [ "${1-}" = --bugreport ]; then
        bugreport=true
        shift
    elif [ "${1-}" = --help ]; then
        printf 'Usage: %s [--bugreport] [note ...]\n' "$0"
        return
    fi
    capture_main /var/log/network-debug/incidents network-debug-pcap.service 30 "$bugreport" \
        /run/lock/network-debug-capture.lock "$@"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    main "$@"
fi

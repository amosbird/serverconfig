#!/usr/bin/env python3
"""Fast, live Chromium tab and Hister history search for rofi-blocks."""

import html
import http.client
import json
import re
import subprocess
import sys
import threading
import urllib.parse


BROWSER_CDP_PORT = 9222
BLOCKLIST_SCRIPT = "/home/amos/scripts/rofi-browser-blocklist.sh"
HISTER_BIN = "hister"
HISTORY_LIMIT = 50
GOOGLE_SEARCH_URL = "https://www.google.com/search?q="
URL_RE = re.compile(r'^(ftp|http|https)://[^ "]+$')
DOMAIN_RE = re.compile(r"^(?:[a-zA-Z0-9-]+\.)+[a-zA-Z]{2,}(?:/\S*)?$")

entries = []
blocklist = []
tabs = []
state_lock = threading.Lock()
send_lock = threading.Lock()


def load_blocklist():
    try:
        out = subprocess.check_output(
            [BLOCKLIST_SCRIPT], stderr=subprocess.DEVNULL, text=True
        )
        patterns = []
        for line in out.strip().splitlines():
            parts = line.split(" ::: ", 1)
            if len(parts) == 2:
                patterns.append(re.compile(parts[1]))
        return patterns
    except (OSError, subprocess.SubprocessError, re.error):
        return []


def is_blocked(url, patterns):
    return any(pattern.search(url) for pattern in patterns)


def cdp_request(path, conn=None):
    conn = conn or http.client.HTTPConnection(
        "127.0.0.1", BROWSER_CDP_PORT, timeout=1
    )
    try:
        conn.request("GET", path)
        response = conn.getresponse()
        if response.status >= 400:
            return None
        body = response.read()
        if not body:
            return True
        try:
            return json.loads(body)
        except json.JSONDecodeError:
            return body.decode(errors="replace")
    finally:
        conn.close()


def get_chromium_tabs():
    try:
        pages = cdp_request("/json") or []
    except (OSError, json.JSONDecodeError):
        return []

    result = []
    for page in pages:
        if page.get("type") != "page":
            continue
        url = page.get("url", "")
        title = page.get("title", "")
        if url and title and url.startswith(("http://", "https://", "file://")):
            result.append((title, url, page.get("id", "")))
    return result


def build_hister_query(query):
    # Keep only word tokens so user punctuation cannot become FTS query syntax.
    return " ".join(f"{token}*" for token in re.findall(r"\w+", query))


def parse_hister_json(output):
    # shortcut: Hister 2.0 emits a trailing comma when a limited result page is full.
    return json.loads(re.sub(r",\s*]$", "]", output))


def hister_search(query):
    search_query = build_hister_query(query)
    if not search_query:
        return []

    try:
        result = subprocess.run(
            [
                HISTER_BIN,
                "search",
                "-f",
                "json",
                "-F",
                "url,title",
                "-L",
                str(HISTORY_LIMIT),
                search_query,
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=3,
            check=True,
        )
        data = parse_hister_json(result.stdout)
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
        return []

    # Hister 2 returns an array; older builds wrapped it in {"documents": [...]}.
    documents = data if isinstance(data, list) else data.get("documents") or []
    results = []
    seen = set()
    for document in documents:
        url = document.get("url", "")
        title = document.get("title", "") or url
        if url and url not in seen:
            seen.add(url)
            results.append((title, url))
    return results


def match_query(query, title, url):
    text = f"{title} {url}".casefold()
    return all(token.casefold() in text for token in query.split())


def build_tab_entries(query, current_tabs=None):
    current_tabs = tabs if current_tabs is None else current_tabs
    has_query = bool(query.strip())
    result = []
    for title, url, target_id in current_tabs:
        if is_blocked(url, blocklist):
            continue
        if has_query and not match_query(query, title, url):
            continue
        result.append(("tab", title, url, target_id))
    return result


def merge_results(tab_entries, history, patterns=None, open_tabs=None):
    patterns = blocklist if patterns is None else patterns
    open_tabs = tabs if open_tabs is None else open_tabs
    open_by_url = {}
    for title, url, target_id in open_tabs:
        open_by_url.setdefault(url, []).append((title, target_id))
    result = list(tab_entries)
    seen_history = {url for _, _, url, _ in result}
    for title, url in history:
        if url in seen_history or is_blocked(url, patterns):
            continue
        seen_history.add(url)
        matching_tabs = open_by_url.get(url)
        if matching_tabs:
            result.extend(
                ("tab", tab_title, url, target_id)
                for tab_title, target_id in matching_tabs
            )
        else:
            result.append(("hist", title, url, ""))
    return result


def format_lines(entry_list):
    lines = []
    for index, (kind, title, url, _) in enumerate(entry_list):
        short_url = url.split("://", 1)[-1]
        display = f"[{kind}] {html.escape(title)}  <i>{html.escape(short_url)}</i>"
        lines.append({"text": display, "markup": True, "data": str(index)})
    return lines


def send(obj):
    with send_lock:
        sys.stdout.write(json.dumps(obj) + "\n")
        sys.stdout.flush()


def activate_chromium_tab(target_id):
    if not target_id:
        return False
    try:
        return bool(cdp_request(f"/json/activate/{target_id}"))
    except (OSError, json.JSONDecodeError):
        return False


def focus_browser_group():
    send({"command": "focus-browser"})


def launch_url(url):
    subprocess.Popen(
        ["/home/amos/scripts/chromium", url],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def open_url(url):
    focus_browser_group()
    launch_url(url)


def open_or_search(text):
    text = text.strip()
    if not text:
        return
    if URL_RE.match(text):
        url = text
    elif DOMAIN_RE.match(text):
        url = "https://" + text
    else:
        url = GOOGLE_SEARCH_URL + urllib.parse.quote_plus(text)
    open_url(url)


def open_entry(data):
    kind = data.get("kind", "")
    url = data.get("url", "")
    target_id = data.get("target_id", "")
    if not url:
        return
    if kind == "tab" and activate_chromium_tab(target_id):
        focus_browser_group()
    else:
        focus_browser_group()
        launch_url(url)


def delete_entry(data, current_query):
    url = data.get("url", "")
    if not url or data.get("kind") != "hist":
        return
    subprocess.run(
        [HISTER_BIN, "delete", url],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    result = merge_results(build_tab_entries(current_query), hister_search(current_query))
    with state_lock:
        entries[:] = result
    send({"lines": format_lines(result)})


def main():
    global blocklist, tabs
    blocklist = load_blocklist()
    # Tabs cannot change while rofi owns the keyboard, so one CDP fetch per invocation is enough.
    tabs = get_chromium_tabs()
    initial = build_tab_entries("")
    with state_lock:
        entries[:] = initial
    send(
        {
            "input action": "send",
            "prompt": "Web❯",
            "event format": '{"name":"{{name_escaped}}", "value":"{{value_escaped}}", '
            '"data":"{{data_escaped}}"}',
            "lines": format_lines(initial),
        }
    )

    current_query = ""
    debounce_timer = None
    generation = 0

    def search_history(query, search_generation):
        tab_entries = build_tab_entries(query)
        result = merge_results(tab_entries, hister_search(query))
        with state_lock:
            if search_generation != generation:
                return
            entries[:] = result
        send({"lines": format_lines(result)})

    def get_event_entry(raw_data):
        try:
            return entries[int(raw_data)]
        except (ValueError, IndexError):
            return None

    for line in sys.stdin:
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue

        name = event.get("name", "")
        value = event.get("value", "")
        raw_data = event.get("data", "")

        if name == "input change":
            current_query = value
            generation += 1
            if debounce_timer is not None:
                debounce_timer.cancel()
            if value.strip():
                debounce_timer = threading.Timer(0.12, search_history, (value, generation))
                debounce_timer.daemon = True
                debounce_timer.start()
            else:
                tab_entries = build_tab_entries("")
                with state_lock:
                    entries[:] = tab_entries
                send({"lines": format_lines(tab_entries)})

        elif name in ("select entry", "delete entry"):
            with state_lock:
                entry = get_event_entry(raw_data)
            if entry is None:
                continue
            kind, _, url, target_id = entry
            data = {"kind": kind, "url": url, "target_id": target_id}
            if name == "select entry":
                open_entry(data)
                return
            delete_entry(data, current_query)

        elif name == "execute custom input":
            open_or_search(current_query or value)
            return


if __name__ == "__main__":
    main()

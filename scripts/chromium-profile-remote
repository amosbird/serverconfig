#!/usr/bin/env python3

import importlib.machinery
import importlib.util
import os
import pathlib
import socket
import sys

REMOTE = pathlib.Path(__file__).with_name("chromium-remote")
loader = importlib.machinery.SourceFileLoader("chromium_remote", str(REMOTE))
spec = importlib.util.spec_from_loader(loader.name, loader)
module = importlib.util.module_from_spec(spec)
loader.exec_module(module)

profile = pathlib.Path(sys.argv[1])
if sys.argv[2:] == ["--check"]:
    socket_link = profile / "SingletonSocket"
    cookie_link = profile / "SingletonCookie"
    try:
        socket_path = socket_link.resolve(strict=True)
        running = False
        if os.readlink(cookie_link) == os.readlink(socket_path.parent / "SingletonCookie"):
            with socket.socket(socket.AF_UNIX) as client:
                client.settimeout(0.2)
                client.connect(str(socket_path))
            running = True
    except OSError:
        running = False
    raise SystemExit(0 if running else 1)

raise SystemExit(0 if module.forward(profile, sys.argv[2:]) else 1)

#!/usr/bin/env bash
# network-status — read-only view of repository-owned policy and tunnel-owned state.

set -u

rules()  { ip -4 rule show pref "$1" 2>/dev/null; }
routes() { ip -4 route show table "$1" 2>/dev/null | wc -l; }

printf 'interfaces\n'
ip -4 -o addr show scope global 2>/dev/null |
    awk '{printf "  %-12s %s\n", $2, $4}'
printf '  %-12s %s\n' default "$(ip -4 route show table main default 2>/dev/null | head -1)"
printf '  scope link\n'
ip -4 route show table main scope link 2>/dev/null | sed 's/^/    /'

printf '\nlocal direct\n'
local_rules=$(rules 1000)
if [ -n "$local_rules" ]; then
    printf '%s\n' "$local_rules" | sed 's/^/  /'
else
    printf '  pref 1000 missing\n'
fi

printf '\nroutefile direct\n'
printf '  cn routes     %s\n' "$(routes cn)"
printf '  pref 1500     %s\n' "$([ -n "$(rules 1500)" ] && echo present || echo missing)"

printf '\nIOA business\n'
printf '  table ioa     %s\n' \
    "$([ "$(routes ioa)" -gt 0 ] && echo populated || echo empty)"
printf '  tun0          %s\n' \
    "$([ -n "$(ip -4 -o addr show tun0 2>/dev/null)" ] && echo up || echo down)"
printf '  pref 2500\n'
ioa_rules=$(rules 2500)
[ -n "$ioa_rules" ] && printf '%s\n' "$ioa_rules" | sed 's/^/    /' || printf '    missing\n'
printf '  owner 0xa38   %s\n' \
    "$(ip -4 rule show 2>/dev/null | awk '
        /fwmark 0xa38/ {print "pref " $1; found=1}
        END {if (!found) print "missing"}' | tr -d ':')"

printf '\nTailscale\n'
printf '  table 52      %s\n' \
    "$([ "$(routes 52)" -gt 0 ] && echo populated || echo empty)"
printf '  pref 3000     %s\n' "$([ -n "$(rules 3000)" ] && echo present || echo missing)"
if command -v tailscale >/dev/null; then
    if tailscale_json=$(tailscale status --json 2>/dev/null) &&
       [ -n "$tailscale_json" ] &&
       jq -r '
        "  backend       \(.BackendState // "unknown")",
        (if .ExitNodeStatus == null then "  exit node     none"
         else "  exit node     \(.ExitNodeStatus.ID) online=\(.ExitNodeStatus.Online)" end),
        (if (.Health | length) > 0 then "  health        \(.Health | join("; "))" else empty end)
    ' <<<"$tailscale_json" 2>/dev/null
    then
        :
    else
        printf '  tailscaled not responding\n'
    fi
else
    printf '  tailscale not installed\n'
fi

#!/usr/bin/env bash

set -euo pipefail

STORE_ID=jpgfhlaplofoaempbhliigmjbpofeghk
DEV_ID=aocepclkpgckjeikiphffdlileoaceec
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/rofi-chrome
MODE_FILE=$STATE_DIR/mode

mode() {
    if [[ -f $MODE_FILE ]]; then
        read -r selected < "$MODE_FILE"
        [[ $selected == dev || $selected == store ]] && printf '%s\n' "$selected" && return
    fi
    printf 'dev\n'
}

extension_id() {
    if [[ $(mode) == dev ]]; then
        printf '%s\n' "$DEV_ID"
    else
        printf '%s\n' "$STORE_ID"
    fi
}

case ${1:-status} in
    dev|store)
        mkdir -p "$STATE_DIR"
        printf '%s\n' "$1" > "$MODE_FILE"
        printf 'Rofi Chrome mode: %s (%s)\n' "$1" "$(extension_id)"
        printf 'Enable the selected extension and disable the other at chrome://extensions.\n'
        ;;
    status)
        printf '%s\n' "$(mode)"
        ;;
    id)
        extension_id
        ;;
    *)
        printf 'usage: %s {dev|store|status|id}\n' "$0" >&2
        exit 2
        ;;
esac

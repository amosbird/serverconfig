#!/usr/bin/env bash
# network-dhcp-refresh — make the DHCP lease valid for the wireless association actually attached
#
# Runs once per new association. It renews the lease, then confirms the segment really forwards this
# station, and escalates only when it does not: full DHCP first, then a reassociation followed by
# another full DHCP. Each step is confirmed before the next is tried, and every step is logged with
# its elapsed time so an outage can be read straight from the journal.
#
# network-reconfigure.service is ordered after this unit, so a repair is never queued behind a policy
# reconciliation of the same link change. The shared lock below still serialises the two when a
# reconciliation was started by something else.

set -euo pipefail

IFACE=${1:-}
IW=${IW:-/usr/bin/iw}
IP=${IP:-/usr/bin/ip}
ARPING=${ARPING:-/usr/bin/arping}
PROBE=${PROBE:-/home/amos/scripts/network-probe-tcp}
# Fallback witness for a lease that advertises no resolver. It may confirm forwarding, never deny it.
PROBE_TARGET=${PROBE_TARGET:-216.239.32.117}
PROBE_PORT=${PROBE_PORT:-80}
LEASE_DNS_PORT=${LEASE_DNS_PORT:-53}
PROBE_MARK=${PROBE_MARK:-0x80000}
# A lease resolver answers a handshake in well under 100ms on a forwarding segment. A probe that has
# not connected within a second is retried by the next poll rather than waited on.
PROBE_TIMEOUT=${PROBE_TIMEOUT:-1}
POLL_INTERVAL=${POLL_INTERVAL:-0.5}
IWCTL=${IWCTL:-/usr/bin/iwctl}
NETWORKCTL=${NETWORKCTL:-/usr/bin/networkctl}
UPTIME_FILE=${UPTIME_FILE_OVERRIDE:-/proc/uptime}
# Timestamps here come from /proc/uptime, so the state must not outlive the boot.
STATE_DIR=${STATE_DIR_OVERRIDE:-/run/network-dhcp-refresh}
RECONFIGURE_LOCK=${RECONFIGURE_LOCK:-/run/lock/network-reconfigure.lock}
FLOCK=${FLOCK:-/usr/bin/flock}
if [ -z "${NETWORK_DHCP_REFRESH_LOCKED:-}" ]; then
    export NETWORK_DHCP_REFRESH_LOCKED=1
    exec "$FLOCK" -w 60 "$RECONFIGURE_LOCK" "$0" "$@"
fi

if [ -z "$IFACE" ]; then
    IFACE=$("$IP" -4 route show table main default 2>/dev/null |
        awk '$5 ~ /^(wlan|wlp)/ {print $5; exit}')
fi
if [ -z "$IFACE" ]; then
    shopt -s nullglob
    for path in /sys/class/net/wlan* /sys/class/net/wlp*; do
        case $(cat "$path/operstate" 2>/dev/null || true) in
            up | unknown)
                IFACE=${path##*/}
                break
                ;;
        esac
    done
    shopt -u nullglob
fi
[ -n "$IFACE" ] || exit 0

# `connected time` has one-second resolution, so the derived association start jitters by a second.
TOLERANCE=3
# How long each step may take to show forwarding before the next one is tried, in seconds.
RENEW_SETTLE=${RENEW_SETTLE:-3}
RECONFIGURE_SETTLE=${RECONFIGURE_SETTLE:-6}
REASSOCIATE_SETTLE=${REASSOCIATE_SETTLE:-6}
# A forced reassociation is itself a new association, so it needs a floor to avoid a loop.
REASSOCIATE_COOLDOWN=${REASSOCIATE_COOLDOWN:-20}

log() { logger -t network-dhcp-refresh -p "daemon.$1" "$2"; }

now_ms() { printf -v "$1" '%s' "$(( ${EPOCHREALTIME/./} / 1000 ))"; }
now_ms STARTED_MS
# Seconds since this run started, with one decimal, for the step logs.
elapsed() {
    local now
    now_ms now
    printf '+%d.%ds' "$(((now - STARTED_MS) / 1000))" "$((((now - STARTED_MS) % 1000) / 100))"
}

lease_dns_servers() {
    { "$NETWORKCTL" dhcp-lease "$IFACE" 2>/dev/null || true; } |
        awk '
            /domain name server/ { infield = 1; for (i = 5; i <= NF; i++) print $i; next }
            infield && NF == 1 && $1 ~ /^[0-9.]+$/ { print $1; next }
            { infield = 0 }
        '
}

# Witnesses as `origin target port`. A resolver the lease advertises is evidence about this segment;
# the static target is a guess about the outside world and can be blocked on a healthy segment.
forwarding_targets() {
    local resolver
    while read -r resolver; do
        [ -n "$resolver" ] || continue
        printf 'lease %s %s\n' "$resolver" "$LEASE_DNS_PORT"
    done < <(lease_dns_servers)
    printf 'static %s %s\n' "$PROBE_TARGET" "$PROBE_PORT"
}

# Reaching a target on this segment needs no routing decision, so it cannot witness forwarding.
off_link() {
    "$IP" -4 route get "$1" oif "$IFACE" 2>/dev/null | grep -q ' via '
}

ON_LINK_REPORTED=
# One verdict: every witness is probed at once and the first handshake decides. Probe exit codes:
# 0 the path carried it, 1 the path did not, 2 the probe could not be placed and measured nothing.
forwarding_works() {
    local source origin target port pid done rc lease_denied=0 static_denied=0
    local -A origin_of=()
    source=$("$IP" -4 -oneline addr show dev "$IFACE" 2>/dev/null |
        awk '{for (i = 1; i <= NF; i++) if ($i == "inet") {split($(i + 1), a, "/"); print a[1]; exit}}')
    [ -n "$source" ] || return 1
    while read -r origin target port; do
        [ -n "$target" ] || continue
        if ! off_link "$target"; then
            case " $ON_LINK_REPORTED " in
                *" $target "*) ;;
                *)
                    log warning "probe target $target is on this segment; it cannot witness forwarding"
                    ON_LINK_REPORTED+=" $target"
                    ;;
            esac
            continue
        fi
        "$PROBE" --target "$target" --port "$port" --source "$source" \
            --interface "$IFACE" --mark "$PROBE_MARK" --timeout "$PROBE_TIMEOUT" >/dev/null 2>&1 &
        origin_of[$!]=$origin
    done < <(forwarding_targets)
    while [ "${#origin_of[@]}" -gt 0 ]; do
        rc=0
        wait -n -p done "${!origin_of[@]}" || rc=$?
        origin=${origin_of[$done]}
        unset "origin_of[$done]"
        case $rc in
            0)
                for pid in "${!origin_of[@]}"; do kill "$pid" 2>/dev/null || true; done
                wait 2>/dev/null || true
                return 0
                ;;
            1)
                case $origin in
                    lease) lease_denied=1 ;;
                    static) static_denied=1 ;;
                esac
                ;;
        esac
    done
    # Only a witness the network supplied may deny forwarding.
    [ "$lease_denied" -eq 1 ] && return 1
    if [ "$static_denied" -eq 1 ]; then
        log warning "only a static probe target denied forwarding on $IFACE; treating as inconclusive"
    else
        log warning "no probe could witness forwarding on $IFACE; treating as inconclusive"
    fi
    return 0
}

# ARP proves the lease names a gateway on this segment; the probe proves the segment forwards. Both
# must hold. Polled until the deadline so a step is confirmed the moment it takes effect.
segment_usable() {
    local deadline now gateway
    now_ms now
    deadline=$((now + $1 * 1000))
    while :; do
        gateway=$("$IP" -4 route show table main default 2>/dev/null |
            awk -v want="$IFACE" '$5 == want {print $3; exit}')
        if [ -n "$gateway" ] && "$ARPING" -c 1 -w 1 -I "$IFACE" "$gateway" >/dev/null 2>&1 &&
            forwarding_works; then
            return 0
        fi
        now_ms now
        [ "$now" -lt "$deadline" ] || return 1
        sleep "$POLL_INTERVAL"
    done
}

claim_reassociation_slot() {
    local now last=0
    read -r now _ <"$UPTIME_FILE"
    now=${now%.*}
    [ ! -r "$STATE_DIR/reassociated" ] || read -r last <"$STATE_DIR/reassociated" || last=0
    # A stamp ahead of the current uptime is from an earlier boot and is not a cooldown.
    [[ $last =~ ^[0-9]+$ ]] && [ "$last" -le "$now" ] || last=0
    if [ "$((now - last))" -lt "$REASSOCIATE_COOLDOWN" ]; then
        return 1
    fi
    mkdir -p "$STATE_DIR"
    printf '%s\n' "$now" >"$STATE_DIR/reassociated"
}

# Reconnects to the SSID and lets iwd pick the BSS; disconnect clears autoconnect, so the reconnect
# has to be explicit.
reassociate() {
    local ssid
    ssid=$("$IW" dev "$IFACE" link | sed -n 's/^[[:space:]]*SSID:[[:space:]]*//p')
    [ -n "$ssid" ] || return 1
    claim_reassociation_slot || return 1
    "$IWCTL" station "$IFACE" disconnect || return 1
    sleep 1
    "$IWCTL" station "$IFACE" connect "$ssid" || return 1
}

full_dhcp() {
    "$NETWORKCTL" reconfigure "$IFACE" && segment_usable "$RECONFIGURE_SETTLE"
}

# Path triggers that arrive while this runs are merged into this run, so the ladder has to finish
# on its own: nothing re-runs it for the link changes its own steps cause.
reassert_lease() {
    local association=$1
    if ! "$NETWORKCTL" renew "$IFACE"; then
        log err "$association: renew failed; escalating"
    fi
    if segment_usable "$RENEW_SETTLE"; then
        log info "$association: segment forwards this station ($(elapsed))"
        return 0
    fi
    log warning "$association: not forwarding after renew ($(elapsed)); running a full DHCP"
    if full_dhcp; then
        log info "$association: full DHCP restored forwarding ($(elapsed))"
        return 0
    fi
    if reassociate; then
        log warning "$association: still not forwarding after DHCP ($(elapsed)); reassociated"
        if segment_usable "$REASSOCIATE_SETTLE"; then
            log info "$association: reassociating restored forwarding ($(elapsed))"
            return 0
        fi
        if full_dhcp; then
            log info "$association: full DHCP after reassociating restored forwarding ($(elapsed))"
            return 0
        fi
    fi
    log err "$association: still not forwarding after DHCP and reassociating ($(elapsed))"
    return 1
}

state="$STATE_DIR/$IFACE"

station=$("$IW" dev "$IFACE" station dump 2>/dev/null) || station=
bssid=$(awk '$1 == "Station" {print $2; exit}' <<<"$station")
connected=$(awk '$1 == "connected" && $2 == "time:" {print $3; exit}' <<<"$station")
if [ -z "$bssid" ] || [ -z "$connected" ]; then
    rm -f "$state"
    exit 0
fi

# Without an address networkd is already running a full DHCP, and the resulting link change brings
# this hook back once there is something to validate.
if [ -z "$("$IP" -4 -o addr show dev "$IFACE" scope global)" ]; then
    exit 0
fi

read -r uptime _ <"$UPTIME_FILE"
start=$((${uptime%.*} - connected))

if [ -r "$state" ]; then
    previous_bssid= previous_start=
    read -r previous_bssid previous_start <"$state" || true
    if [ "$previous_bssid" = "$bssid" ] && [[ $previous_start =~ ^[0-9]+$ ]] &&
        [ "$((start > previous_start ? start - previous_start : previous_start - start))" \
            -le "$TOLERANCE" ]; then
        exit 0
    fi
fi

# Recorded before acting: every step changes link state, and one attempt per association is what
# keeps a segment that stays broken from becoming a repair loop.
mkdir -p "$STATE_DIR"
printf '%s %s\n' "$bssid" "$start" >"$state"
reassert_lease "association $bssid on $IFACE (${connected}s old)"

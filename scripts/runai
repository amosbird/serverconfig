#!/usr/bin/env bash

extension=/home/amos/git/serverconfig/chromium/external-links/extension
profile=/home/amos/.config/chrome-chatgpt
remote=/home/amos/scripts/chromium-profile-remote
host="$profile/NativeMessagingHosts/io.github.amosbird.browser_router.json"
mkdir -p "$(dirname "$host")"
ln -sf /home/amos/git/serverconfig/chromium/external-links/native-host.json "$host"

if ! "$remote" "$profile" --check; then
    rm -rf "$profile/Default/Sessions"
    python3 - "$profile/Default/Preferences" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
if path.exists():
    preferences = json.loads(path.read_text())
    preferences.setdefault("profile", {})["exit_type"] = "Normal"
    path.write_text(json.dumps(preferences, separators=(",", ":")))
PY
else
    if [[ $# -gt 0 ]]; then
        "$remote" "$profile" "$@"
        qtile cmd-obj -o root -f eval -a 'self.show_scratchpad("chatgpt")' >/dev/null 2>&1 || true
    fi
    exit
fi

urls=(https://chatgpt.com/ https://claude.ai/ https://gemini.google.com/)
if [[ $# -gt 0 ]]; then
    urls=("$@")
    qtile cmd-obj -o root -f eval -a 'self.show_scratchpad("chatgpt")' >/dev/null 2>&1 || true
fi

exec /usr/bin/google-chrome-stable \
    --user-data-dir="$profile" \
    --no-default-browser-check \
    --disable-smooth-scrolling \
    --disable-extensions-except="$extension" \
    --load-extension="$extension" \
    --remote-debugging-port=9223 \
    --class=chatgpt \
    --kiosk \
    "${urls[@]}"

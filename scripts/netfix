#!/usr/bin/env bash
# netfix — reconcile repository-owned policy, then verify it without changing either tunnel.

set -uo pipefail # deliberately not -e: report every failed invariant

LOG=/var/log/netfix.log
REPO=/home/amos/git/serverconfig
RECONFIGURE="$REPO/scripts/network-reconfigure"
IFACE_DEFAULT=wlan0
PROBE_HOST=connectivitycheck.gstatic.com
PROBE_IP=216.239.32.117
IOA_PROBE=http://ioa.tencent.com
# The reachability witness has to survive the exit node being switched off, because that is exactly
# when an operator runs this. gstatic is Google, this country blocks it, and it was the only probe:
# with no exit node selected the check reported `internet: HTTP 000` for a network that was
# forwarding perfectly well, and only a request routed through a tunnel ever answered 204.
#
# These two are native captive-portal endpoints that answer on **either** path, measured 5/5 through
# the exit node and 5/5 with it off. Both are single stable addresses rather than a rotating CDN
# pool, which is what lets --resolve keep this check independent of the resolver it is testing.
# gstatic stays last: it is still the right target while a tunnel is up, and ordering it there means
# a link that can reach either of the others never depends on it.
PROBE_FALLBACKS=(
    '117.27.249.81:connectivitycheck.platform.hicloud.com'
    '124.225.84.98:www.qualcomm.cn'
    "$PROBE_IP:$PROBE_HOST"
)


say()  { printf '\n\033[1m=== %s\033[0m\n' "$*"; }
ok()   { printf '  \033[32mOK\033[0m   %s\n' "$*"; }
bad()  { printf '  \033[31mFAIL\033[0m %s\n' "$*"; }
info() { printf '       %s\n' "$*"; }


online() {
    local entry ip host
    for entry in "${PROBE_FALLBACKS[@]}"; do
        ip=${entry%%:*}
        host=${entry#*:}
        if curl -s -o /dev/null -m 8 -w '%{http_code}' \
            --resolve "$host:80:$ip" "http://$host/generate_204" 2>/dev/null |
            grep -Fxq 204; then
            printf '204 (%s)' "$host"
            return 0
        fi
    done
    printf '000 (none of %s)' "${#PROBE_FALLBACKS[@]}"
}

main() {
    local reconfigure="$1" iface fail n spec pref text code tailscale_json
    printf '\n========================================================\n'
    printf 'netfix %s  (log: %s)\n' "$(date -Is)" "$LOG"
    printf '========================================================\n'

    iface=$(ip -4 route show table main default 2>/dev/null |
        awk '$5 ~ /^(wlan|wlp|enp|eth|eno|ens)/ {print $5; exit}')
    iface=${iface:-$IFACE_DEFAULT}
    fail=0

    say "RECONFIGURE"
    # FORCE is intentional: an operator repair must not be skipped by the reconciler cache.
    if timeout 120 env FORCE=1 "$reconfigure" "$iface"; then
        ok "network policy reconciled"
    else
        bad "network policy reconcile failed"
        fail=1
    fi

    say "OWNED POLICY"
    n=$(ipset save cn_direct 2>/dev/null | awk '$1 == "add" && $NF != "nomatch" {count++}
        END {print count + 0}')
    info "optional CN acceleration: $n prefixes"

    # The literal 10/8 fallback carries a full-width mark-zero match, added by 2cf9753. This expected
    # substring was not updated with it, so the check reported a phantom failure from 2026-09-20
    # onward: the rule was present all along, and `to 10.0.0.0/8 lookup ioa` is simply not how it
    # renders. Keep each substring in step with the rule it names.
    for spec in \
        '400:fwmark 0x1000000 lookup main' \
        '401:fwmark 0x1000000 prohibit' \
        '500:fwmark 0x80000/0xff0000 lookup main' \
        '1000:lookup main suppress_prefixlength 0' \
        '1150:fwmark 0x1 lookup ioa' \
        '1150:to 10.0.0.0/8 fwmark 0 lookup ioa' \
        '3000:to 100.64.0.0/10 lookup 52'
    do
        pref=${spec%%:*}
        text=${spec#*:}
        if ip -4 rule show pref "$pref" 2>/dev/null | grep -Fq "$text"; then
            ok "$text"
        else
            bad "missing: $text"
            fail=1
        fi
    done
    if [ "$n" -gt 0 ]; then
        if ip -4 rule show pref 1500 2>/dev/null | grep -Fq 'fwmark 0x2 lookup main' &&
           ip -4 rule show pref 1501 2>/dev/null | grep -Fq 'fwmark 0x2 prohibit'; then
            ok "fwmark 0x2 lookup main, then prohibit"
        else
            bad "CN direct lookup can fall through to Tailscale"
            fail=1
        fi
    elif [ -n "$(ip -4 rule show pref 1500 2>/dev/null)" ] ||
         [ -n "$(ip -4 rule show pref 1501 2>/dev/null)" ]; then
        bad "CN acceleration rule remains with an empty classifier"
        fail=1
    else
        ok "CN acceleration disabled"
    fi

    say "CONNECTIVITY (READ-ONLY)"
    code=$(online)
    case $code in
        204*) ok "internet: HTTP $code" ;;
        *)    bad "internet: HTTP $code (fail-closed; route selection unchanged)" ;;
    esac
    code=$(curl -s -o /dev/null -m 10 -w '%{http_code}' "$IOA_PROBE" 2>/dev/null)
    [ -n "$code" ] && [ "$code" != 000 ] && ok "IOA intranet: HTTP $code" || \
        bad "IOA intranet: HTTP ${code:-000}"
    info "DNS: $(dig +short +timeout=2 +tries=1 google.com @127.0.0.1 2>/dev/null |
        head -1 || echo FAILED)"

    if tailscale_json=$(tailscale status --json 2>/dev/null) &&
       [ -n "$tailscale_json" ] &&
       jq -r '
        "       exit node: " +
        (if .ExitNodeStatus == null then "none"
         else "\(.ExitNodeStatus.ID) online=\(.ExitNodeStatus.Online)" end),
        (if (.Health | length) > 0 then "       health: \(.Health | join("; "))" else empty end)
    ' <<<"$tailscale_json" 2>/dev/null
    then
        :
    else
        bad "tailscaled not responding"
        fail=1
    fi

    say "RESULT"
    if [ "$fail" -eq 0 ]; then
        ok "owned policy checks passed"
    else
        bad "$fail owned-policy check(s) failed"
    fi
    printf '\nlog: %s\n' "$LOG"
    return "$fail"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    [ "$(id -u)" -eq 0 ] || { echo "netfix: must run as root (use sudo)"; exit 1; }
    mkdir -p "$(dirname "$LOG")"
    exec > >(tee -a "$LOG") 2>&1
    main "$RECONFIGURE"
fi

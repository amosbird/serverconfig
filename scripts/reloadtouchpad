#!/usr/bin/env bash

set -euo pipefail

notification_tag=reloadtouchpad

notify() {
    command -v dunstify >/dev/null 2>&1 || return
    dunstify --app-name Touchpad --stack-tag "$notification_tag" "$@" >/dev/null 2>&1 || true
}

if (( EUID != 0 )); then
    exec 9>"${XDG_RUNTIME_DIR:-/tmp}/reloadtouchpad.lock"
    if ! flock -n 9; then
        notify --timeout 2500 "Touchpad reset" "Reset is already running"
        exit 0
    fi

    notify --timeout 0 "Touchpad reset" "Resetting touchpad…"
    if sudo -n "$0" --root; then
        notify --timeout 3500 "Touchpad reset complete" \
            "Try the touchpad; press Ctrl+F12 again if it is still insensitive"
        exit 0
    fi

    status=$?
    notify --urgency critical --timeout 7000 "Touchpad reset failed" \
        "psmouse could not be rebound"
    exit "$status"
fi

if [[ ${1:-} != --root ]]; then
    printf 'Refusing to run root worker directly without --root\n' >&2
    exit 2
fi

if ! grep -qw LEN040f /sys/bus/serio/devices/serio1/firmware_id; then
    printf 'refusing to reset unexpected serio1 device\n' >&2
    exit 1
fi

ensure_psmouse_bound() {
    if [[ ! -L /sys/bus/serio/devices/serio1/driver ]]; then
        printf 'psmouse' > /sys/bus/serio/devices/serio1/drvctl 2>/dev/null || true
    fi
}
trap ensure_psmouse_bound EXIT

printf 'none' > /sys/bus/serio/devices/serio1/drvctl
sleep 0.2
if ! printf 'psmouse' > /sys/bus/serio/devices/serio1/drvctl; then
    sleep 1
    printf 'psmouse' > /sys/bus/serio/devices/serio1/drvctl
fi

for _ in {1..30}; do
    if [[ -L /sys/bus/serio/devices/serio1/driver ]] &&
        grep -q 'Synaptics TM3625-010' /proc/bus/input/devices; then
        exit 0
    fi
    sleep 0.1
done

printf 'touchpad input device did not reappear\n' >&2
exit 1

#!/usr/bin/env python3

import faulthandler
import json
import os
import subprocess

faulthandler.enable()

import cairo
import gi

gi.require_version("Gdk", "3.0")
gi.require_version("Gtk", "3.0")
from gi.repository import Gdk, Gio, GLib, Gtk

ICON_SIZE = 96
DESIGN_SIZE = 96
FREECLIP_ADDRESS = "C0:DA:5E:EC:FB:7F"

# Sibling script, resolved so the indicator does not depend on PATH (the
# systemd user manager environment has no ~/scripts).
HERE = os.path.dirname(os.path.realpath(__file__))
BLUETOOTH_PROFILE = os.path.join(HERE, "bluetooth-profile")

PROFILE_STYLES = {
    "a2dp": {
        "title": "A2DP",
        "purpose": "High quality playback",
        "color": (0.10, 0.47, 0.95),
    },
    "local": {
        "title": "LOCAL",
        "purpose": "Bluetooth unavailable · using built-in audio",
        "color": (0.90, 0.45, 0.10),
    },
    "switching": {
        "title": "···",
        "purpose": "Switching audio profile",
        "color": (0.18, 0.56, 0.78),
    },
    "hfp": {
        "title": "HFP",
        "purpose": "Calls + microphone",
        "color": (0.48, 0.30, 0.90),
    },
}


def profile_details(name, description):
    if name.startswith("a2dp-sink"):
        style = PROFILE_STYLES["a2dp"]
    elif name.startswith("headset-head-unit"):
        style = PROFILE_STYLES["hfp"]
    else:
        return name, "", ""
    codec = description.rsplit("codec ", 1)[-1].rstrip(")") if "codec " in description else ""
    label = f"{style['title']} · {codec}" if codec else style["title"]
    return label, style["title"], style["purpose"]


class BluetoothIndicator:
    def __init__(self):
        self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        self.devices = {}
        self.cards = {}
        self.session = {}
        self.session_retry_pending = False
        self.event_sources = {}
        self.metadata_kick_pending = False
        self.adapter_powered = False
        self.output_muted = False
        self.icon = Gtk.StatusIcon.new_from_pixbuf(self.status_icon("OFF", ICON_SIZE))
        self.icon_state = "OFF"
        self.icon.set_title("Bluetooth")
        self.icon.connect("size-changed", self.on_icon_size_changed)
        self.icon.connect("popup-menu", self.show_menu)
        self.icon.connect("activate", self.activate)
        self.icon.set_visible(True)
        self.bus.signal_subscribe(
            "org.bluez",
            None,
            None,
            None,
            None,
            Gio.DBusSignalFlags.NONE,
            self.on_bluez_changed,
        )
        self.spawn_event_source(
            ["pactl", "subscribe"],
            self.on_pulse_event,
        )
        self.spawn_event_source(
            ["pw-metadata", "-n", "default", "-m"],
            self.on_metadata_event,
        )
        self.refresh()

    def spawn_event_source(self, command, callback):
        process = subprocess.Popen(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
        self.event_sources[process] = (command, callback)
        os.set_blocking(process.stdout.fileno(), False)
        GLib.io_add_watch(
            process.stdout,
            GLib.IO_IN | GLib.IO_HUP,
            self.on_event_source,
            process,
        )

    def on_event_source(self, stream, condition, process):
        command, callback = self.event_sources.get(process, (None, None))
        if condition & GLib.IO_HUP:
            # The event pipe died (e.g. PipeWire restarted). Respawn it
            # instead of going permanently deaf.
            self.event_sources.pop(process, None)
            try:
                process.wait(timeout=1)
            except subprocess.TimeoutExpired:
                process.kill()
            if command:
                print(f"event source exited, respawning: {' '.join(command)}", flush=True)
                GLib.timeout_add_seconds(2, self.respawn_event_source, command, callback)
            return False
        callback(stream)
        return True

    def respawn_event_source(self, command, callback):
        self.spawn_event_source(command, callback)
        return False

    def kick_metadata_watcher(self):
        # pw-metadata silently goes deaf when the "default" metadata object
        # it bound to is recreated (every WirePlumber restart) or did not
        # exist when it started. Any pulse/BlueZ event means graph churn of
        # exactly that kind may have happened, so recycle the watcher,
        # debounced; the fresh child replays all keys, which also refreshes.
        if self.metadata_kick_pending:
            return
        self.metadata_kick_pending = True
        GLib.timeout_add_seconds(10, self.respawn_metadata_watcher)

    def respawn_metadata_watcher(self):
        self.metadata_kick_pending = False
        for process, (command, _callback) in list(self.event_sources.items()):
            if command[0] == "pw-metadata" and process.poll() is None:
                try:
                    process.terminate()  # the HUP handler respawns it fresh
                except OSError:
                    pass
        return False

    def bluez_objects(self):
        try:
            result = self.bus.call_sync(
                "org.bluez",
                "/",
                "org.freedesktop.DBus.ObjectManager",
                "GetManagedObjects",
                None,
                None,
                Gio.DBusCallFlags.NONE,
                2000,
                None,
            )
            return result.unpack()[0]
        except GLib.Error:
            return {}

    def load_devices(self):
        self.devices = {}
        self.adapter_powered = False
        for path, interfaces in self.bluez_objects().items():
            adapter = interfaces.get("org.bluez.Adapter1")
            if adapter:
                self.adapter_powered = self.adapter_powered or adapter.get("Powered", False)
            device = interfaces.get("org.bluez.Device1")
            if not device:
                continue
            self.devices[device.get("Address", "")] = {
                "name": device.get("Alias") or device.get("Name") or "Bluetooth device",
                "connected": device.get("Connected", False),
                "battery": interfaces.get("org.bluez.Battery1", {}).get("Percentage"),
            }

    def load_cards(self):
        try:
            result = subprocess.run(
                ["pactl", "--format=json", "list", "cards"],
                check=True,
                capture_output=True,
                text=True,
                timeout=5,
            )
            cards = json.loads(result.stdout)
        except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
            return  # keep the last known cards
        self.cards = {}
        for card in cards:
            properties = card.get("properties", {})
            if properties.get("device.bus") == "bluetooth":
                self.cards[properties.get("device.string", "").upper()] = card

    def load_session(self):
        try:
            result = subprocess.run(
                [BLUETOOTH_PROFILE, "status", "--json"],
                check=True,
                capture_output=True,
                text=True,
                timeout=5,
            )
            session = json.loads(result.stdout)
        except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
            session = None
        if session and session.get("state"):
            self.session = session
            self.session_retry_pending = False
        elif not self.session_retry_pending:
            # A failed read during a profile transition must not drop the
            # icon back to LINK: keep the last known state and retry once.
            self.session_retry_pending = True
            GLib.timeout_add_seconds(3, self.retry_refresh)

    def load_output_mute(self):
        # The stable output is the system default sink; its mute state is
        # invisible otherwise and silences every app while the icon claims
        # HFP. Failures keep the last known value (fail-open: no fake MUTE).
        try:
            result = subprocess.run(
                ["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"],
                check=True,
                capture_output=True,
                text=True,
                timeout=3,
            )
            self.output_muted = "[MUTED]" in result.stdout
        except (OSError, subprocess.SubprocessError):
            pass

    def retry_refresh(self):
        self.session_retry_pending = False
        self.refresh()
        return False

    def managed_profile(self):
        state = self.session.get("state", "")
        if state == "A2DP_READY":
            style = PROFILE_STYLES["a2dp"]
        elif state == "HFP_READY":
            style = PROFILE_STYLES["hfp"]
        elif state.endswith("_STARTING") or state == "HFP_RECOVERING":
            style = PROFILE_STYLES["switching"]
        elif state in ("LOCAL_FALLBACK", "DISCONNECTED"):
            style = PROFILE_STYLES["local"]
        else:
            return "", "", ""
        return style["title"], style["title"], style["purpose"]

    def profile(self, address):
        if address == FREECLIP_ADDRESS:
            managed = self.managed_profile()
            if managed[0]:
                return managed
            # Session state unreadable: fall back to the physical profile.
        card = self.cards.get(address)
        if not card:
            return "", "", ""
        active = card.get("active_profile", "off")
        description = card.get("profiles", {}).get(active, {}).get("description", "")
        return profile_details(active, description)

    @staticmethod
    def rounded_rectangle(context, x, y, width, height, radius):
        context.new_sub_path()
        context.arc(x + width - radius, y + radius, radius, -1.5708, 0)
        context.arc(x + width - radius, y + height - radius, radius, 0, 1.5708)
        context.arc(x + radius, y + height - radius, radius, 1.5708, 3.1416)
        context.arc(x + radius, y + radius, radius, 3.1416, 4.7124)
        context.close_path()

    @staticmethod
    def draw_bluetooth(context, center_x, center_y, size):
        top = center_y - size / 2
        bottom = center_y + size / 2
        right = center_x + size * 0.32
        context.move_to(center_x, top)
        context.line_to(right, center_y - size * 0.18)
        context.line_to(center_x - size * 0.28, center_y + size * 0.12)
        context.move_to(center_x, bottom)
        context.line_to(right, center_y + size * 0.18)
        context.line_to(center_x - size * 0.28, center_y - size * 0.12)
        context.move_to(center_x, top)
        context.line_to(center_x, bottom)
        context.set_line_width(size * 0.10)
        context.set_line_cap(cairo.LINE_CAP_ROUND)
        context.set_line_join(cairo.LINE_JOIN_ROUND)
        context.stroke()

    def status_icon(self, state, size):
        if state in PROFILE_STYLES:
            color = PROFILE_STYLES[state]["color"]
            label = PROFILE_STYLES[state]["title"]
        elif state == "MUTED":
            color = (0.78, 0.22, 0.22)
            label = "MUTE"
        elif state == "OFF":
            color = (0.30, 0.32, 0.36)
            label = "OFF"
        elif state == "IDLE":
            color = (0.18, 0.56, 0.78)
            label = "ON"
        else:
            color = (0.12, 0.62, 0.48)
            label = "LINK"

        surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, size, size)
        context = cairo.Context(surface)
        context.scale(size / DESIGN_SIZE, size / DESIGN_SIZE)
        self.rounded_rectangle(context, 0, 0, DESIGN_SIZE, DESIGN_SIZE, 18)
        context.set_source_rgb(*color)
        context.fill()

        context.set_source_rgba(1, 1, 1, 0.92)
        self.draw_bluetooth(context, 48, 27, 34)

        context.set_source_rgb(1, 1, 1)
        context.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        context.set_font_size(27 if len(label) > 3 else 31)
        extents = context.text_extents(label)
        context.move_to(48 - extents.width / 2, 78)
        context.show_text(label)
        return Gdk.pixbuf_get_from_surface(surface, 0, 0, size, size)

    def set_icon_state(self, state):
        self.icon_state = state
        size = self.icon.get_size() or ICON_SIZE
        self.icon.set_from_pixbuf(self.status_icon(state, size))

    def on_icon_size_changed(self, _icon, size):
        # GtkStatusIcon otherwise keeps its 48 px natural allocation centered
        # when stalonetray expands the XEmbed socket to 96 px on HiDPI.
        self.icon.set_from_pixbuf(self.status_icon(self.icon_state, size))
        return True

    def refresh(self):
        self.load_devices()
        self.load_cards()
        self.load_session()
        self.load_output_mute()
        connected = [
            (address, device)
            for address, device in self.devices.items()
            if device["connected"]
        ]
        if not self.adapter_powered:
            self.set_icon_state("OFF")
            tooltip = "Bluetooth is off"
        elif connected:
            lines = ["Bluetooth audio"]
            icon_state = "LINK"
            for address, device in connected:
                profile, mode, purpose = self.profile(address)
                lines.append(f"\n{device['name']}")
                if profile:
                    lines.append(f"Profile  {profile}")
                    lines.append(purpose)
                    icon_state = mode.lower()
                else:
                    lines.append("Connected")
                if device["battery"] is not None:
                    lines.append(f"Battery  {device['battery']}%")
            self.set_icon_state(icon_state)
            tooltip = "\n".join(lines)
        else:
            self.set_icon_state("IDLE")
            tooltip = "Bluetooth is on\nNo devices connected"
        # A muted default sink overrides the profile display: the icon must
        # never claim a healthy HFP route while all audio is silenced.
        if self.adapter_powered and self.output_muted:
            self.set_icon_state("MUTED")
            tooltip += "\nOutput muted — Ctrl-F1 / volume mute to unmute"
        self.icon.set_tooltip_text(tooltip)
        return False

    def on_bluez_changed(self, *_args):
        self.kick_metadata_watcher()
        GLib.idle_add(self.refresh)

    @staticmethod
    def drain_events(stream):
        try:
            return os.read(stream.fileno(), 65536).decode(errors="replace")
        except BlockingIOError:
            return ""

    def on_pulse_event(self, stream):
        events = self.drain_events(stream)
        if "card" in events or "server" in events:
            self.kick_metadata_watcher()
            GLib.idle_add(self.refresh)
        elif "sink" in events or "source" in events:
            # Volume/mute changes: refresh only, no metadata churn.
            GLib.idle_add(self.refresh)

    def on_metadata_event(self, stream):
        if "freeclip.session." in self.drain_events(stream):
            GLib.idle_add(self.refresh)

    def set_profile(self, item, address, card_name, profile):
        if not item.get_active():
            return
        if address == FREECLIP_ADDRESS:
            if profile.startswith("a2dp-sink"):
                command = [BLUETOOTH_PROFILE, "a2dp"]
            elif profile.startswith("headset-head-unit"):
                command = [BLUETOOTH_PROFILE, "hfp"]
            else:
                return
        else:
            command = ["pactl", "set-card-profile", card_name, profile]
        subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def effective_profile_name(self, address, physical):
        if address != FREECLIP_ADDRESS:
            return physical
        state = self.session.get("state", "")
        if state == "A2DP_READY":
            return "a2dp-sink"
        if state == "HFP_READY":
            return "headset-head-unit"
        return ""

    def device_menu(self, address):
        submenu = Gtk.Menu()
        card = self.cards.get(address)
        if card:
            active = self.effective_profile_name(address, card.get("active_profile", "off"))
            for name, profile in card.get("profiles", {}).items():
                if name == "off" or not profile.get("available", False):
                    continue
                label, _mode, purpose = profile_details(name, profile.get("description", ""))
                item = Gtk.CheckMenuItem(label=f"{label}    {purpose}")
                item.set_draw_as_radio(True)
                item.set_active(name == active)
                item.connect("activate", self.set_profile, address, card["name"], name)
                submenu.append(item)
        if not submenu.get_children():
            item = Gtk.MenuItem(label="No audio profiles")
            item.set_sensitive(False)
            submenu.append(item)
        return submenu

    def activate(self, icon):
        self.show_menu(icon, 1, Gtk.get_current_event_time())

    def show_menu(self, icon, button=0, activate_time=0):
        menu = Gtk.Menu()
        connected = [
            (address, device)
            for address, device in self.devices.items()
            if device["connected"]
        ]
        if connected:
            for address, device in connected:
                label = device["name"]
                profile, _mode, _purpose = self.profile(address)
                if profile:
                    label += f"    ·    {profile}"
                if device["battery"] is not None:
                    label += f"    {device['battery']}%"
                item = Gtk.MenuItem(label=label)
                item.set_submenu(self.device_menu(address))
                menu.append(item)
        else:
            item = Gtk.MenuItem(label="No connected devices")
            item.set_sensitive(False)
            menu.append(item)
        menu.append(Gtk.SeparatorMenuItem())
        settings = Gtk.MenuItem(label="Bluetooth settings…")
        settings.connect(
            "activate",
            lambda *_: subprocess.Popen(["bzmenu", "--launcher", "rofi", "--interactive"]),
        )
        menu.append(settings)
        menu.show_all()
        menu.popup(None, None, Gtk.StatusIcon.position_menu, icon, button, activate_time)


def main():
    print(f"bluetooth-indicator started (pid {os.getpid()})", flush=True)
    BluetoothIndicator()
    Gtk.main()


if __name__ == "__main__":
    main()

#!/usr/bin/env bash

# The system tray, as a 96 px row of icons for this HiDPI screen. Shown and
# hidden as the qtile "stalonetray" scratchpad (Ctrl-Alt-4).
#
# fcitx5 is kept out of the row (`ignore_classes fcitx` in .stalonetrayrc)
# because its XEmbed icon paints only while it is connecting to a tray, so a
# tray that shows up afterwards leaves the slot blank; fcitx5-indicator draws
# that icon from D-Bus state instead.

exec stalonetray --icon-size=96 --kludges=force_icons_size

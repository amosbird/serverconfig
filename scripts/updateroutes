#!/usr/bin/env python3
"""Atomically refresh the optional CN direct-routing prefix list."""

import argparse
import ipaddress
import os
import pathlib
import subprocess
import tempfile
import urllib.request

DEFAULT_SOURCE = "https://ftp.apnic.net/apnic/stats/apnic/delegated-apnic-latest"
DEFAULT_MINIMUM_PREFIXES = 1000


def parse_apnic(data: str, minimum_prefixes: int = DEFAULT_MINIMUM_PREFIXES) -> list[str]:
    networks = []
    for number, raw_line in enumerate(data.splitlines(), 1):
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        fields = line.split("|")
        if len(fields) < 7:
            continue
        registry, country, kind, start, value, _date, status = fields[:7]
        if (
            registry.lower() != "apnic"
            or country.upper() != "CN"
            or kind.lower() != "ipv4"
            or status.lower() not in {"allocated", "assigned"}
        ):
            continue
        try:
            addresses = int(value)
            if addresses <= 0 or addresses & (addresses - 1):
                raise ValueError("address count is not a power of two")
            prefix_length = 32 - (addresses.bit_length() - 1)
            network = ipaddress.IPv4Network(f"{start}/{prefix_length}", strict=True)
        except ValueError as error:
            raise ValueError(f"invalid APNIC IPv4 record at line {number}: {error}") from error
        networks.append(network)

    collapsed = list(ipaddress.collapse_addresses(networks))
    if len(collapsed) < minimum_prefixes:
        raise ValueError(
            f"refusing implausible APNIC result: {len(collapsed)} CN prefixes "
            f"(minimum {minimum_prefixes})"
        )
    return [network.with_prefixlen for network in collapsed]


def fetch(source: str, timeout: float) -> str:
    with urllib.request.urlopen(source, timeout=timeout) as response:
        return response.read().decode("utf-8")


def replace_if_changed(path: pathlib.Path, content: bytes) -> bool:
    try:
        if path.read_bytes() == content:
            return False
    except FileNotFoundError:
        pass

    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "wb") as output:
            output.write(content)
            output.flush()
            os.fsync(output.fileno())
        os.chmod(temporary, 0o644)
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    except BaseException:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise
    return True


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source", default=DEFAULT_SOURCE)
    parser.add_argument("--output", type=pathlib.Path, default=pathlib.Path.home() / ".routefile")
    parser.add_argument("--timeout", type=float, default=30)
    parser.add_argument("--minimum-prefixes", type=int, default=DEFAULT_MINIMUM_PREFIXES)
    args = parser.parse_args()

    prefixes = parse_apnic(fetch(args.source, args.timeout), args.minimum_prefixes)
    content = "".join(f"{prefix}\n" for prefix in prefixes).encode()
    if replace_if_changed(args.output, content):
        subprocess.run(
            ["notify-send", "route", f"CN acceleration updated ({len(prefixes)} prefixes)"],
            check=False,
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

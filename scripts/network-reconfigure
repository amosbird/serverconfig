#!/usr/bin/env bash
# network-reconfigure — reconcile repository-owned network policy after link changes

set -Eeuo pipefail

abort() {
    local rc=$1 line=$2
    logger -t network-reconfigure -p daemon.err \
        "aborted at line $line (exit $rc); active IOA marking left in place"
}
trap 'abort $? $LINENO' ERR

IFACE="${1:-wlan0}"

if [ -z "${NETWORK_RECONFIGURE_LOCKED:-}" ]; then
    export NETWORK_RECONFIGURE_LOCKED=1
    exec flock -w 60 /run/lock/network-reconfigure.lock "$0" "$@"
fi

IOA_MARK="0x1/0xffffffff"
CN_MARK="0x2/0xffffffff"
IOA_OWNER_MARK="0x1000000/0xffffffff"
# Both iOA processes create their own transport: the ngnclient daemon runs SmartGateAgent, and the
# GUI (ioagui.service, a user unit) opens its own control connections to the iOA cloud. The GUI's
# endpoints are deliberately excluded from ipset ioa, so without an owner mark they match no policy
# rule and follow the Tailscale exit node — nesting iOA control traffic inside the tailnet.
IOA_CGROUP_PATHS_VALUE=${IOA_CGROUP_PATHS_OVERRIDE-"system.slice/ngnclient.service"}
read -r -a IOA_CGROUP_PATHS <<<"$IOA_CGROUP_PATHS_VALUE"
CGROUP_ROOT=${CGROUP_ROOT_OVERRIDE:-/sys/fs/cgroup}
TS_MARK="0x80000/0xff0000"
CHAIN="NETMODE_IOA"
NEXT_CHAIN="NETMODE_IOA_NEXT"
IOA_STATIC_CIDRS=("10.0.0.0/8")
TAILNET_NETS=("100.64.0.0/10")
CN_SET="cn_direct"
CN_NEXT_SET="cn_direct_next"
WIRED_UNDERLAY_TABLE="wired_underlay"
WPA_CLI="${WPA_CLI_OVERRIDE:-/usr/bin/wpa_cli}"
# Same anchor, port and probe mark the debug captures and network-dhcp-refresh use for underlay
# liveness: connectivitycheck.gstatic.com on the mark reserved for probes that must stay physical.
PROBE="${PROBE_OVERRIDE:-/home/amos/scripts/network-probe-tcp}"
PROBE_TARGET="${PROBE_TARGET_OVERRIDE:-216.239.32.117}"
PROBE_PORT=80
PROBE_MARK="0x80000"
PROBE_TIMEOUT=3
RT_TABLES="${RT_TABLES_OVERRIDE:-/etc/iproute2/rt_tables}"
TMPDIR="${TMPDIR_OVERRIDE:-/tmp}"
IOA_TABLE="ioa"
ROUTEFILE="/home/amos/.routefile"
CN_EXCLUDE_FILE="/home/amos/git/serverconfig/network/cn-exclude.conf"
OFFICE_SRC="/home/amos/git/serverconfig/network/smartdns/office.conf"
OFFICE_DST="/etc/smartdns/office.conf"
SMARTDNS_BASE="/etc/smartdns/smartdns.conf"
IOA_RESOLVERS_DST="/etc/smartdns/ioa-resolvers.conf"
INTRANET_RESOLVER_CACHE="/var/lib/network-reconfigure/intranet-resolvers"
IOA_ENV_STATE="${IOA_ENV_STATE_OVERRIDE:-/run/network-reconfigure/ioa-environment}"
P_IOA_OWNER=400
P_IOA_OWNER_STOP=401
P_TS=500
P_LOCAL=1000
P_RETIRED_IOA_MARK=1400
P_CN=1500
P_CN_STOP=1501
# Above P_IOA_SMART_SRC, and that placement is the whole point. Rule 1200 matches on the underlay
# source address, which every unbound socket picks during the routing decision that happens before
# OUTPUT mangle sets a mark. The mark-triggered reroute keeps that source, so at any priority below
# 1200 this band is unreachable for exactly the traffic it exists to carry: on 2026-09-18 the ioa set
# marked packets correctly, rule 1200 sent them back out wlan0, and tun0 carried zero packets in
# either direction while every internal address timed out. Still below 1100, so iOA's own fwmark
# 0xa38 band keeps precedence, and below P_LOCAL, so the on-link protections stay in front.
P_IOA=1150
# 2500 held this band until 1200's precedence was understood.
P_RETIRED_IOA=2500
P_TAILNET=3000
# iOA SmartGate's own policy, installed through scripts/overrides/ip. This
# script never manages these bands, but it audits their consistency: rule
# 1200 captures every locally sourced packet, so a stale table 230 default
# (dead gateway after a roam) blackholes the whole machine.
P_IOA_SMART_MARK=1100
P_IOA_SMART_SRC=1200
IOA_SMART_TABLE=20
IOA_SRC_TABLE=230

warn() { logger -t network-reconfigure -p daemon.err "$*"; }

clean_pref() { while ip rule del pref "$1" 2>/dev/null; do :; done; }

# Add desired rules before deleting stale rules, so an owned band is never empty.
normalise_rule() {
    sed -E \
        -e 's/fwmark 0( |$)/fwmark 0x0\1/' \
        -e 's/fwmark (0x[0-9a-f]+)( (lookup|prohibit))/fwmark \1\/0xffffffff\2/' \
        <<<"$1"
}

canonical_rules() {
    local spec
    for spec in "$@"; do
        [ -n "$spec" ] && normalise_rule "$spec"
    done | sort -u
}

# Add desired rules before deleting stale rules, then prove the owned band is exact.
reconcile_pref() {
    local pref=$1 spec have normalised
    shift
    local desired=() remaining=()
    mapfile -t desired < <(canonical_rules "$@")
    for spec in "${desired[@]}"; do
        # shellcheck disable=SC2086 # rule specs are intentional argument lists
        ip rule add $spec pref "$pref" 2>/dev/null || true
    done
    remaining=("${desired[@]}")
    while read -r have; do
        [ -n "$have" ] || continue
        have=${have#*:}
        have=${have#"${have%%[![:space:]]*}"}
        normalised=$(normalise_rule "$have")
        for i in "${!remaining[@]}"; do
            if [ "$normalised" = "${remaining[$i]}" ]; then
                unset 'remaining[i]'
                continue 2
            fi
        done
        # shellcheck disable=SC2086 # kernel-rendered rule is an argument list
        ip rule del pref "$pref" $have
    done <<<"$({ ip -4 rule show pref "$pref" 2>/dev/null || true; })"
    [ "$(normalise_actual_band "$(band_fingerprint "$pref")")" = \
        "$(printf '%s\n' "${desired[@]}" | awk 'NF' | sort | paste -sd';' -)" ]
}

set_cn_bands() {
    if cn_set_has_matches; then
        DESIRED_BANDS[$P_CN]="from all fwmark $CN_MARK lookup main"
        DESIRED_BANDS[$P_CN_STOP]="from all fwmark $CN_MARK prohibit"
    else
        DESIRED_BANDS[$P_CN]=""
        DESIRED_BANDS[$P_CN_STOP]=""
    fi
}

reconcile_desired_band() {
    local band=$1
    IFS=';' read -r -a want <<<"${DESIRED_BANDS[$band]}"
    reconcile_pref "$band" "${want[@]}"
}

# Add the desired source-NAT rule before removing stale copies. Deleting all copies first opens a
# real leak window: an unbound socket initially gets tailscale0's source, OUTPUT reroutes it to the
# physical device, and a packet crossing this window leaves with that tailnet source. Worse, the
# no-NAT decision is then retained by conntrack after the rule returns.
# The third argument, when false, leaves similar MASQUERADE rules on other devices alone. The fourth,
# when false, stages the desired rule without pruning anything so a route switch can happen between
# those two operations.
reconcile_mark_masquerade() {
    local mark=$1 dev=$2 replace_all=${3:-true} prune=${4:-true}
    local base desired rule kept=false
    base=${mark%%/*}
    iptables -t nat -C POSTROUTING -o "$dev" -m mark --mark "$mark" \
        -j MASQUERADE 2>/dev/null ||
        iptables -t nat -A POSTROUTING -o "$dev" -m mark --mark "$mark" \
            -j MASQUERADE
    desired=$(iptables -t nat -S POSTROUTING 2>/dev/null | grep -E -m1 -- \
        "^-A POSTROUTING -o $dev -m mark --mark $base(/0xffffffff)? -j MASQUERADE$")
    [ -n "$desired" ]
    $prune || return 0
    while IFS= read -r rule; do
        [ -n "$rule" ] || continue
        if [ "$rule" = "$desired" ] && ! $kept; then
            kept=true
            continue
        fi
        $replace_all || [ "$rule" = "$desired" ] || continue
        # shellcheck disable=SC2086 # iptables -S output is intentional argument input
        iptables -t nat ${rule/-A /-D }
    done < <(iptables -t nat -S POSTROUTING 2>/dev/null |
        grep -E -- "^-A POSTROUTING -o [^ ]+ -m mark --mark $base(/0xffffffff)? -j MASQUERADE$" ||
        true)
}

PHYSICAL_IFACE_GLOBS=(wlan wlp enp eth eno ens)

install_source_guard() {
    local glob
    {
        cat <<'NFT'
destroy table ip serverconfig_source_guard
add table ip serverconfig_source_guard
add set ip serverconfig_source_guard foreign_sources {
    type ipv4_addr
    flags interval
    elements = { 100.64.0.0/10, 192.168.255.0/24 }
}
add chain ip serverconfig_source_guard postrouting {
    type filter hook postrouting priority 110
    policy accept
}
NFT
        for glob in "${PHYSICAL_IFACE_GLOBS[@]}"; do
            printf 'add rule ip serverconfig_source_guard postrouting oifname "%s*" ip saddr @foreign_sources counter drop\n' \
                "$glob"
        done
    } | nft -f -
}

physical_gateway() {
    ip -4 route show table main default 2>/dev/null |
        awk '$5 ~ /^(wlan|wlp|enp|eth|eno|ens)/ {print $3; exit}'
}

physical_device() {
    ip -4 route show table main default 2>/dev/null |
        awk '$5 ~ /^(wlan|wlp|enp|eth|eno|ens)/ {print $5; exit}'
}

dhcp_dns_servers() {
    { networkctl dhcp-lease "$1" 2>/dev/null || true; } |
        awk '
            /domain name server/ { infield = 1; for (i = 5; i <= NF; i++) print $i; next }
            infield && NF == 1 && $1 ~ /^[0-9.]+$/ { print $1; next }
            { infield = 0 }
        ' | sort -u
}

dhcp_router() {
    { networkctl dhcp-lease "$1" 2>/dev/null || true; } |
        awk '$2 == "router" && $3 ~ /^[0-9.]+$/ { print $3; exit }'
}

dhcp_captive_portal_hostname() {
    { networkctl dhcp-lease "$1" 2>/dev/null || true; } |
        awk '$2 == "captive" && $3 == "portal" { print $4; exit }' |
        python3 -c 'import sys, urllib.parse; print(urllib.parse.urlparse(sys.stdin.read().strip()).hostname or "")'
}

wired_devices() {
    ip -o link show up |
        awk -F': ' '$2 ~ /^en/ { sub(/@.*/, "", $2); print $2 }' |
        sort -u
}

# What makes a link the office LAN is that the office LAN authenticated it. The 802.1X supplicant
# reports that directly, and everything downstream depends on the answer: the office SmartDNS
# fragment, the resolver pins, and the table 19 underlay advertisement.
#
# Two weaker judgements were tried and both were wrong. Matching any Ethernet name hands all three to
# a phone tethered over USB, mapping intranet domains at the phone's resolver and pointing
# SmartGateAgent's underlay at the phone's gateway. Matching the registered adapter's hardware
# address identifies the dongle rather than the network, so the same dongle in a hotel port claims to
# be the office LAN, and any other card in a real office port is missed.
#
# Authorization is also the honest reading of a port that hands out a lease but refuses to authorize
# us. On 2026-09-20 this one was HELD/Unauthorized after EAP-TLS failure: no internet, and its
# resolvers answered some intranet names and not others. Declining to call that the office LAN is
# correct, and it is what keeps iOA's bootstrap on the public endpoint it can actually reach. A link
# with no supplicant at all — a tether, a hotel port — fails this for the same reason.
office_wired_authorized() {
    { "$WPA_CLI" -i "$1" status 2>/dev/null || true; } |
        grep -Fqx 'suppPortStatus=Authorized'
}

office_wired_devices() {
    local dev
    while read -r dev; do
        office_wired_authorized "$dev" || continue
        printf '%s\n' "$dev"
    done < <(wired_devices)
}

office_wired_candidate() {
    local dev gateway
    while read -r dev; do
        [ -n "$(ip -4 -o addr show "$dev" scope global)" ] || continue
        gateway=$(dhcp_router "$dev")
        [ -n "$gateway" ] || continue
        printf '%s %s\n' "$dev" "$gateway"
        return
    done < <(office_wired_devices)
}

# Whether a wired gateway is worth a default route is a question about the network, so it is answered
# by asking the network. networkd is told to ignore the offered gateway entirely, because a wrong
# default route here is not a degraded state but a total one: the office gateway reaches the intranet
# and not the internet, and at metric 100 it outranks Wi-Fi and blackholes the host. So nothing is
# installed until one TCP handshake through that gateway has crossed to a public anchor.
#
# The probe needs a route to the anchor before there is a default route, which is what the temporary
# host route is for. It is withdrawn either way: on success the default route supersedes it, and on
# failure nothing should be left pointing at a gateway that led nowhere.
#
# Exit 2 means the probe never reached the path and measured nothing; treating that as success would
# install a default route on no evidence, which is the failure this function exists to prevent.
wired_gateway_reaches_internet() {
    local dev=$1 gateway=$2 source rc
    source=$(ip -4 -oneline addr show dev "$dev" scope global 2>/dev/null |
        awk '{for (i = 1; i <= NF; i++) if ($i == "inet") {split($(i + 1), a, "/"); print a[1]; exit}}')
    [ -n "$source" ] || return 1
    ip route replace "$PROBE_TARGET" via "$gateway" dev "$dev" 2>/dev/null || return 1
    "$PROBE" --target "$PROBE_TARGET" --port "$PROBE_PORT" --source "$source" \
        --interface "$dev" --mark "$PROBE_MARK" --timeout "$PROBE_TIMEOUT" >/dev/null 2>&1
    rc=$?
    ip route del "$PROBE_TARGET" via "$gateway" dev "$dev" 2>/dev/null || true
    [ "$rc" -eq 0 ]
}

# A wired link earns main's default route by proving it, and loses it the moment it cannot. Removing
# it by device rather than by gateway matters: a link that moved to another network leaves a default
# route naming the old gateway, and that is exactly the blackhole this is here to avoid.
reconcile_wired_default_route() {
    local dev gateway desired='' existing
    while read -r dev; do
        gateway=$(dhcp_router "$dev")
        [ -n "$gateway" ] || continue
        [ -n "$(ip -4 -o addr show "$dev" scope global)" ] || continue
        if wired_gateway_reaches_internet "$dev" "$gateway"; then
            desired="default via $gateway dev $dev metric 100"
            ip route replace default via "$gateway" dev "$dev" metric 100
            break
        fi
    done < <(wired_devices)
    while read -r existing; do
        [ -n "$existing" ] || continue
        [ "$existing" = "$desired" ] && continue
        ip route del $existing 2>/dev/null || true
    done < <(ip -4 route show table main default 2>/dev/null |
        awk '{for (i = 1; i < NF; i++) if ($i == "dev" && $(i + 1) ~ /^en/) { print; next }}')
}

count_routes() { { ip route show table "$1" 2>/dev/null || true; } | wc -l; }
has_routes() { [ "$(count_routes "$1")" -gt 0 ]; }

# Read from the lease, not from a checked-in list. Each office advertises its own resolvers — this
# site hands out 21.7.193.132, 21.7.193.156 and 10.76.9.15, none of which were among the three
# addresses the repository used to hardcode — so a fixed list is stale everywhere except where it
# was written.
office_dns_servers() {
    [ -n "$1" ] || return 0
    dhcp_dns_servers "$1"
}

# The `ioa` group's only upstream is iOA's own DNS server on the tunnel address, and that server does
# not always exist. SmartGateAgent asks SmartGate which scene it is in and starts it only for EXTRA
# and OVERSEA; on the office LAN the answer is `sceneID:1, sceneName:INTRA` and it logs `start dns
# server fail : scene 1 is not supported` on every network change. That is deliberate — on the
# intranet the site resolvers are the answer — but the group carries -exclude-default-group, so its
# domains resolve nowhere at all until something else claims them. Re-point every one of them at the
# lease resolvers for as long as the office LAN is authorized.
#
# Derived from the base config instead of listed in the fragment, because a hand-kept list misses
# whatever is added to the base later. On 2026-09-21 it had drifted to one domain out of ten, which
# is why mirrors.tencent.com and eight others were unresolvable from an office desk.
# iOA's resolver answers only the names its own forward policy covers and NXDOMAINs the rest: with the
# tunnel up and logged in on 2026-09-21, es.tencentyun.com, oa.tencent.com, m.tencent.com and
# tco-es.polaris were all NXDOMAIN from 192.168.255.10 while an office resolver reached through that
# same tunnel answered every one of them. So the group needs a real intranet resolver beside iOA's.
#
# Learned from an office lease rather than checked in, for the reason the office pins are: every site
# advertises its own, and the three addresses this repository once hardcoded exist nowhere here. Once
# learned the address works from anywhere, because iOA proxies DNS to intranet addresses through the
# tunnel — its forward log records these very queries leaving for 10.76.9.15 — and it rewrites the
# answers for the names it does cover, so fakeip survives whichever upstream answers first.
ipv4_to_int() {
    local IFS=. a b c d
    [[ $1 =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
    read -r a b c d <<<"$1"
    [ "$((10#$a))" -le 255 ] && [ "$((10#$b))" -le 255 ] &&
        [ "$((10#$c))" -le 255 ] && [ "$((10#$d))" -le 255 ] || return 1
    printf '%s' "$(((10#$a << 24) | (10#$b << 16) | (10#$c << 8) | 10#$d))"
}

ipv4_in_cidr() {
    local ip net bits mask
    ip=$(ipv4_to_int "$1") || return 1
    net=$(ipv4_to_int "${2%/*}") || return 1
    bits=${2#*/}
    mask=$(((bits == 0 ? 0 : 0xFFFFFFFF << (32 - bits)) & 0xFFFFFFFF))
    [ "$((ip & mask))" -eq "$((net & mask))" ]
}

# Only the addresses this host actually routes into the tunnel are usable as tunnel-side resolvers, and
# that set is exactly IOA_STATIC_CIDRS. This office's lease also advertises 21.7.193.132 and
# 21.7.193.156, which land on Tailscale off the office LAN — recording those would send intranet DNS
# out of the exit node instead of the tunnel, and they answer nothing from there.
tunnel_reachable_resolvers() {
    local resolver cidr
    while read -r resolver; do
        [ -n "$resolver" ] || continue
        for cidr in "${IOA_STATIC_CIDRS[@]}"; do
            if ipv4_in_cidr "$resolver" "$cidr"; then
                printf '%s\n' "$resolver"
                break
            fi
        done
    done < <(office_dns_servers "$1")
}

remember_intranet_resolvers() {
    local resolvers tmp
    resolvers=$(tunnel_reachable_resolvers "$1")
    [ -n "$resolvers" ] || return 0
    mkdir -p "${INTRANET_RESOLVER_CACHE%/*}" 2>/dev/null || return 0
    tmp=$(mktemp "$INTRANET_RESOLVER_CACHE.XXXXXX" 2>/dev/null) || {
        warn "cannot create an intranet resolver cache candidate"
        return 0
    }
    if printf '%s\n' "$resolvers" > "$tmp" && chmod 644 "$tmp" &&
       mv "$tmp" "$INTRANET_RESOLVER_CACHE"; then
        return 0
    fi
    rm -f "$tmp"
    warn "cannot record intranet resolvers in $INTRANET_RESOLVER_CACHE"
}

intranet_resolvers() { cat "$INTRANET_RESOLVER_CACHE" 2>/dev/null || true; }

office_tunnel_resolver_overrides() {
    [ -r "$SMARTDNS_BASE" ] || {
        warn "cannot read $SMARTDNS_BASE; office DNS leaves tunnel-resolver domains alone"
        return 0
    }
    sed -n 's|^nameserver /\([^/]*\)/ioa$|nameserver /\1/office|p' "$SMARTDNS_BASE"
}

# The office resolvers sit off-link behind the wired gateway, and the office link contributes no
# default route to main, so the priority-1000 pins that send them to main had nothing to resolve them
# through: all three timed out on 2026-09-20 while the same queries answered in milliseconds once
# routed through that gateway. Give each one an explicit host route there. Resolvers left over from
# another site are withdrawn; a link that goes away takes its routes with it.
reconcile_office_resolver_routes() {
    local dev=$1 gateway=$2 resolver wanted desired=()
    while read -r resolver; do
        [ -n "$resolver" ] || continue
        ip route replace "$resolver" via "$gateway" dev "$dev"
        desired+=("$resolver")
    done < <(office_dns_servers "$dev")
    while read -r resolver; do
        [ -n "$resolver" ] || continue
        for wanted in ${desired[@]+"${desired[@]}"}; do
            [ "$wanted" = "$resolver" ] && continue 2
        done
        ip route del "$resolver" dev "$dev" 2>/dev/null || true
    done < <(ip -4 route show table main dev "$dev" 2>/dev/null |
        awk '$1 !~ /\// && $2 == "via" { print $1 }')
}

validate_fixed_table() {
    local id=$1 name=$2 id_count name_count exact_count
    read -r id_count name_count exact_count < <(awk -v id="$id" -v name="$name" '
        $1 !~ /^#/ && NF >= 2 {
            key = $1 SUBSEP $2
            if (!seen[key]++) {
                if ($1 == id) id_count++
                if ($2 == name) name_count++
                if ($1 == id && $2 == name) exact_count++
            }
        }
        END { print id_count + 0, name_count + 0, exact_count + 0 }
    ' "$RT_TABLES")
    if [ "$id_count" -eq 0 ] && [ "$name_count" -eq 0 ]; then
        return
    fi
    if [ "$id_count" -eq 1 ] && [ "$name_count" -eq 1 ] && [ "$exact_count" -eq 1 ]; then
        return
    fi
    warn "routing table registration conflicts: $id $name"
    return 1
}

register_fixed_table() {
    local id=$1 name=$2 tmp
    validate_fixed_table "$id" "$name"
    tmp=$(mktemp "$RT_TABLES.XXXXXX")
    awk -v id="$id" -v name="$name" '
        $1 !~ /^#/ && $1 == id && $2 == name {
            if (found++) next
        }
        { print }
        END { if (!found) print id, name }
    ' "$RT_TABLES" > "$tmp"
    if cmp -s "$tmp" "$RT_TABLES"; then
        rm -f "$tmp"
        return
    fi
    chmod --reference="$RT_TABLES" "$tmp"
    chown --reference="$RT_TABLES" "$tmp"
    mv "$tmp" "$RT_TABLES"
}

validate_fixed_table 19 "$WIRED_UNDERLAY_TABLE"
validate_fixed_table 400 "$IOA_TABLE"
register_fixed_table 19 "$WIRED_UNDERLAY_TABLE"
register_fixed_table 400 "$IOA_TABLE"

# Names left by the gateway-coupled CN tables. Flushing the FIB is not enough:
# as long as the names remain, `ip rule add lookup cn` still resolves.
unregister_named_tables() {
    local tmp
    tmp=$(mktemp "$RT_TABLES.XXXXXX")
    awk '$1 ~ /^#/ || ($2 != "cn" && $2 != "cn_stage")' "$RT_TABLES" > "$tmp"
    if cmp -s "$tmp" "$RT_TABLES"; then
        rm -f "$tmp"
        return
    fi
    chmod --reference="$RT_TABLES" "$tmp"
    chown --reference="$RT_TABLES" "$tmp"
    mv "$tmp" "$RT_TABLES"
}

unregister_named_tables

ensure_ipset() {
    local name=$1 type=${2:-hash:ip}
    ipset -t list "$name" >/dev/null 2>&1 && return 0
    ipset create "$name" "$type" family inet maxelem 655360 -exist
}

ensure_ipset "$CN_SET" hash:net
ensure_ipset "$CN_NEXT_SET" hash:net

for _ in {1..10}; do
    [ -n "$(ip route show table main scope link dev "$IFACE" 2>/dev/null)" ] && break
    sleep 1
done || true
for _ in {1..10}; do
    dns=$(dhcp_dns_servers "$IFACE")
    [ -n "${dns:-}" ] && break
    sleep 1
done || true
portal_hostname=$(dhcp_captive_portal_hostname "$IFACE")
# Before anything reads main's default route — the local band, the SmartGate underlay audit — settle
# whether a wired link deserves to own it.
reconcile_wired_default_route
wired_dev=''
wired_gateway=''
read -r wired_dev wired_gateway < <(office_wired_candidate || true) || true
if [ -n "$wired_dev" ] && [ -n "$wired_gateway" ]; then
    ioa_environment=office
else
    ioa_environment=external
fi

# Keep SmartDNS fragments atomic and restart only when their contents change.
SMARTDNS_CHANGED=0
write_if_changed() {
    local dst=$1 content=$2 tmp
    tmp=$(mktemp "$dst.XXXXXX" 2>/dev/null) ||
        { warn "cannot create a temp file beside $dst; leaving it as it is"; return 0; }
    if ! printf '%s\n' "$content" > "$tmp" 2>/dev/null; then
        rm -f "$tmp"
        warn "cannot write $tmp; leaving $dst as it is"
        return 0
    fi
    if cmp -s "$tmp" "$dst" 2>/dev/null; then
        rm -f "$tmp"
        return 0
    fi
    chmod 644 "$tmp" 2>/dev/null || true
    if mv "$tmp" "$dst" 2>/dev/null; then
        SMARTDNS_CHANGED=1
    else
        rm -f "$tmp"
        warn "cannot replace $dst; leaving $dst as it is"
    fi
    return 0
}

if [ -n "${dns:-}" ] && [ -n "$portal_hostname" ]; then
    # DHCP DNS is untrusted and exists only to resolve the RFC 8910 captive-portal endpoint.
    # Never add it to SmartDNS' default group: hotels commonly rewrite public names (including
    # google.com) to policy-enforcing addresses even after authentication succeeds.
    # shellcheck disable=SC2086 # DNS servers intentionally expand to separate arguments
    write_if_changed /etc/smartdns/dhcp-dns.conf \
        "$(printf '# Captive portal DNS from %s\n' "$IFACE"; \
           printf 'server %s -group captive -exclude-default-group\n' $dns; \
           printf 'nameserver /%s/captive\n' "$portal_hostname")"
else
    write_if_changed /etc/smartdns/dhcp-dns.conf "# No captive portal DNS"
fi

# Learn while on the office LAN, use everywhere. The cache lives under /var/lib because the addresses
# stay valid across reboots, unlike the uptime-based state in /run.
[ -n "$wired_dev" ] && [ -n "$wired_gateway" ] && remember_intranet_resolvers "$wired_dev"
ioa_resolvers=$(intranet_resolvers)
if [ -n "$ioa_resolvers" ]; then
    # shellcheck disable=SC2086 # resolvers intentionally expand to separate arguments
    write_if_changed "$IOA_RESOLVERS_DST" \
        "$(printf '# Intranet resolvers learned from an office DHCP lease. iOA proxies them through the\n'; \
           printf '# tunnel and answers the names its own policy covers, so fakeip is preserved.\n'; \
           printf 'server %s -group ioa -exclude-default-group -interface tun0\n' $ioa_resolvers)"
else
    write_if_changed "$IOA_RESOLVERS_DST" "# No intranet resolvers learned yet"
fi

if [ -z "$wired_dev" ] || [ -z "$wired_gateway" ]; then
    write_if_changed "$OFFICE_DST" "# Not on the office LAN"
elif [ -r "$OFFICE_SRC" ]; then
    # shellcheck disable=SC2086 # resolvers intentionally expand to separate arguments
    write_if_changed "$OFFICE_DST" \
        "$(cat "$OFFICE_SRC"; \
           printf '\n# Resolvers advertised by the %s DHCP lease\n' "$wired_dev"; \
           printf 'server %s -group office -exclude-default-group\n' \
               $(office_dns_servers "$wired_dev"); \
           printf '\n# Tunnel-resolver domains from the base config; iOA runs no DNS in this scene\n'; \
           office_tunnel_resolver_overrides)"
else
    warn "cannot read $OFFICE_SRC; leaving $OFFICE_DST as it is"
fi

# On office exit, publish public bootstrap DNS while the old wired underlay still exists. Switching
# owner routing to main first would recreate the broken state where an internal answer leaves over
# Wi-Fi. Office entry is the inverse: keep public DNS until the wired route and NAT are ready below.
if [ "$ioa_environment" = external ] && [ "$SMARTDNS_CHANGED" -eq 1 ]; then
    if systemctl restart smartdns 2>/dev/null; then
        SMARTDNS_CHANGED=0
    fi
fi

if [ -n "$wired_dev" ] && [ -n "$wired_gateway" ]; then
    ip route replace default via "$wired_gateway" dev "$wired_dev" onlink \
        table "$WIRED_UNDERLAY_TABLE"
    while read -r route; do
        [ -n "$route" ] || continue
        [ "$route" = "default via $wired_gateway dev $wired_dev onlink" ] ||
            ip route del $route table "$WIRED_UNDERLAY_TABLE"
    done < <(ip route show table "$WIRED_UNDERLAY_TABLE")
    reconcile_office_resolver_routes "$wired_dev" "$wired_gateway"
fi

CACHE_DIR="/var/lib/network-reconfigure"
STATE_FILE="$CACHE_DIR/last-applied"
CN_STATE_FILE="$CACHE_DIR/cn-last-applied"
mkdir -p "$CACHE_DIR"
routefile_state=$(sha256sum "$ROUTEFILE" 2>/dev/null | awk '{print $1}' || printf missing)
cn_exclude_state=$(sha256sum "$CN_EXCLUDE_FILE" 2>/dev/null |
    awk '{print $1}' || printf missing)
current_state="iface=$IFACE gw=$(physical_gateway) dev=$(physical_device) dns=${dns:-}"
current_state+=" portal=${portal_hostname:-} routefile=$routefile_state exclude=$cn_exclude_state"
cn_input_state="routefile=$routefile_state exclude=$cn_exclude_state"

cn_set_entries() {
    ipset save "$CN_SET" 2>/dev/null |
        awk -v set="$CN_SET" '
            $1 == "add" && $2 == set {
                printf "%s", $3
                if ($4 == "nomatch") printf " nomatch"
                print ""
            }
        ' | sort
}

cn_set_hash() { cn_set_entries | sha256sum | awk '{print $1}'; }

cn_state_matches() {
    local state recorded_hash
    state=$(cat "$CN_STATE_FILE" 2>/dev/null || true)
    [[ "$state" == "$cn_input_state "* ]] || return 1
    recorded_hash=${state##* sethash=}
    [[ "$recorded_hash" =~ ^[0-9a-f]{64}$ ]] || return 1
    [ "$recorded_hash" = "$(cn_set_hash)" ]
}

# Read the whole set before deciding. Any early exit — `grep -q` or a `return` out of a read
# loop — closes the pipe, SIGPIPEs the upstream `sort`, and pipefail then reports failure even
# though a positive prefix exists, silently dropping priority 1500.
cn_set_has_matches() {
    local entries positive
    entries=$(cn_set_entries)
    positive=$(awk 'NF && $NF != "nomatch"' <<<"$entries")
    [ -n "$positive" ]
}

declare -A DESIRED_BANDS
band_of() { canonical_rules "$@" | paste -sd';' -; }

if [ -n "$wired_dev" ] && [ -n "$wired_gateway" ]; then
    DESIRED_BANDS[$P_IOA_OWNER]="from all fwmark $IOA_OWNER_MARK lookup $WIRED_UNDERLAY_TABLE"
else
    DESIRED_BANDS[$P_IOA_OWNER]="from all fwmark $IOA_OWNER_MARK lookup main"
fi
DESIRED_BANDS[$P_IOA_OWNER_STOP]="from all fwmark $IOA_OWNER_MARK prohibit"
DESIRED_BANDS[$P_TS]="from all fwmark $TS_MARK lookup main"
DESIRED_BANDS[$P_RETIRED_IOA_MARK]=""
DESIRED_BANDS[$P_RETIRED_IOA]=""

# The enumerated pins below are a snapshot taken when this script runs, but the
# `to 10.0.0.0/8 lookup ioa` rule and table `ioa` both outlive it.
# A roam onto a different 10/8 subnet therefore leaves the pins naming the old
# LAN while the new gateway is still inside 10/8, so until the next run finishes
# — observed at up to 21s — that rule swallows the gateway into tun0 and the
# machine has an address and a default route but no reachable next hop.
# Suppressing prefix length 0 asks the kernel for main minus its default route,
# which is exactly "destinations that are on-link right now". It needs no
# snapshot, so the actual LAN and gateway stay direct even mid-roam.
local_band=("from all lookup main suppress_prefixlength 0")
while read -r subnet _; do
    [ -n "$subnet" ] && local_band+=("from all to $subnet lookup main")
done < <({ ip route show table main scope link 2>/dev/null || true; })
for addr in "$(physical_gateway)"; do
    [ -n "$addr" ] && local_band+=("from all to $addr lookup main")
done
if [ -n "$portal_hostname" ]; then
    for addr in ${dns:-}; do
        [ -n "$addr" ] && local_band+=("from all to $addr lookup main")
    done
fi
if [ -n "$wired_dev" ] && [ -n "$wired_gateway" ]; then
    while read -r addr; do
        [ -n "$addr" ] && local_band+=("from all to $addr lookup main")
    done < <(office_dns_servers "$wired_dev")
fi
DESIRED_BANDS[$P_LOCAL]=$(band_of "${local_band[@]}")
set_cn_bands

ioa_band=("from all fwmark 0x1 lookup $IOA_TABLE")
for cidr in "${IOA_STATIC_CIDRS[@]}"; do
    ioa_band+=("from all to $cidr fwmark 0x0/0xffffffff lookup $IOA_TABLE")
done
DESIRED_BANDS[$P_IOA]=$(band_of "${ioa_band[@]}")

tailnet_band=()
for net in "${TAILNET_NETS[@]}"; do
    tailnet_band+=("from all to $net lookup 52")
done
DESIRED_BANDS[$P_TAILNET]=$(band_of "${tailnet_band[@]}")

# `awk NF` instead of `grep -v '^$'`: an empty band is normal, but grep exits 1 on no match and
# pipefail then fires the ERR trap, logging a false "aborted" line that hides real aborts.
normalise_desired_band() { tr ';' '\n' <<<"$1" | awk 'NF' | sort -u | paste -sd';' -; }
normalise_actual_band() { tr ';' '\n' <<<"$1" | awk 'NF' | sort | paste -sd';' -; }
band_fingerprint() {
    ip -4 rule show pref "$1" 2>/dev/null | sed 's/^[0-9]*:[[:space:]]*//' |
        while read -r rule; do normalise_rule "$rule"; done
}

desired_fingerprint() {
    local band
    for band in "${!DESIRED_BANDS[@]}"; do
        printf '%s|%s\n' "$band" \
            "$(normalise_desired_band "${DESIRED_BANDS[$band]}")"
    done | sort
}

actual_fingerprint() {
    local band
    for band in "${!DESIRED_BANDS[@]}"; do
        printf '%s|%s\n' "$band" \
            "$(normalise_actual_band "$(band_fingerprint "$band" | paste -sd';' -)")"
    done | sort
}

# Move the owner path without a zero-NAT window. During either direction both source-NAT rules exist:
# first make the new egress source-valid, then switch pref 400, then prune the old egress rule. On
# office exit table 19 remains usable until pref 400 is safely back on main.
physical_dev=$(physical_device)
[ -n "$physical_dev" ] || physical_dev=$IFACE
owner_dev=${wired_dev:-$physical_dev}
reconcile_mark_masquerade "$IOA_OWNER_MARK" "$owner_dev" true false
reconcile_desired_band "$P_IOA_OWNER_STOP"
reconcile_desired_band "$P_IOA_OWNER"
reconcile_mark_masquerade "$IOA_OWNER_MARK" "$owner_dev"
if [ "$ioa_environment" = external ]; then
    ip route flush table "$WIRED_UNDERLAY_TABLE" 2>/dev/null || true
fi

active_ioa_cgroups() {
    local cgroup path
    if [ -n "${IOA_CGROUP_PATHS_OVERRIDE+x}" ]; then
        [ "${#IOA_CGROUP_PATHS[@]}" -eq 0 ] || printf '%s\n' "${IOA_CGROUP_PATHS[@]}"
        return
    fi
    for cgroup in "${IOA_CGROUP_PATHS[@]}"; do
        [ -d "$CGROUP_ROOT/$cgroup" ] && printf '%s\n' "$cgroup"
    done
    for path in "$CGROUP_ROOT"/user.slice/user-*.slice/user@*.service/app.slice/ioagui.service; do
        [ -d "$path" ] && printf '%s\n' "${path#"$CGROUP_ROOT"/}"
    done
    # Always succeed: a stopped ngnclient simply has no cgroup to mark. A
    # non-zero exit here would fire the inherited ERR trap inside the
    # caller's process substitution and log a spurious "aborted" line even
    # though the parent shell continues normally.
    return 0
}

firewall_fingerprint_ok() {
    local expected actual cgroup
    expected=''
    while read -r cgroup; do
        expected+="-A $CHAIN -m cgroup --path \"$cgroup\" -j MARK --set-xmark 0x1000000/0xffffffff"$'\n'
    done < <(active_ioa_cgroups)
    expected+="-A $CHAIN -m mark ! --mark 0x0/0xffffffff -j RETURN"$'\n'
    expected+="-A $CHAIN -m set --match-set $CN_SET dst -j MARK --set-xmark 0x2/0xffffffff"$'\n'
    expected+="-A $CHAIN -m mark ! --mark 0x0/0xffffffff -j RETURN"$'\n'
    expected+="-A $CHAIN -m set --match-set ioa dst -j MARK --set-xmark 0x1/0xffffffff"
    actual=$(iptables -t mangle -S "$CHAIN" 2>/dev/null | grep "^-A $CHAIN " || true)
    [ "$actual" = "$expected" ] || return 1
    [ "$(iptables -t nat -S POSTROUTING 2>/dev/null |
        grep -Fxc -- '-A POSTROUTING -o tun0 -m mark --mark 0x1 -j MASQUERADE')" -eq 1 ] ||
        return 1
    local physical_dev owner_dev
    physical_dev=$(physical_device)
    [ -n "$physical_dev" ] || physical_dev=$IFACE
    owner_dev=${wired_dev:-$physical_dev}
    [ "$(iptables -t nat -S POSTROUTING 2>/dev/null |
        grep -Fxc -- "-A POSTROUTING -o $owner_dev -m mark --mark 0x1000000 -j MASQUERADE")" -eq 1 ] ||
        return 1
    [ "$(iptables -t nat -S POSTROUTING 2>/dev/null |
        grep -E -c -- "-A POSTROUTING -o $physical_dev -m mark --mark 0x2(/0xffffffff)? -j MASQUERADE")" -eq 1 ] ||
        return 1
    iptables -t mangle -C POSTROUTING -m mark --mark "$IOA_OWNER_MARK" \
        -o tailscale0 -j DROP 2>/dev/null
}

source_guard_fingerprint_ok() {
    local rules glob
    rules=$(nft -s list table ip serverconfig_source_guard 2>/dev/null) || return 1
    grep -Fq 'elements = { 100.64.0.0/10, 192.168.255.0/24 }' <<<"$rules" || return 1
    grep -Fq 'type filter hook postrouting priority srcnat + 10; policy accept;' \
        <<<"$rules" || return 1
    for glob in "${PHYSICAL_IFACE_GLOBS[@]}"; do
        grep -Fq "oifname \"${glob}*\" ip saddr @foreign_sources counter drop" \
            <<<"$rules" || return 1
    done
}

ngnclient_active() {
    if [ -n "${NGNCLIENT_ACTIVE_OVERRIDE:-}" ]; then
        [ "$NGNCLIENT_ACTIVE_OVERRIDE" = 1 ]
        return
    fi
    systemctl is-active --quiet ngnclient.service 2>/dev/null
}

# Record the office/external edge and touch nothing else. iOA tracks its own location: SmartGateAgent
# refetches the scene from SmartGate every five minutes and on each network-change event, and one
# agent process is observed flipping between EXTRA and INTRA in place, so a stale mode corrects itself
# within five minutes.
#
# This used to `try-restart ngnclient` on the edge. Restarting that service tears down iOA.bin, which
# stops SmartGateAgent and takes the tunnel with it, and the session does not survive: both restarts
# on 2026-09-21 were followed by `Need login user name[...]`, and unplugging at 17:15 killed a working
# tunnel that had already picked up EXTRA and started its DNS server one second earlier. The state it
# was written to repair — iOA stuck on `outer net` at an office desk — came from the wired link
# failing 802.1X, which the registered MAC in 10-tencent-wired.link fixes at the source.
record_ioa_environment() {
    local previous state_dir
    previous=$(cat "$IOA_ENV_STATE" 2>/dev/null || true)
    [ "$previous" != "$ioa_environment" ] || return 0
    state_dir=${IOA_ENV_STATE%/*}
    mkdir -p "$state_dir"
    printf '%s\n' "$ioa_environment" > "$IOA_ENV_STATE"
}

# Audit iOA SmartGate's underlay policy on every invocation, including runs
# that would otherwise exit "no change": a same-subnet roam leaves
# current_state untouched, yet iOA may have redeployed table 230 against a
# transiently stale main table. The healthy table 230 default matches the
# shim's choice in scripts/overrides/ip — the wired underlay advertisement
# (table 19) when present, else the main table's physical default. Anything
# else is torn down (fail open): the netlink events make iOA redeploy
# against the now-settled main table, and until then lookups fall through
# to the normal rules instead of a dead gateway.
reconcile_ioa_smartgate() {
    local expected_default expected_gw expected_dev src_default src_gw src_dev
    if ngnclient_active; then
        [ -n "$(ip -4 rule show pref "$P_IOA_SMART_SRC" 2>/dev/null)" ] || return 0
        # A named table that has never held a route does not exist in the
        # kernel FIB: `ip route show table` then exits 2, which must not
        # abort the run under set -e — an absent underlay table simply means
        # "fall back to the main table's physical default".
        expected_default=$(ip -4 route show table "$WIRED_UNDERLAY_TABLE" default 2>/dev/null || true)
        if [ -z "$expected_default" ]; then
            expected_default=$(ip -4 route show table main default 2>/dev/null |
                awk '$5 ~ /^(wlan|wlp|enp|eth|eno|ens)/')
        fi
        expected_gw=$(awk '$1 == "default" { for (i = 1; i < NF; i++) if ($i == "via") { print $(i + 1); exit } }' <<<"$expected_default")
        expected_dev=$(awk '$1 == "default" { for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit } }' <<<"$expected_default")
        src_default=$(ip -4 route show table "$IOA_SRC_TABLE" default 2>/dev/null || true)
        src_gw=$(awk '$1 == "default" { for (i = 1; i < NF; i++) if ($i == "via") { print $(i + 1); exit } }' <<<"$src_default")
        src_dev=$(awk '$1 == "default" { for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit } }' <<<"$src_default")
        if [ -n "$src_gw" ] && [ "$src_gw" = "$expected_gw" ] && [ "$src_dev" = "$expected_dev" ]; then
            return 0
        fi
        warn "SmartGate underlay stale: table $IOA_SRC_TABLE default '${src_gw:-none}' dev '${src_dev:-none}', expected '${expected_gw:-none}' dev '${expected_dev:-none}'; tearing down pref $P_IOA_SMART_MARK/$P_IOA_SMART_SRC so iOA redeploys"
    else
        # iOA's own teardown can be killed mid-cleanup (SIGTERM races
        # observed), leaving pref 1100/1200 behind over flushed tables.
        [ -n "$(ip -4 rule show pref "$P_IOA_SMART_SRC" 2>/dev/null)" ] ||
        [ -n "$(ip -4 rule show pref "$P_IOA_SMART_MARK" 2>/dev/null)" ] ||
        has_routes "$IOA_SMART_TABLE" || has_routes "$IOA_SRC_TABLE" ||
            return 0
        warn "ngnclient inactive but SmartGate policy remains; cleaning pref $P_IOA_SMART_MARK/$P_IOA_SMART_SRC and tables $IOA_SMART_TABLE/$IOA_SRC_TABLE"
    fi
    clean_pref "$P_IOA_SMART_MARK"
    clean_pref "$P_IOA_SMART_SRC"
    ip route flush table "$IOA_SMART_TABLE" 2>/dev/null || true
    ip route flush table "$IOA_SRC_TABLE" 2>/dev/null || true
}
reconcile_ioa_smartgate

if [ "${FORCE:-0}" != 1 ] &&
   [ "$SMARTDNS_CHANGED" -eq 0 ] &&
   [ "$(cat "$IOA_ENV_STATE" 2>/dev/null || true)" = "$ioa_environment" ] &&
   [ "$current_state" = "$(cat "$STATE_FILE" 2>/dev/null || true)" ] &&
   cn_state_matches &&
   iptables -t mangle -C OUTPUT -j "$CHAIN" 2>/dev/null &&
   firewall_fingerprint_ok &&
   source_guard_fingerprint_ok &&
   [ "$(desired_fingerprint)" = "$(actual_fingerprint)" ]; then
    logger -t network-reconfigure -p daemon.info "no change ($current_state); nothing to do"
    exit 0
fi

TEMP_FILES=()
finish_state() {
    local rc=$1
    [ "${#TEMP_FILES[@]}" -eq 0 ] || rm -f "${TEMP_FILES[@]}"
    if [ "$rc" -eq 0 ]; then
        printf '%s' "$current_state" > "$STATE_FILE" 2>/dev/null ||
            warn "cannot record state in $STATE_FILE; the next run will rebuild"
    fi
    return 0
}
trap 'finish_state $?' EXIT

# Retire only obsolete repository-owned policy from earlier versions.
for p in 100 900 1401 2000 2501 3500 4000 4500; do clean_pref "$p"; done
rm -f "$CACHE_DIR/derp-ips" "$CACHE_DIR/ioa-endpoints"

valid_ipv4() {
    local address=$1 octets octet
    IFS=. read -r -a octets <<<"$address"
    [ "${#octets[@]}" -eq 4 ] || return 1
    for octet in "${octets[@]}"; do
        [[ "$octet" =~ ^(0|[1-9][0-9]{0,2})$ ]] && [ "$octet" -le 255 ] || return 1
    done
}

parse_routefile() {
    local line prefix address length
    local prefixes=()
    local legacy='^[[:space:]]*route[[:space:]]+(add|replace)[[:space:]]+([^[:space:]]+)[[:space:]]+via[[:space:]]+GATEWAY[[:space:]]+table[[:space:]]+cn[[:space:]]*$'
    local plain='^[[:space:]]*([^[:space:]#]+)[[:space:]]*(#.*)?$'
    while IFS= read -r line || [ -n "$line" ]; do
        [[ "$line" =~ ^[[:space:]]*$ ]] && continue
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        if [[ "$line" =~ $legacy ]]; then
            prefix=${BASH_REMATCH[2]}
        elif [[ "$line" =~ $plain ]]; then
            prefix=${BASH_REMATCH[1]}
        else
            return 1
        fi
        address=${prefix%/*}
        if [[ "$prefix" == */* ]]; then
            length=${prefix##*/}
            [[ "$length" =~ ^(0|[1-9]|[12][0-9]|3[0-2])$ ]] || return 1
        else
            prefix="$prefix/32"
        fi
        valid_ipv4 "$address" || return 1
        prefixes+=("$prefix")
        printf '%s\n' "$prefix"
    done < "$ROUTEFILE"
    [ "${#prefixes[@]}" -eq 0 ] ||
        [ "$(printf '%s\n' "${prefixes[@]}" | sort -u | wc -l)" -eq "${#prefixes[@]}" ]
}

parse_cn_excludes() {
    local line prefix address length
    local prefixes=()
    [ -e "$CN_EXCLUDE_FILE" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        line=${line%%#*}
        line=${line#"${line%%[![:space:]]*}"}
        line=${line%"${line##*[![:space:]]}"}
        [ -n "$line" ] || continue
        prefix=$line
        [[ "$prefix" != */* ]] && prefix="$prefix/32"
        address=${prefix%/*}
        length=${prefix##*/}
        [[ "$length" =~ ^(0|[1-9]|[12][0-9]|3[0-2])$ ]] || return 1
        valid_ipv4 "$address" || return 1
        prefixes+=("$prefix")
        printf '%s nomatch\n' "$prefix"
    done < "$CN_EXCLUDE_FILE"
    [ "${#prefixes[@]}" -eq 0 ] ||
        [ "$(printf '%s\n' "${prefixes[@]}" | sort -u | wc -l)" -eq "${#prefixes[@]}" ]
}

write_cn_state() {
    local content=$1 tmp
    tmp=$(mktemp "$CN_STATE_FILE.XXXXXX")
    printf '%s' "$content" >"$tmp"
    chmod 600 "$tmp"
    mv "$tmp" "$CN_STATE_FILE"
}

# CN is an optional acceleration classifier, not a gateway-bearing route table. Build an
# inactive hash:net set and swap it atomically. A stale set can only change which destinations
# go directly through the current main default; it cannot retain an old AP's gateway or blackhole
# the machine during a roam.
if [ "${FORCE_CN:-0}" = 1 ] || ! cn_state_matches; then
    cn_candidate=$(mktemp "$TMPDIR/cn-candidate.XXXXXX")
    cn_excludes=$(mktemp "$TMPDIR/cn-excludes.XXXXXX")
    cn_restore=$(mktemp "$TMPDIR/cn-restore.XXXXXX")
    TEMP_FILES+=("$cn_candidate" "$cn_excludes" "$cn_restore")
    cn_valid=true
    if [ -s "$ROUTEFILE" ]; then
        if ! parse_routefile | sort -u >"$cn_candidate" ||
           ! parse_cn_excludes | sed 's/ nomatch$//' | sort -u >"$cn_excludes"; then
            cn_valid=false
            warn "invalid routefile or exclusion list; keeping the last known-good CN acceleration set"
        fi
    else
        : >"$cn_candidate"
        : >"$cn_excludes"
    fi

    if $cn_valid; then
        {
            printf 'flush %s\n' "$CN_NEXT_SET"
            awk -v set="$CN_NEXT_SET" '{print "add " set " " $0}' "$cn_candidate"
        } >"$cn_restore"
        ipset restore -exist <"$cn_restore"
        # hash:net accepts a nomatch exception only when a positive parent currently matches it.
        # Irrelevant exclusions are safely omitted; they already fall through because no positive
        # CN prefix contains them. An empty positive list must stay empty: some ipset versions
        # accept orphan nomatch entries, which would keep a non-empty classifier with no effect.
        if [ -s "$cn_candidate" ]; then
            while read -r prefix; do
                [ -n "$prefix" ] || continue
                if ipset add "$CN_NEXT_SET" "$prefix" nomatch 2>/dev/null; then
                    printf '%s nomatch\n' "$prefix" >>"$cn_candidate"
                fi
            done <"$cn_excludes"
            sort -u -o "$cn_candidate" "$cn_candidate"
        fi
        ipset swap "$CN_SET" "$CN_NEXT_SET"
        ipset flush "$CN_NEXT_SET"
        write_cn_state "$cn_input_state sethash=$(cn_set_hash)"
    fi
    rm -f "$cn_candidate" "$cn_excludes" "$cn_restore"
    TEMP_FILES=()
fi

# Retire the gateway-coupled implementation. These tables are no longer consulted. Do not clear
# priority 1500 here: reconcile_pref repairs that owned band exactly at the end, while clearing it
# early creates a needless interval where CN traffic falls back to the exit node on every link event.
ip route flush table cn 2>/dev/null || true
ip route flush table 101 2>/dev/null || true
ip route flush table cn_stage 2>/dev/null || true
while read -r legacy_stage_id; do
    [[ "$legacy_stage_id" =~ ^10[0-9]{3}$ ]] || continue
    ip route flush table "$legacy_stage_id" 2>/dev/null || true
done < <(awk '$2 == "cn_stage" {print $1}' "$RT_TABLES")

set_cn_bands

# Build an independent chain before switching, so construction failures leave
# the previously healthy hook and chain byte-identical.
while iptables -t mangle -D OUTPUT -j "$NEXT_CHAIN" 2>/dev/null; do :; done
iptables -t mangle -F "$NEXT_CHAIN" 2>/dev/null || true
iptables -t mangle -X "$NEXT_CHAIN" 2>/dev/null || true
iptables -t mangle -N "$NEXT_CHAIN"
while read -r cgroup; do
    iptables -t mangle -A "$NEXT_CHAIN" \
        -m cgroup --path "$cgroup" \
        -j MARK --set-xmark "$IOA_OWNER_MARK"
done < <(active_ioa_cgroups)
iptables -t mangle -A "$NEXT_CHAIN" -m mark ! --mark 0x0/0xffffffff -j RETURN
iptables -t mangle -A "$NEXT_CHAIN" \
    -m set --match-set "$CN_SET" dst \
    -j MARK --set-xmark "$CN_MARK"
iptables -t mangle -A "$NEXT_CHAIN" -m mark ! --mark 0x0/0xffffffff -j RETURN
ensure_ipset ioa
iptables -t mangle -A "$NEXT_CHAIN" \
    -m set --match-set ioa dst \
    -j MARK --set-xmark 0x1/0xffffffff

# iptables-restore applies one table at COMMIT. Rebuild the stable chain and
# deduplicate its hook in that transaction; a rejected command changes nothing.
mark_transaction=$(printf '%s\n' '*mangle' ":$CHAIN - [0:0]")
while read -r _; do
    mark_transaction+=$'\n'"-D OUTPUT -j $CHAIN"
done < <(iptables -t mangle -S OUTPUT | grep -Fx -- "-A OUTPUT -j $CHAIN" || true)
mark_transaction+=$'\n'"-I OUTPUT 1 -j $CHAIN"
mark_transaction+=$'\n'"-F $CHAIN"
while read -r rule; do
    mark_transaction+=$'\n'"${rule/-A $NEXT_CHAIN /-A $CHAIN }"
done < <(iptables -t mangle -S "$NEXT_CHAIN" | grep "^-A $NEXT_CHAIN ")
mark_transaction+=$'\n'"-F $NEXT_CHAIN"
mark_transaction+=$'\n'"-X $NEXT_CHAIN"
mark_transaction+=$'\nCOMMIT'
iptables-restore --noflush <<<"$mark_transaction"

# Hard isolation, independent of any routing-table state: iOA-owned packets
# must never leave via tailscale0, even while an exit node is engaged. Rules
# 400/401 steer cgroup-marked traffic to the physical underlay or nowhere,
# but the mark is applied in mangle OUTPUT and the resulting reroute happens
# only after the LOCAL_OUT hooks — so at filter OUTPUT time the packet still
# carries its pre-mark route (table 52 → tailscale0 whenever an exit node is
# engaged) and a REJECT there would kill every iOA connection before the
# reroute can save it. POSTROUTING runs after the reroute, where the egress
# interface is final; keying off the owner mark the NETMODE_IOA chain has
# already applied, this backstop fires only if a routing surprise still
# leaks iOA traffic into the tailnet. REJECT is not allowed in POSTROUTING
# (no way to return an ICMP error), so DROP is the only terminal verdict.
# Retire the mis-placed filter OUTPUT variant from the first version of this
# backstop: it evaluated packets before the mark-triggered reroute and
# killed healthy iOA connections whenever an exit node was engaged.
while iptables -t filter -D OUTPUT -m mark --mark "$IOA_OWNER_MARK" \
    -o tailscale0 -j REJECT 2>/dev/null; do :; done
iptables -t mangle -C POSTROUTING -m mark --mark "$IOA_OWNER_MARK" \
    -o tailscale0 -j DROP 2>/dev/null ||
    iptables -t mangle -A POSTROUTING -m mark --mark "$IOA_OWNER_MARK" \
        -o tailscale0 -j DROP

# Final source validity is checked after srcnat, not in mangle POSTROUTING. At this priority every
# healthy CN/owner packet has already been rewritten to the physical address, while an ESTABLISHED
# flow whose old no-NAT conntrack state survived a DHCP transition still carries tailscale0/tun0's
# source and is dropped before the device sees it. Forwarded Tailscale traffic is normally rewritten
# by Tailscale's own srcnat before this hook too; forwarding a raw tailnet source onto a source-guarded
# physical network is invalid for the same reason as the local leak. Wildcard physical names make
# the invariant continuous across Wi-Fi/wired switches. The native nft table is replaced atomically.
install_source_guard

# Remove the repository-owned set retired by the authoritative SmartDNS model.
# It is unreferenced after the atomic chain switch, so destruction is safe and idempotent.
ipset destroy ioa_intranet 2>/dev/null || true

# During DHCP replacement main temporarily has no default, but IFACE remains the device that is
# about to receive it. Keep its NAT rule installed throughout that interval.
physical_dev=$(physical_device)
[ -n "$physical_dev" ] || physical_dev=$IFACE

# The first route lookup can select a Tailscale source before mangle OUTPUT classifies a CN
# destination. The mark-triggered reroute uses main, and this exact-mark NAT rewrites that stale
# source to the current physical address without touching owner or IOA traffic.
reconcile_mark_masquerade "$CN_MARK" "$physical_dev"

# Manage only the repository-owned exact IOA payload NAT rule; similar SNAT rules belong to others.
reconcile_mark_masquerade "$IOA_MARK" tun0 false

# The stop rule is part of the CN band. On upgrade, install it before exposing lookup main; when CN
# acceleration is disabled, remove lookup main before its stop. Thus no transition can expose 0x2
# to table 52, while a crash can at worst leave it safely prohibited.
if [ -n "${DESIRED_BANDS[$P_CN]}" ]; then
    reconcile_desired_band "$P_CN_STOP"
    reconcile_desired_band "$P_CN"
else
    reconcile_desired_band "$P_CN"
    reconcile_desired_band "$P_CN_STOP"
fi
for band in "${!DESIRED_BANDS[@]}"; do
    [ "$band" = "$P_CN" ] || [ "$band" = "$P_CN_STOP" ] ||
        [ "$band" = "$P_IOA_OWNER" ] || [ "$band" = "$P_IOA_OWNER_STOP" ] ||
        reconcile_desired_band "$band"
done

# Publish DNS only after its matching routes and source-NAT are ready. On office entry this prevents
# the old failure where SmartDNS returned an internal bootstrap address while owner traffic still
# left over Wi-Fi. On office exit the old route fails closed until both policy and public DNS are
# restored, rather than leaking internal traffic onto the external network.
if [ "$SMARTDNS_CHANGED" -eq 1 ]; then
    systemctl restart smartdns 2>/dev/null || true
fi
record_ioa_environment

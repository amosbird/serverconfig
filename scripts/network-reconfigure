#!/usr/bin/env bash
# network-reconfigure — reconcile policy routing after a link change
#
# Triggered at boot and on every wifi/link change (systemd path unit).
# Idempotent: every rule this owns is removed and reinstalled on each run.
#
#
# ## The one idea this file is built on
#
# Traffic splits into two kinds, and they must never share a priority band:
#
#   underlay — the packets that make a tunnel exist: tailscale's WireGuard,
#              DERP and control-plane traffic, IOA's handshake with its
#              gateway, and the DNS lookups those depend on. Sending any of
#              these into a tunnel is a circular dependency: the tunnel cannot
#              come up because the packets that would bring it up are waiting
#              for the tunnel. Underlay always leaves via the physical gateway.
#
#   overlay  — everything the user actually wants to move. Split by policy
#              across tailscale / IOA / direct.
#
# Every routing bug found here was one underlay packet captured by an overlay
# rule: a full-width MARK erasing tailscale's own 0x80000 and dropping
# WireGuard into the IOA tunnel; the CN table grabbing Chinese DERP nodes; and
# the exit-node catch-all swallowing control-plane and bootstrap DNS, which
# deadlocked tailscaled completely. Ordering alone does not prevent this — the
# underlay band has to exist and be listed first.
#
#
# ## Priority bands
#
#   0-99      kernel local
#   490       IOA's own underlay escape (fwmark 0xa38), pinned here
#   500-999   underlay  tunnel infrastructure — never enters a tunnel
#   1000-1999 local     directly-connected networks
#   2000-2999 ioa       Tencent intranet
#   3000-3999 tailnet   peers, then the private-range catch-all
#   4000-4999 cn        China direct, then the escape rule (4500) that
#                       network-fallback installs when the exit node is unusable
#   5000+     fallback  tailscale's own rules, then the exit node
#
# The escape rule belongs at the bottom, not the top: it must divert exactly
# the traffic that would otherwise use the exit node. Placed early it also
# captures IOA and tailnet traffic, so an exit-node failure would take the
# unrelated IOA tunnel down with it.

set -Eeuo pipefail

# `-E` is not decoration. Without it the ERR trap below is not inherited by
# shell functions, so a failure inside `warn`, `has_routes` or `physical_gateway`
# kills the script with the recovery hook silently skipped — which is the exact
# situation the trap exists for.

# A partially-applied rule set is dangerous in a way a failed run is not: the
# underlay protection can be gone while the exit-node catch-all is still there,
# which deadlocks tailscaled. `set -e` alone hides that — the script simply
# stops, leaving whatever it had managed to install. Report the failing line so
# the journal shows what happened instead of an unexplained exit code.
# Two things go wrong when a run stops half-way, and the trap has to undo both.
#
# Packets stay marked for a tunnel that no longer has a rule to reach it. The
# manual recovery was always `iptables -t mangle -D OUTPUT -j NETMODE_IOA`;
# unmarked traffic falls through to table main, which works.
#
# And the underlay rule may not have been reinstalled yet, while tailscale's own
# catch-all at pref 5270 is still live — so tailscale's control-plane and DERP
# traffic goes into the tunnel it is building, which deadlocks tailscaled. That
# one is worse, and removing the mangle jump does nothing for it. Put the rule
# back if the table it points at still has routes.
abort() {
    local rc=$1 line=$2
    logger -t network-reconfigure -p daemon.err \
        "aborted at line $line (exit $rc); restoring a minimal safe state"
    iptables -t mangle -D OUTPUT -j "${CHAIN:-NETMODE_IOA}" 2>/dev/null || true
    if [ "$({ ip route show table "${UNDERLAY_TABLE:-500}" 2>/dev/null || true; } |
              wc -l)" -gt 0 ] &&
       [ "$({ ip -4 rule show pref "${P_UNDERLAY:-500}" 2>/dev/null || true; } |
              wc -l)" -eq 0 ]; then
        ip rule add lookup "${UNDERLAY_TABLE:-500}" pref "${P_UNDERLAY:-500}" 2>/dev/null || true
    fi
}
trap 'abort $? $LINENO' ERR

IFACE="${1:-wlan0}"

# One reconciler at a time. There was no lock, and the destructive middle of
# this script is not safe against a second copy: run B's `ip route flush table
# 500` lands while run A has already installed the rule that points at it, so
# for the duration of B's re-add every underlay packet falls through to
# tailscale's catch-all — into the tunnel it is building. The .path unit fires
# several times per DHCP renew, so the interleaving is ordinary, not exotic.
#
# `-w` rather than `-n`: a link change that arrives mid-run is real and must not
# be dropped. The wait is bounded so a wedged run cannot queue events forever.
if [ -z "${NETWORK_RECONFIGURE_LOCKED:-}" ]; then
    export NETWORK_RECONFIGURE_LOCKED=1
    exec flock -w 60 /run/lock/network-reconfigure.lock "$0" "$@"
fi

# --- Firewall marks -----------------------------------------------------------
# Bit 0 is ours; the mask is not cosmetic. Tailscale marks its underlay packets
# 0x80000 so they escape its own routes, and a full-width --set-xmark erases
# that bit, which is exactly how WireGuard traffic ended up inside the IOA
# tunnel. Read and write only the bit we own.
IOA_MARK="0x1/0x1"
TS_MARK="0x80000/0xff0000"
CHAIN="NETMODE_IOA"

# --- Underlay -----------------------------------------------------------------
# Collected into one route table rather than one rule per address: the kernel
# walks the rule list linearly for every packet, and the ~90 DERP relays alone
# would make that walk an order of magnitude longer. A table costs one rule and
# an LPM lookup.
UNDERLAY_TABLE="500"
# Built here first, then swapped in. Never referenced by a rule.
UNDERLAY_STAGE="501"
# Tailscale's control plane. Anycast, stable, and needed before DNS works.
TS_CONTROL_NETS=("192.200.0.0/24" "199.165.136.0/24")
# SmartDNS's own upstreams. /etc/resolv.conf points at SmartDNS, so if these
# are reachable only through a tunnel then nothing can be resolved until the
# tunnel is up — including the names needed to bring it up.
DNS_UPSTREAMS=("8.8.8.8" "1.1.1.1" "114.114.114.114" "223.5.5.5")
# IOA's tunnel endpoints are found by resolving these; SmartDNS keeps them in
# its "china" group so they resolve without the tunnel.
IOA_BOOTSTRAP_HOSTS=(smartgate.oa.tencent.com sgw.woa.com ioa.tencent.com)
# DERP relays change over time, so they are read from the live daemon and
# cached; the cache is what makes them available while tailscaled is down.
CACHE_DIR="/var/lib/network-reconfigure"
DERP_CACHE="$CACHE_DIR/derp-ips"
# The IOA gateway addresses are cached for the same reason as the DERP list:
# resolving them needs SmartDNS, which is restarted by this very script, so a
# run that happens to land in that window would otherwise silently drop the
# routes that keep the IOA tunnel out of the tailscale exit node.
#
# One list, one file, used for both the route table and the ipset that exempts
# these addresses from marking. They were two lists once, resolved separately,
# and SmartDNS answers with whichever address measured fastest at that instant —
# so the set and the table disagreed, and an endpoint present in the set but
# absent from the table got routed into the very tunnel it builds.
IOA_ENDPOINT_CACHE="$CACHE_DIR/ioa-endpoints"
# Same addresses, held in an ipset so the mark chain can exempt them.
IOA_UNDERLAY_SET="ioa_underlay"

# --- Overlay ------------------------------------------------------------------
IOA_CIDRS=("9.0.0.0/8" "10.0.0.0/8")
IOA_EXCLUDE=("10.255.0.0/16")
TAILNET_NETS=("100.64.0.0/10")
# RFC1918 + link-local, minus 10/8: that range belongs to IOA, and the part of
# it that is the current LAN is already covered by the link-derived rules.
PRIVATE_NETS=("192.168.0.0/16" "172.16.0.0/12" "169.254.0.0/16")
CN_TABLE="cn"
ROUTEFILE="/home/amos/.routefile"
# Office LAN additions; sourced by smartdns.conf, emptied when not on the LAN.
OFFICE_SRC="/home/amos/git/serverconfig/network/smartdns/office.conf"
OFFICE_DST="/etc/smartdns/office.conf"

# Priorities, named so the bands above are visible at each call site.
P_IOA_UNDERLAY=490  # IOA's own escape, pinned (see below)
P_UNDERLAY=500      # tunnel infrastructure
P_LOCAL=1000        # directly-connected subnets
P_IOA_EXCLUDE=2000  # carved out of the IOA ranges
P_IOA=2500          # Tencent intranet
P_TAILNET=3000      # peer addresses
P_PRIVATE=3500      # private-range catch-all
P_CN=4000           # China direct
# 4500 is the escape band, owned by network-fallback (see that script).

# Anything that leaves the rule set weaker than intended goes to the journal:
# a degraded run looks identical to a good one from the outside.
warn() { logger -t network-reconfigure -p daemon.err "$*"; }

clean_pref() { while ip rule del pref "$1" 2>/dev/null; do :; done; }

# The gateway of the *physical* link, never a tunnel's.
#
# `ip route show default` is wrong here: bringing up an exit node replaces the
# default route, and for a moment there is none at all. A run triggered in that
# window — and `tailscale up` triggers one, because creating tailscale0 writes
# to /run/systemd/netif/links — would see no gateway and skip rebuilding the
# underlay table, which is precisely the table that keeps tailscale working.
# Tailscale keeps its own default in table 52, so table main still holds the
# physical one.
physical_gateway() {
    ip -4 route show table main default 2>/dev/null |
        awk '$5 ~ /^(wlan|wlp|enp|eth|eno|ens)/ {print $3; exit}'
}
physical_device() {
    ip -4 route show table main default 2>/dev/null |
        awk '$5 ~ /^(wlan|wlp|enp|eth|eno|ens)/ {print $5; exit}'
}

# Two shell traps meet in this script, and both look like ordinary idioms:
#
#   `grep -c` exits 1 when the count is zero, and an empty table is the normal
#   state on a cold boot — under `set -e` that kills the script mid-way, leaving
#   the rule set half-applied.
#
#   `grep -q` exits as soon as it matches, so the writer upstream takes SIGPIPE
#   and the pipeline reports 141 under `pipefail`. A *non-empty* table is then
#   read as empty, and the larger the table the more reliably it happens.
#
#   `ip route show table X` exits 2 when the table has never been created, which
#   is the state of every table on a cold boot. Redirecting stderr hides the
#   message but not the status, so `pipefail` still propagates it. That is what
#   killed this script at the first count on a freshly booted machine — after
#   the reset, before a single rule had been reinstalled.
#
# Both answers are counts, so absorb the status and count what came out.
count_routes() { { ip route show table "$1" 2>/dev/null || true; } | wc -l; }
count_rules()  { { ip -4 rule show pref "$1" 2>/dev/null || true; } | wc -l; }
has_routes()   { [ "$(count_routes "$1")" -gt 0 ]; }

# Is a wired interface carrying traffic? 802.1X against the corporate switch is
# what brings it up, so this is equivalent to "on the office LAN".
wired_up() {
    local dev
    for dev in /sys/class/net/enp*; do
        [ -e "$dev" ] || continue
        dev=${dev##*/}
        [ "$(cat "/sys/class/net/$dev/operstate" 2>/dev/null)" = up ] || continue
        [ -n "$(ip -4 -o addr show "$dev" scope global)" ] && return 0
    done
    return 1
}

# Named tables must exist before they can be referenced by name. Registering
# them here keeps the script self-contained: a fresh machine, or one whose
# rt_tables was replaced by a package update, converges without manual setup.
ensure_rt_table() {
    grep -qE "^[[:space:]]*$1[[:space:]]+$2\b" /etc/iproute2/rt_tables ||
        printf '%s %s\n' "$1" "$2" >> /etc/iproute2/rt_tables
}
ensure_rt_table "$UNDERLAY_TABLE" underlay
ensure_rt_table 101 cn
ensure_rt_table 400 ioa

# ==============================================================================
# Wait for the link before touching anything
# ==============================================================================
# Both waits are up to 10s, and they used to sit in the middle of the rebuild.
# That put a ten-second window after the reset in which no local, IOA, tailnet,
# private or CN rule existed while tailscale's catch-all at pref 5270 was still
# live — every LAN and private packet went into the exit node, and a failure
# during the sleep left the machine there. Nothing below needs the reset to have
# happened, so wait first and keep the destructive window to milliseconds.
for _ in {1..10}; do
    [ -n "$(ip route show table main scope link dev "$IFACE" 2>/dev/null)" ] && break
    sleep 1
done || true
for _ in {1..10}; do
    dns=$(networkctl dhcp-lease "$IFACE" 2>/dev/null |
              awk '/domain name server/ {print $NF}' || true)
    [ -n "${dns:-}" ] && break
    sleep 1
done || true

# ==============================================================================
# Reset everything this script owns
# ==============================================================================
# P_IOA_UNDERLAY is deliberately absent: it holds IOA's escape rule, which is
# re-pinned in place below. Clearing it here would delete the only copy before
# we could read it back.
for p in "$P_UNDERLAY" "$P_LOCAL" "$P_IOA_EXCLUDE" "$P_IOA" \
         "$P_TAILNET" "$P_PRIVATE" "$P_CN"; do
    clean_pref "$p"
done
# Priorities used by earlier versions of this script, including the escape rule
# back when it lived at 100; drop them so an upgrade in place cannot leave a
# stale rule behind. 4500 is owned by network-fallback and is restarted below,
# so it is left alone here.
for p in 100 900 1500; do clean_pref "$p"; done

iptables -t mangle -D OUTPUT -j "$CHAIN" 2>/dev/null || true
iptables -t mangle -F "$CHAIN" 2>/dev/null || true
iptables -t mangle -X "$CHAIN" 2>/dev/null || true
# Drop our SNAT rule whatever source it was created with: the tun0 address
# changes between IOA sessions, so deleting by exact spec is unreliable.
# Deleting by index, highest first, keeps the remaining indices valid.
while read -r n; do
    if [ -n "$n" ]; then iptables -t nat -D POSTROUTING "$n" 2>/dev/null || true; fi
done < <(iptables -t nat -L POSTROUTING --line-numbers -n |
             awk '/SNAT/ && /mark match 0x1/ {print $1}' | sort -rn)

# ==============================================================================
# 500 — underlay: never enters a tunnel
# ==============================================================================

# IOA installs its own escape rule (fwmark 0xa38 -> table 20) through the
# wrapper in scripts/overrides/ip, and does so without a priority — so the
# kernel derives one as (lowest existing priority - 1). That makes its position
# depend on our rule set: it lands just under whatever we install first, which
# is correct but only by accident. Pin it explicitly so the placement is ours.
#
# Keyed off the table rather than the existing rule: SmartGateAgent populates
# table 20 when the tunnel comes up and only re-adds the rule occasionally, so
# reading the rule back would lose it for however long that takes.
IOA_ESCAPE_MARK="0xa38"
IOA_ESCAPE_TABLE="20"
if has_routes "$IOA_ESCAPE_TABLE"; then
    while ip rule del fwmark "$IOA_ESCAPE_MARK" 2>/dev/null; do :; done
    ip rule add fwmark "$IOA_ESCAPE_MARK" lookup "$IOA_ESCAPE_TABLE" \
        pref "$P_IOA_UNDERLAY"
fi

# Whatever tailscale has already marked as its own. Tailscale installs this
# rule too, but at pref 5210 — behind every overlay rule below.
ip rule add fwmark "$TS_MARK" lookup main pref "$P_UNDERLAY"

# Both lists are cached. Neither source is reliable at the moment this runs:
# tailscaled may be down, and SmartDNS is restarted by this very script. A run
# that lands in either window must not be able to shrink the table.
mkdir -p "$CACHE_DIR"
# A regex cannot tell 999.1.1.1 from an address, so check the octets: anything
# that reaches the route table unvalidated makes `ip -batch` complain.
#
# The optional limit is applied inside the awk rather than by a trailing `head`,
# which would close the pipe early and SIGPIPE the writer — fatal under
# `pipefail`. Only the endpoint cache passes one; it accumulates across runs and
# needs a ceiling, while the DERP list is a full snapshot each time (~90 relays)
# and must not be truncated.
valid_ipv4() {
    awk -F. -v limit="${1:-0}" '
        (limit == 0 || n < limit) && NF == 4 && /^[0-9.]+$/ {
            for (i = 1; i <= 4; i++) if ($i > 255 || length($i) > 3) next
            n++; print
        }'
}

if derp=$(timeout 5 tailscale debug derp-map 2>/dev/null) && [ -n "$derp" ] &&
   ips=$(jq -r '.Regions[].Nodes[].IPv4 | select(. != null and . != "")' \
            <<<"$derp" 2>/dev/null) && [ -n "$ips" ]; then
    printf '%s\n' "$ips" | valid_ipv4 | sort -u > "$DERP_CACHE"
fi
# Unioned with the cache rather than replacing it: each answer is one of several
# valid endpoints, so replacing would drop the others and a later run that
# resolved differently would find them unprotected. They are a handful of stable
# public addresses, so the union stays small; cap it so a DNS oddity cannot grow
# the list without bound.
{
    for host in "${IOA_BOOTSTRAP_HOSTS[@]}"; do
        # `|| true`: dig exits 9 when no server replies, which is exactly the
        # case the cache below exists to cover.
        dig +short +timeout=2 +tries=1 "$host" @127.0.0.1 2>/dev/null || true
    done
    # `|| true`: on a cold boot the cache does not exist yet, and cat exits 1.
    cat "$IOA_ENDPOINT_CACHE" 2>/dev/null || true
} | sort -u | valid_ipv4 64 > "$IOA_ENDPOINT_CACHE.new"
if [ -s "$IOA_ENDPOINT_CACHE.new" ]; then
    mv "$IOA_ENDPOINT_CACHE.new" "$IOA_ENDPOINT_CACHE"
else
    rm -f "$IOA_ENDPOINT_CACHE.new"
    warn "no IOA endpoint addresses resolved or cached"
fi

underlay_gw=$(physical_gateway)
underlay_dev=$(physical_device)

# Build into a staging table, then swap. `ip -batch` aborts at the first bad
# line, so writing directly into the live table means one unresolvable address
# truncates everything after it — and since the table has to be flushed first,
# the result is worse than not running at all. That is how the underlay
# protection once vanished entirely, which deadlocks tailscaled: its own
# control-plane and DERP traffic gets routed into the tunnel it is building.
# Staging turns a partial failure into "keep what already worked".
if [ -n "${underlay_gw:-}" ]; then
    ip route flush table "$UNDERLAY_STAGE" 2>/dev/null || true
    {
        printf '%s\n' "${TS_CONTROL_NETS[@]}" "${DNS_UPSTREAMS[@]}"
        cat "$DERP_CACHE" "$IOA_ENDPOINT_CACHE" 2>/dev/null || true
    } | { grep -E '^[0-9]' || true; } | sort -u |
        while read -r dst; do
            echo "route add $dst via $underlay_gw dev $underlay_dev table $UNDERLAY_STAGE"
        done | ip -force -batch - 2>/dev/null || true

    # `grep -c` exits 1 when the count is zero, and an empty table is the
    # normal state on a cold boot — without the guard `set -e` kills the script
    # here and every overlay rule below silently goes missing.
    staged=$(count_routes "$UNDERLAY_STAGE")
    live=$(count_routes "$UNDERLAY_TABLE")
    # An empty live table is not a previous state worth keeping — it is the
    # absence of one. Treating it as something to protect turns a single failed
    # run into a permanent outage, since nothing else rebuilds the table.
    if [ "$live" -eq 0 ]; then live=-1; fi
    # Neither is a table built for a different network. Its routes are "via the
    # old gateway", so keeping it does not preserve protection, it installs a
    # black hole — and the guard below would then defend that black hole against
    # every correct rebuild that followed. The cn block says the same thing
    # about its own table. Size only decides between two tables that are both
    # reachable; identity decides whether the old one is a candidate at all.
    if [ "$live" -gt 0 ] &&
       [ -z "$({ ip route show table "$UNDERLAY_TABLE" 2>/dev/null || true; } |
                   awk -v gw="$underlay_gw" '$3 == gw {print; exit}')" ]; then
        live=-1
    fi
    # A shrinking table usually means a source was unavailable, not that the
    # network changed — but the DERP list churns by a route or two between runs,
    # and rejecting on any shrink froze the table permanently: a newly resolved
    # IOA endpoint could never get in, while the ipset that exempts it moved
    # ahead. Reject a collapse (a source went away), accept the churn.
    floor=$(( live * 3 / 4 ))
    if [ "$staged" -gt 0 ] && [ "$staged" -ge "$floor" ]; then
        ip route flush table "$UNDERLAY_TABLE" 2>/dev/null || true
        { ip route show table "$UNDERLAY_STAGE" 2>/dev/null || true; } |
            sed "s|\$| table $UNDERLAY_TABLE|; s|^|route add |" |
            ip -force -batch - 2>/dev/null || true
    else
        warn "underlay rebuild produced $staged routes against $live live; kept the old table"
    fi
    ip route flush table "$UNDERLAY_STAGE" 2>/dev/null || true
else
    warn "no default gateway; leaving the underlay table alone"
fi

# The rule is installed whenever the table has content, even if this run could
# not rebuild it — a momentarily missing default route must not strip the
# protection that is already in place.
if has_routes "$UNDERLAY_TABLE"; then
    ip rule add lookup "$UNDERLAY_TABLE" pref "$P_UNDERLAY"
else
    warn "underlay table is empty; not installing pref $P_UNDERLAY"
fi

# ==============================================================================
# 1000 — local: directly-connected subnets
# ==============================================================================
while read -r subnet _; do
    ip rule add to "$subnet" lookup main pref "$P_LOCAL"
done < <(ip route show table main scope link)

# ==============================================================================
# 2000/2500 — IOA
# ==============================================================================
for cidr in "${IOA_EXCLUDE[@]}"; do
    ip rule add to "$cidr" lookup main pref "$P_IOA_EXCLUDE"
done

tid=$(id -u tinyproxy 2>/dev/null || true)
if [ -n "$tid" ]; then
    ip rule add uidrange "$tid-$tid" lookup ioa pref "$P_IOA"
fi
ip rule add fwmark "$IOA_MARK" lookup ioa pref "$P_IOA"
for cidr in "${IOA_CIDRS[@]}"; do
    ip rule add to "$cidr" lookup ioa pref "$P_IOA"
done

# The IOA tunnel's own endpoints must never be marked: routing them into the
# tunnel they are building kills IOA, and DNS with it. SmartDNS cannot be
# relied on to keep them out of the `ioa` set — domain rules are suffix
# matches, so sgw.woa.com is caught by /woa.com/, and `-no-rule-ipset` does not
# stop the add (measured). So the exemption is enforced here instead, where it
# is authoritative.
# Populated from the underlay *table*, not from the cache that fed it. The table
# is what the kernel will actually do; the cache is only an intention. When the
# two differed — a freshly resolved endpoint in the cache, rejected by the
# staged-rebuild guard — the set exempted an address the table could not carry,
# and the packet went into the tunnel it was supposed to build. Deriving the set
# from the table makes that disagreement impossible to express.
#
# The table is read once into a variable, not grepped per address: `grep -q`
# exits early, the writer takes SIGPIPE, and under `pipefail` that is fatal.
ipset create "$IOA_UNDERLAY_SET" hash:ip family inet -exist
ipset flush "$IOA_UNDERLAY_SET"
underlay_routes=$(ip route show table "$UNDERLAY_TABLE" 2>/dev/null || true)
while read -r ip; do
    [ -n "$ip" ] || continue
    case $'\n'"$underlay_routes" in
        *$'\n'"$ip "*) ipset add "$IOA_UNDERLAY_SET" "$ip" -exist 2>/dev/null || true ;;
        *) warn "IOA endpoint $ip is not in the underlay table; not exempting it" ;;
    esac
done < <(cat "$IOA_ENDPOINT_CACHE" 2>/dev/null || true)

iptables -t mangle -N "$CHAIN" 2>/dev/null || iptables -t mangle -F "$CHAIN"
# Exemptions first: tunnel endpoints, then anything tailscale already claimed.
iptables -t mangle -A "$CHAIN" -m set --match-set "$IOA_UNDERLAY_SET" dst -j RETURN
iptables -t mangle -A "$CHAIN" -m mark --mark "$TS_MARK" -j RETURN
# SmartDNS owns the `ioa` set. On a cold boot this script can run before it has
# started, and referencing a set that does not exist makes iptables fail — which
# would abort the run with the reset already done. Create it empty instead;
# SmartDNS fills the same set in place once it is up.
ipset create ioa hash:ip family inet -exist
iptables -t mangle -A "$CHAIN" -m set --match-set ioa dst \
    -j MARK --set-xmark "$IOA_MARK"
iptables -t mangle -A OUTPUT -j "$CHAIN"

# connect() picks a route before mangle OUTPUT runs, so a socket to an
# ipset-matched address has already bound a source address from whichever table
# won at that moment — usually tailscale's. The mark then reroutes the packets
# out tun0 still carrying that source, and replies never come back. SNAT fixes
# the source on the way out.
if ip -4 addr show tun0 &>/dev/null; then
    tun_ip=$(ip -4 -o addr show tun0 | awk -F'[ /]+' '{print $4; exit}')
    if [ -n "${tun_ip:-}" ]; then
        iptables -t nat -A POSTROUTING \
            -m mark --mark "$IOA_MARK" -o tun0 -j SNAT --to-source "$tun_ip"
    fi
fi

# ==============================================================================
# 3000/3500 — tailnet peers, then private ranges
# ==============================================================================
for net in "${TAILNET_NETS[@]}"; do
    ip rule add to "$net" lookup 52 pref "$P_TAILNET"
done

# The link-derived rules above are a snapshot, so a docker network or VM bridge
# created later has no rule of its own and would fall through to the exit node.
# https://github.com/tailscale/tailscale/issues/3646
for cidr in "${PRIVATE_NETS[@]}"; do
    ip rule add to "$cidr" lookup main pref "$P_PRIVATE"
done

# ==============================================================================
# 4000 — China direct
# ==============================================================================
if [ ! -f "$ROUTEFILE" ]; then
    warn "no $ROUTEFILE; China traffic will use the exit node"
else
    gw=$(physical_gateway)
    if [ -z "${gw:-}" ]; then
        warn "no default gateway; leaving the cn table alone"
    else
        # Rebuilt unconditionally: the routes are "via $gw", so a table left
        # over from the previous network is worse than no table at all. ~8600
        # routes take about 150ms as one batch. -force keeps a single rejected
        # route from truncating the rest, and the rule is only installed if
        # something actually landed.
        ip route flush table "$CN_TABLE" 2>/dev/null || true
        sed "s/GATEWAY/$gw/" "$ROUTEFILE" | ip -force -batch - 2>/dev/null || true
        if has_routes "$CN_TABLE"; then
            ip rule add table "$CN_TABLE" pref "$P_CN"
        else
            warn "cn table is empty; not installing pref $P_CN"
        fi
    fi
fi

# ==============================================================================
# Services
# ==============================================================================
tailscale status &>/dev/null &&
    tailscale set --exit-node-allow-lan-access=true 2>/dev/null || true

if [ -n "${dns:-}" ]; then
    printf '# DHCP DNS from %s\n' "$IFACE" > /etc/smartdns/dhcp-dns.conf
    printf 'server %s\n' $dns >> /etc/smartdns/dhcp-dns.conf
else
    echo "# No DHCP DNS" > /etc/smartdns/dhcp-dns.conf
fi

# Office LAN additions. The wired link is the office by definition — it only
# comes up after 802.1X against the corporate switch — so no other signal is
# needed. Everything in that file resolves only on the LAN, which is why it is
# emptied rather than left stale when the cable is out.
#
# `|| warn`: OFFICE_SRC lives in the git worktree, which is not a dependency of
# this unit — on a boot where /home is not mounted yet it is simply absent, and
# that must not stop the run before smartdns is restarted below.
if wired_up; then
    cp "$OFFICE_SRC" "$OFFICE_DST" 2>/dev/null ||
        warn "cannot read $OFFICE_SRC; leaving $OFFICE_DST as it is"
else
    echo "# Not on the office LAN" > "$OFFICE_DST"
fi

systemctl restart smartdns 2>/dev/null || true

# Re-evaluate the exit-node bypass: joining a captive-portal network may
# produce no tailscale event at all, leaving that daemon blocked.
systemctl restart --no-block network-fallback.service 2>/dev/null || true

# ==============================================================================
# Verify the one invariant that has ever taken the machine offline
# ==============================================================================
# If an IOA tunnel endpoint routes *into* the IOA tunnel, the tunnel cannot come
# up, DNS goes with it, and nothing left running can repair it. Every outage
# during development was this, and the recovery was always removing the mangle
# jump by hand. Ask the kernel directly — `route get ... mark 1` is the same
# lookup a marked packet gets — and if the answer is wrong, remove the jump
# ourselves. Marking is an optimisation; being reachable is not.
#
# Read from the cache, not from the ipset. The set holds only the endpoints that
# were proven to be in the underlay table, so iterating it can only ever confirm
# what is already known good. The dangerous ones are exactly the ones the set
# left out: unexempted, so SmartDNS's `ioa` set marks them into the tunnel.
bad_endpoint=""
while read -r ip; do
    [ -n "$ip" ] || continue
    case "$({ ip route get "$ip" mark 1 2>/dev/null || true; } | head -1)" in
        *"dev tun0"*) bad_endpoint="$ip" ;;
    esac
done < <(cat "$IOA_ENDPOINT_CACHE" 2>/dev/null || true)

if [ -n "$bad_endpoint" ]; then
    warn "IOA endpoint $bad_endpoint still routes into tun0; removing the mangle jump"
    iptables -t mangle -D OUTPUT -j "$CHAIN" 2>/dev/null || true
fi

# The symmetric failure was never checked, and it is the worse of the two: a
# DERP relay or the control plane routed into tailscale0 deadlocks tailscaled
# and takes DNS with it. Reachable whenever the underlay rule is missing while
# tailscale's own catch-all at pref 5270 is live. Same question to the kernel.
ts_probe=$({ cat "$DERP_CACHE" 2>/dev/null || true; } | valid_ipv4 1)
if [ -n "${ts_probe:-}" ]; then
    case "$({ ip route get "$ts_probe" 2>/dev/null || true; } | head -1)" in
        *"dev tailscale0"*)
            warn "underlay address $ts_probe routes into tailscale0; dropping pref 5270"
            # Tailscale reinstalls this rule on its next reconfiguration, so
            # removing it is a stopgap that unblocks the daemon, not a change.
            while ip rule del pref 5270 2>/dev/null; do :; done
            ;;
    esac
fi

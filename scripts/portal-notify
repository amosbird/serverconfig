#!/usr/bin/env bash
# portal-notify — tell the desktop that this network wants a login, and offer to open it.
#
#     portal-notify            notify about the portal recorded for this link, if any
#     portal-notify --force    notify even when the link already looks authenticated
#
# `network-reconfigure` runs as root and writes the portal URL it discovered, but root cannot reach a
# user's dunst: the session bus authenticates by uid, so a root process that connects to
# `/run/user/1000/bus` is refused. Dropping to the session owner first works, and this script is how
# that is expressed in one place.
#
# The notification waits for a click and then opens the page. `dunstify -w -A` is what makes the click
# meaningful: the process blocks until the notification is acted on, dismissed, or times out, and
# prints which happened. The caller must therefore run this in the background — see the call at the
# end of network-reconfigure, and the timeout that bounds it.
#
# Why a click rather than opening it outright: a captive portal is not always a problem. The exit node
# may already carry traffic, and being handed a login page while you are working is the interruption
# this avoids. The notification states the situation; the click is the consent.

set -uo pipefail

PORTAL_URL_STATE=${PORTAL_URL_STATE_OVERRIDE:-/run/network-reconfigure/captive-portal-url}
PORTAL_IDENTITY_STATE=${PORTAL_IDENTITY_STATE_OVERRIDE:-$(dirname "$PORTAL_URL_STATE")/captive-portal-identity}
PORTAL_DISMISS_STATE=${PORTAL_DISMISS_STATE_OVERRIDE:-$(dirname "$PORTAL_URL_STATE")/captive-portal-dismissed}
OPEN=${OPEN:-/home/amos/scripts/xdg-open}
NOTIFY=${NOTIFY:-/usr/sbin/dunstify}
DUNSTCTL=${DUNSTCTL:-dunstctl}
PORTAL_LOGIN=${PORTAL_LOGIN:-/home/amos/scripts/portal-login}
RECONFIGURE=${RECONFIGURE:-/home/amos/scripts/network-reconfigure}
TIMEOUT_MS=${PORTAL_NOTIFY_TIMEOUT_MS:-120000}
RECHECK_INTERVAL=${PORTAL_RECHECK_INTERVAL:-3}
APPNAME=${PORTAL_NOTIFY_APPNAME:-portal}
# Same id network-reconfigure closes when the link is released.
PORTAL_NOTIFY_ID=99114

# The session to notify. Read from the state file's owner rather than assumed, because the repository
# has no business hard-coding a uid.
session_uid() {
    local uid
    uid=$(stat -c %u "$PORTAL_URL_STATE" 2>/dev/null) || true
    if [ -z "$uid" ] || [ "$uid" = 0 ]; then
        # The file is root-owned: fall back to the first human session that has a bus.
        uid=$(for bus in /run/user/*/bus; do
            [ -S "$bus" ] || continue
            printf '%s\n' "$(basename "$(dirname "$bus")")"
            break
        done)
    fi
    printf '%s\n' "${uid:-}"
}

recorded_url() {
    [ -r "$PORTAL_URL_STATE" ] || return 0
    head -1 "$PORTAL_URL_STATE" 2>/dev/null
}

# Reach the user's notification daemon with the session's own credentials.
notify_as_session() {
    local uid=$1 label=$2 body=$3
    [ -n "$uid" ] || return 1
    # One action, not two. `dunstctl action` invokes the notification's *default* action, and with two
    # registered it resolves to neither and only closes the notification — measured on dunst 1.13.2,
    # where a single-action notification returns `open` and a two-action one returns nothing. The
    # alternative is a per-rule `action_name` in dunstrc, which would tie this script to a config file
    # it does not own.
    setpriv --reuid="$uid" --regid="$uid" --init-groups \
        env "XDG_RUNTIME_DIR=/run/user/$uid" \
            "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus" \
        "$NOTIFY" -w -t "$TIMEOUT_MS" -r "$PORTAL_NOTIFY_ID" -a "$APPNAME" \
            -A 'open,Open the portal' \
            "$label" "$body"
}

# A real dunst waits here, so the probe can be repeated while the notice is up. The fixture's
# notifier returns immediately and must not start that loop.
recheck_wanted() {
    [ "${PORTAL_RECHECK:-}" = 1 ] && return 0
    [ "${PORTAL_RECHECK:-}" = 0 ] && return 1
    [ "$NOTIFY" = /usr/sbin/dunstify ]
}

# Remember that this association was dismissed or left to expire. The next reconciliation of the
# same association stays quiet. A different association, or one that was open in between, has no
# such file.
note_dismissed() {
    local id
    id=$(head -1 "$PORTAL_IDENTITY_STATE" 2>/dev/null || true)
    [ -n "$id" ] || return 0
    printf '%s\n' "$id" >"$PORTAL_DISMISS_STATE" 2>/dev/null || true
}

# While the notice is up, ask the link again. One confirmed open is handed to the reconciler; if
# it agrees, the notice is withdrawn and this was not a dismissal. If it still calls the link
# captive, stop polling and let the click decide — disagreeing every few seconds would rerun
# reconciliation for as long as the notice lived.
watch_until_decided() {
    local uid=$1 pid=$2 action_file=$3 verdict
    while kill -0 "$pid" 2>/dev/null; do
        verdict=$("$PORTAL_LOGIN" --verdict 2>/dev/null || true)
        if [ "$verdict" = open ]; then
            "$RECONFIGURE" >/dev/null 2>&1 || true
            if [ ! -s "$PORTAL_URL_STATE" ]; then
                "$DUNSTCTL" close "$PORTAL_NOTIFY_ID" >/dev/null 2>&1 || true
                wait "$pid" 2>/dev/null || true
                return 0
            fi
            break
        fi
        sleep "$RECHECK_INTERVAL"
    done
    wait "$pid" 2>/dev/null || true
    act_on "$(head -1 "$action_file" 2>/dev/null || true)" "$uid"
}

act_on() {
    local action=$1 uid=$2 url
    # Dismissing or letting it time out is a decision, not a failure. Recording it is what stops
    # the next roam of this same association from raising the notice again.
    [ "$action" = open ] || { note_dismissed; return 0; }
    # Read at click time. The reconciler may have replaced the token while this notice was up.
    url=$(recorded_url)
    [ -n "$url" ] || return 0
    # The URL is opened as the session user: a browser started by root lands in the wrong session,
    # and `HOME` matters as much as the display does — without it xdg-open tries to write its MIME
    # cache under `/root` and fails before reaching the browser at all.
    setpriv --reuid="$uid" --regid="$uid" --init-groups \
        env "HOME=$(getent passwd "$uid" | cut -d: -f6)" \
            "XDG_RUNTIME_DIR=/run/user/$uid" \
            "DISPLAY=${DISPLAY:-:0}" \
        "$OPEN" "$url" >/dev/null 2>&1 || true
}

main() {
    local url uid action action_file pid
    url=$(recorded_url)
    if [ -z "$url" ]; then
        [ "${1:-}" = --force ] || return 0
        url=$("$PORTAL_LOGIN" --print 2>/dev/null) || return 0
        [ -n "$url" ] || return 0
    fi
    [ -x "$NOTIFY" ] || return 0
    uid=$(session_uid)
    [ -n "$uid" ] || return 0

    if recheck_wanted; then
        action_file=$(mktemp "${TMPDIR:-/tmp}/portal-action.XXXXXX")
        notify_as_session "$uid" \
            'Wi-Fi needs a login' \
            'This network is captive. Click to open the portal page.' \
            >"$action_file" &
        pid=$!
        watch_until_decided "$uid" "$pid" "$action_file"
        rm -f "$action_file"
        return 0
    fi

    action=$(notify_as_session "$uid" \
        'Wi-Fi needs a login' \
        'This network is captive. Click to open the portal page.') || return 0
    act_on "$action" "$uid"
}

main "$@"

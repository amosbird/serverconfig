#!/usr/bin/env bash
# network-fallback — keep the exit node attached only while it can carry traffic
#
# A selected exit node installs `default dev tailscale0` in table 52, so every
# default-routed packet depends on that tunnel working. When it cannot carry
# traffic the route is a black hole and the machine is simply offline. The
# causes vary — captive portal, UDP blocked, DERP unreachable, exit node down —
# but the response is the same, so this daemon reconciles one bit of state:
#
#     exit node usable    -> attached
#     exit node unusable  -> detached, and re-attached when it recovers
#
#
# ## Why it detaches instead of routing around
#
# The previous design added `ip rule pref 4500 lookup main` to divert traffic
# past the tunnel. Measured: the rule went in and the machine stayed offline for
# 45 seconds, until the exit node was removed by hand.
#
# A routing rule only affects a route *lookup*, and a socket looks up once. With
# an exit node attached the lookup returns `dev tailscale0 src 100.88.203.53`,
# so every established connection has already bound the tailscale address.
# Adding the rule sends those packets out the physical link still carrying a
# source address that only exists inside the tunnel; replies cannot come back.
# New connections would be fine, but the application is retrying the ones it
# already has — which is precisely the traffic the rule cannot help.
#
# Detaching the exit node is what actually works, because tailscaled then
# withdraws the table 52 default itself and every socket renegotiates against
# the physical link. That is also what a human does to recover, every time.
#
#
# ## The judgement is a pure function of external state
#
# It never reads its own output. An earlier version consulted the bypass rule it
# had installed (to stop DHCP option 114, which persists after login, from
# pinning the bypass on forever) and self-oscillated at ~1Hz: bypass on -> skip
# the portal check -> tailscale looks healthy -> bypass off -> portal detected
# again. Any judgement that depends on its own effect does this.
#
# Wakeups come from `tailscale debug watch-ipn` and from a timer. The timer
# matters because joining a portal network may produce no tailscale event at
# all, and because a detached exit node produces no events either.

set -euo pipefail

# Which exit node we detached, so it can be put back. Written only when this
# daemon detaches one: if the user turns the exit node off, there is no file and
# nothing to restore. That distinction is the whole reason for the file.
STATE_DIR=/var/lib/network-fallback
DETACHED_FILE="$STATE_DIR/detached-exit-node"

# Pinned to an address: this daemon runs when the exit path is a black hole, and
# on such a network DNS is usually the first casualty. A probe that has to
# resolve a name would fail for a reason unrelated to the exit node, or block
# behind the dying resolver, exactly when its answer matters most.
PROBE_HOST=connectivitycheck.gstatic.com
PROBE_IP=216.239.32.117
PROBE_URL="http://$PROBE_HOST/generate_204"

# The unusable state is abnormal and self-clearing depends on noticing recovery,
# so it is re-checked often; the healthy state only needs to catch a change made
# behind the daemon's back, so it idles slowly.
RECHECK_SECS=20
IDLE_SECS=120

log()   { logger -t network-fallback "$*"; }
trace() { logger -t network-fallback -p daemon.debug "trace: $*"; }

as_user() {
    sudo -u amos DISPLAY=:0 \
        DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus "$@" 2>/dev/null || true
}
notify() { log "$1: $2"; as_user notify-send -a "Network" "$1" "$2"; }

ts() { timeout 10 tailscale "$@" 2>/dev/null; }

# --- captive portal ----------------------------------------------------------
# RFC 8908: DHCP option 114 names an API that answers "am I captive?" on its own.
# That self-contained answer is what keeps the judgement from oscillating.
CAPPORT_URL="" CAPPORT_BODY=""
capport_probe() {
    CAPPORT_URL="" CAPPORT_BODY=""
    local iface
    iface=$(ip -4 route show default | awk '{print $5; exit}')
    [ -n "$iface" ] || return 0
    # networkctl exits non-zero on options it cannot parse; ignore it.
    CAPPORT_URL=$({ networkctl dhcp-lease "$iface" 2>/dev/null || true; } |
        awk 'tolower($0) ~ /captive portal/ {print $NF; exit}')
    [ -n "$CAPPORT_URL" ] || return 0
    CAPPORT_BODY=$(curl -s -m 5 -H "Accept: application/captive+json" \
                        "$CAPPORT_URL" 2>/dev/null || true)
    jq -e 'has("captive")' <<<"$CAPPORT_BODY" >/dev/null 2>&1 || CAPPORT_BODY=""
    return 0
}

portal_intercepting() {
    [ -n "$CAPPORT_URL" ] || return 1
    if [ -n "$CAPPORT_BODY" ]; then
        trace "capport $CAPPORT_URL -> $(jq -c . <<<"$CAPPORT_BODY")"
        jq -e '.captive' <<<"$CAPPORT_BODY" >/dev/null 2>&1
        return
    fi
    # No usable capport API. Interception has a positive signature: the probe is
    # answered by something that is not the real endpoint. A failed request is
    # NOT that signature — it means the network is down, which is a different
    # problem and must not be reported as a portal.
    local out code final
    out=$(curl -sL -o /dev/null -m 5 -w '%{http_code} %{url_effective}' \
              --resolve "$PROBE_HOST:80:$PROBE_IP" "$PROBE_URL" 2>/dev/null || true)
    code=${out%% *}; final=${out#* }
    case "$code" in
        000|"") return 1 ;;
        204)    [ "$final" != "$PROBE_URL" ] ;;
        *)      return 0 ;;
    esac
}

open_portal() {
    local page="${CAPPORT_URL:-}"
    [ -n "$CAPPORT_BODY" ] &&
        page=$(jq -r '."user-portal-url" // empty' <<<"$CAPPORT_BODY" 2>/dev/null)
    [ -n "$page" ] || return 0
    notify "Captive portal" "Opening $page"
    as_user xdg-open "$page"
}

# --- the two questions -------------------------------------------------------

# Attached: does traffic actually reach the internet through the tunnel?
#
# Bound to tailscale0 on purpose. Without it the probe follows whatever the rule
# set currently says, so the answer would move when this daemon acts on it.
# Two attempts, because one probe across a tunnel that is mid-handshake is a
# coin flip and this decides whether to tear the exit node down.
exit_node_carries_traffic() {
    local i
    ip link show tailscale0 >/dev/null 2>&1 || return 1
    for i in 1 2; do
        curl -s -o /dev/null -m 8 --interface tailscale0 \
             --resolve "$PROBE_HOST:80:$PROBE_IP" "$PROBE_URL" 2>/dev/null &&
            return 0
        sleep 2
    done
    return 1
}

# Detached: would it work if we put it back?
#
# The exit node cannot be tested by using it, so test the transport instead.
# `tailscale ping` reports the path: "via 1.2.3.4:41641" for a direct
# connection, "via DERP(sin)" for a relay. Only a direct path is evidence of
# recovery — on the networks where this daemon has any work to do, DERP is
# precisely what is blocked, and a relayed pong would send us straight back into
# the black hole we just escaped.
exit_node_reachable_directly() {
    local addr out
    addr=$(peer_addr "$1") || return 1
    out=$(timeout 15 tailscale ping -c 3 --until-direct=false "$addr" 2>/dev/null || true)
    trace "reachability probe: ${out//$'\n'/ | }"
    grep -q 'via [0-9]' <<<"$out"
}

# The file holds a node ID, because that is what tailscale reports as the
# configured exit node and it is the one name that does not change under the
# user. `--exit-node`, however, takes only an IP or a hostname:
#
#     $ tailscale set --exit-node=nXPA5k1Aw811CNTRL
#     invalid value "nXPA5k1Aw811CNTRL" for --exit-node; must be IP or hostname
#
# So the ID is resolved to the peer's tailnet address at the moment it is used.
# Detaching passes an empty string and never hit this, which is why re-attaching
# could fail on every single attempt without the detach path ever complaining:
# observed three consecutive direct pongs at 20ms and no re-attach, twice.
peer_addr() {
    local addr
    addr=$(ts status --json | jq -r --arg id "$1" \
              '.Peer[] | select(.ID == $id) | .TailscaleIPs[0] // empty' | head -1)
    [ -n "$addr" ] || { trace "no tailnet address for exit node $1"; return 1; }
    printf '%s' "$addr"
}

# --- reconcile ---------------------------------------------------------------
reconcile() {
    local status backend configured detached

    status=$(ts status --json) || return 0
    backend=$(jq -r '.BackendState // ""' <<<"$status")
    # ExitNodeStatus stays populated while the backend is Stopped — it reports
    # the *configured* node, not a live one — so the backend has to be checked
    # separately or this daemon acts on a tunnel that is not even running.
    [ "$backend" = Running ] || return 0

    configured=$(jq -r '.ExitNodeStatus.ID // ""' <<<"$status")
    detached=$(cat "$DETACHED_FILE" 2>/dev/null || true)

    if [ -n "$configured" ]; then
        capport_probe
        if portal_intercepting; then
            detach "$configured" "captive portal"
            open_portal
            return 0
        fi
        if ! jq -e '.ExitNodeStatus.Online' <<<"$status" >/dev/null 2>&1; then
            detach "$configured" "exit node is offline"
            return 0
        fi
        if ! exit_node_carries_traffic; then
            detach "$configured" "no traffic through the exit node"
            return 0
        fi
        # Healthy. Forget any previous detachment so a later manual change is
        # not undone by this daemon.
        rm -f "$DETACHED_FILE"
        return 0
    fi

    # Nothing configured. Only our own detachment is ours to undo.
    [ -n "$detached" ] || return 0
    if exit_node_reachable_directly "$detached"; then
        local addr
        addr=$(peer_addr "$detached") || return 0
        # Logged on failure. Silence here is what hid the ID-vs-address bug:
        # the only evidence was a re-attach that never happened.
        if ts set --exit-node="$addr" --exit-node-allow-lan-access; then
            rm -f "$DETACHED_FILE"
            notify "Exit node restored" "Direct path available again"
        else
            log "failed to re-attach exit node $detached ($addr); still detached"
        fi
    fi
    return 0
}

detach() {
    local id="$1" reason="$2"
    mkdir -p "$STATE_DIR"
    printf '%s' "$id" > "$DETACHED_FILE"
    if ts set --exit-node=; then
        notify "Exit node unusable" "Detached — $reason"
    else
        log "failed to detach the exit node ($reason); still offline"
    fi
    trace_dns
}

# The machine is unreachable while this is happening, so the journal is the only
# evidence available afterwards. Answers "was DNS hijacked, or did SmartDNS
# serve a stale entry?": a hijack returns the gateway's own address, a stale
# entry a plausible address with a decayed TTL.
trace_dns() {
    local domain=$PROBE_HOST dhcp local_ans ttl dhcp_ans
    dhcp=$(awk '/^server / {print $2; exit}' /etc/smartdns/dhcp-dns.conf 2>/dev/null || true)
    # Each dig gets `|| true`: it exits 9 when no server answers, and under
    # `pipefail` that would kill the daemon at the one moment its diagnostics
    # are worth having.
    local_ans=$({ dig +short +timeout=2 +tries=1 "$domain" @127.0.0.1 2>/dev/null || true; } |
                    tr '\n' ',')
    ttl=$({ dig +noall +answer +timeout=2 +tries=1 "$domain" @127.0.0.1 2>/dev/null || true; } |
              awk '$4 == "A" {print $2; exit}')
    if [ -n "$dhcp" ]; then
        dhcp_ans=$({ dig +short +timeout=2 +tries=1 "$domain" @"$dhcp" 2>/dev/null || true; } |
                       tr '\n' ',')
    fi
    trace "dns smartdns=[${local_ans:-none}] ttl=${ttl:-?} dhcp(${dhcp:-none})=[${dhcp_ans:-none}]" \
          "$([ "${local_ans:-}" = "${dhcp_ans:-}" ] && echo same || echo DIFFER)"
}

# --- main loop ---------------------------------------------------------------

# `read` fails for two very different reasons and the loop must tell them apart:
# >128 is the timeout (keep going), anything else is EOF on the watch stream —
# tailscaled restarted, or the subcommand is gone. Treating EOF as a timeout
# spins this loop at full speed forever, because `read` then returns instantly
# every time: measured at 375,793 iterations in five seconds, each forking
# tailscale, jq and curl. Exit instead and let systemd's Restart= reconnect.
eof_or_timeout() {
    [ "$1" -gt 128 ] && return 0
    trace "watch stream closed; exiting so systemd reconnects"
    exit 0
}

detached_now() { [ -s "$DETACHED_FILE" ]; }

reconcile || true
while :; do
    # Never block indefinitely. A detached exit node produces no tailscale
    # events at all, so nothing would ever wake us to notice it recovered.
    if detached_now; then
        read -r -t "$RECHECK_SECS" _ || eof_or_timeout $?
    else
        read -r -t "$IDLE_SECS" _ || { eof_or_timeout $?; reconcile || true; continue; }
    fi

    # Debounce: the stream is chatty while the network is active (engine stats,
    # not just state changes), and each reconcile forks tailscale and jq.
    while IFS= read -r -t 0.5 _; do :; done
    reconcile || true
done < <(tailscale debug watch-ipn --netmap=false 2>/dev/null)

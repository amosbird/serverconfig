{
    "manifest_version": 3,
    "name": "External Links",
    "version": "3.0",
    "description": "Open external links from isolated web apps in the main Chromium profile.",
    "key": "",
    "permissions": [
        "nativeMessaging",
        "notifications",
        "tabs",
        "declarativeNetRequest"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "commands": {
        "scrollToTop": {
            "suggested_key": {
                "default": "Alt+Shift+Home"
            },
            "description": "Scroll the current page to the beginning"
        },
        "scrollToBottom": {
            "suggested_key": {
                "default": "Alt+Shift+End"
            },
            "description": "Scroll the current page to the end"
        }
    },
    "content_scripts": [
        {
            "matches": ["http://*/*", "https://*/*"],
            "js": ["routes.js", "content.js"],
            "run_at": "document_start"
        }
    ]
}

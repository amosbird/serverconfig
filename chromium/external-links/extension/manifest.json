{
    "manifest_version": 3,
    "name": "External Links",
    "version": "3.0",
    "description": "Open external links from isolated web apps in the main Chromium profile.",
    "key": "",
    "permissions": [
        "clipboardWrite",
        "downloads",
        "nativeMessaging",
        "notifications",
        "offscreen",
        "tabs"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["http://*/*", "https://*/*"],
            "js": ["routes.js", "content.js"],
            "run_at": "document_start"
        }
    ]
}

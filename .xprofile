#!/bin/bash

# shellcheck source=/dev/null
source "$HOME/.config/environment.sh"
# override for GUI env
export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/gcr/ssh"

export GUI=t
export XAPIAN_CJK_NGRAM=1
export XIM=fcitx
export XIM_PROGRAM=fcitx
export XMODIFIERS=@im=fcitx
export GTK_IM_MODULE=fcitx
export QT_IM_MODULE=fcitx
export SDL_IM_MODULE=fcitx
export INPUT_METHOD=fcitx
export GLFW_IM_MODULE=fcitx5
export QT_QPA_PLATFORMTHEME=xdgdesktopportal
export GTK_USE_PORTAL=1
export AWT_TOOLKIT=XToolkit
export _JAVA_AWT_WM_NONREPARENTING=1
export AMPLXE_RUNTOOL_OPTIONS=--no-altstack
export QT_AUTO_SCREEN_SCALE_FACTOR=1
export XCURSOR_THEME=capitaine-cursors
export XCURSOR_SIZE=48
export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=qtile

if grep -qw 'gpu=nvidia' /proc/cmdline; then
    export LIBVA_DRIVER_NAME=nvidia
    export GST_VAAPI_ALL_DRIVERS=1
fi

_envs=(
    DISPLAY XAUTHORITY XDG_SESSION_TYPE XDG_SESSION_ID XDG_SEAT XDG_VTNR
    GDK_SCALE GDK_DPI_SCALE
    XCURSOR_THEME XCURSOR_SIZE
    XMODIFIERS QT_IM_MODULE GTK_IM_MODULE SDL_IM_MODULE GLFW_IM_MODULE
    LIBVA_DRIVER_NAME GST_VAAPI_ALL_DRIVERS
    QT_QPA_PLATFORMTHEME GTK_USE_PORTAL XDG_CURRENT_DESKTOP
)
dbus-update-activation-environment --systemd "${_envs[@]}"

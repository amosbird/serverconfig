# Managed instance of the iOA GUI, at the vendor's own ExecStart.
#
# The iOA daemon has no desktop entry to launch on Arch, so it falls back to
# `su -l amos -c 'XDG_RUNTIME_DIR=... systemctl --user restart ioagui.service'`
# (logged as "not found desktop" / "try exec gui" in /data/iOALog/client.log).
# That fallback is the whole Arch adaptation, and it only works if this unit
# exists. The qtile scratchpad hotkey starts the same unit, so there is always
# exactly one GUI, owned by systemd.
[Unit]
Description=iOA zero-trust client GUI

[Service]
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
# Starting the vendor GUI without the system daemon makes it invoke /usr/lib/iOA/bin/iOA itself.
# That entrypoint owns root-only network reconciliation and must only run through
# ngnclient.service. Exit status 1 from ExecCondition skips the GUI without marking this unit failed
# or entering its Restart=always loop; the daemon starts/restarts the GUI after it is ready.
ExecCondition=/usr/bin/systemctl is-active --quiet ngnclient.service
ExecStart=/usr/lib/iOA/bin/iOALinux
Restart=always
RestartSec=10

#!/usr/bin/env bash
# resolv-pin — make /etc/resolv.conf point at the local SmartDNS and keep it there.
#
# SmartGateAgent tries to replace /etc/resolv.conf with its own tunnel resolver
# (`Setting system DNS servers: [192.168.255.10 114.114.114.114]`, by renaming the file aside first).
# If that succeeds, every DNS query on the host bypasses SmartDNS, and the classification that
# routes intranet names through the tunnel and everything else directly is gone. The immutable flag
# makes its rename fail with EPERM, which it logs and tolerates; nothing else here writes the file.
#
# Usage: resolv-pin [--check]   # --check: report only, exit 1 if the pin is missing or wrong
set -euo pipefail

TARGET=${RESOLV_PIN_TARGET:-/etc/resolv.conf}
WANT=${RESOLV_PIN_CONTENT:-nameserver 127.0.0.1}
CHATTR=${CHATTR:-chattr}
LSATTR=${LSATTR:-lsattr}

pinned() { "$LSATTR" -d "$TARGET" 2>/dev/null | awk '{print $1}' | grep -q i; }
# A symlink is never a pin: SmartGateAgent renames the link itself, whatever it points at.
correct() { [ ! -L "$TARGET" ] && [ -f "$TARGET" ] && [ "$(cat "$TARGET")" = "$WANT" ]; }

if [ "${1:-}" = --check ]; then
    ok=0
    correct || { echo "resolv-pin: $TARGET is not exactly '$WANT'"; ok=1; }
    pinned || { echo "resolv-pin: $TARGET is not immutable"; ok=1; }
    [ "$ok" -ne 0 ] || echo "resolv-pin: $TARGET is pinned to '$WANT'"
    exit "$ok"
fi

if correct && pinned; then
    exit 0
fi
# A symlink (systemd-resolved's stub) or stale content is replaced; the flag has to come off first.
if [ -e "$TARGET" ] && ! [ -L "$TARGET" ]; then
    "$CHATTR" -i "$TARGET"
fi
tmp=$(mktemp "${TARGET%/*}/.resolv-pin.XXXXXX")
printf '%s\n' "$WANT" >"$tmp"
chmod 644 "$tmp"
mv -f "$tmp" "$TARGET"
"$CHATTR" +i "$TARGET"
echo "resolv-pin: pinned $TARGET to '$WANT'"

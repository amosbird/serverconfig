# The registered Tencent office adapter, matched on its permanent hardware address so the profile
# follows the dongle into any USB port. This link reaches the intranet but not the internet: on
# 2026-09-20 a public probe through its gateway failed while the same probe over Wi-Fi returned 204.
# So it must never supply main's default route — at metric 100 it would outrank Wi-Fi and blackhole
# everything. scripts/network-reconfigure advertises its gateway in table 19 instead, which is where
# SmartGateAgent's underlay reads it from. Every other Ethernet device falls through to
# 21-wired.network and gets an ordinary DHCP configuration.
#
# wpa_supplicant handles the 802.1X EAP-TLS session; networkd handles DHCP after carrier up.
[Match]
Type=ether
PermanentMACAddress=00:0e:c6:5d:e7:88

[Network]
DHCP=yes
DNS=127.0.0.1
DNSDefaultRoute=false

[DHCPv4]
UseDNS=false
UseNTP=false
UseGateway=false
UseRoutes=false
RouteMetric=100
SendHostname=false

[IPv6AcceptRA]
UseDNS=false

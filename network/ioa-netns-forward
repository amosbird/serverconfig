#!/usr/bin/env python3
"""ioa-netns-forward — expose iOA's loopback listeners on the host's loopback.

iOA's local proxy (SmartGateAgent, 127.0.0.1:12639 and friends) and its GUI channel (iOA.bin,
127.0.0.1:56100/56101) live on the loopback of netns `ioa`, which the host cannot reach. This binds
the same host addresses first, then switches its own network namespace to `ioa`: listening sockets
stay in the namespace they were created in, and every upstream connection it opens afterwards is
made inside `ioa`. Host clients (corkscrew, browsers, the PAC file) keep using the same addresses.

Usage: ioa-netns-forward [--netns PATH] HOST:PORT [HOST:PORT ...]
"""

import argparse
import os
import selectors
import socket
import sys
import threading

CHUNK = 1 << 16


def parse_endpoint(value):
    host, _, port = value.rpartition(":")
    if not host or not port.isdigit():
        raise argparse.ArgumentTypeError(f"expected HOST:PORT, got {value!r}")
    return host, int(port)


def pump(src, dst):
    try:
        while True:
            data = src.recv(CHUNK)
            if not data:
                break
            dst.sendall(data)
    except OSError:
        pass
    finally:
        # Half-close so the peer sees EOF in this direction while the other one may still flow.
        try:
            dst.shutdown(socket.SHUT_WR)
        except OSError:
            pass


def serve(client, target):
    try:
        upstream = socket.create_connection(target, timeout=5)
    except OSError as error:
        print(f"ioa-netns-forward: {target[0]}:{target[1]} unreachable in netns: {error}",
              file=sys.stderr, flush=True)
        client.close()
        return
    upstream.settimeout(None)
    back = threading.Thread(target=pump, args=(upstream, client), daemon=True)
    back.start()
    pump(client, upstream)
    back.join()
    client.close()
    upstream.close()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--netns", default="/run/netns/ioa")
    parser.add_argument("endpoints", nargs="+", type=parse_endpoint)
    args = parser.parse_args()

    listeners = []
    for host, port in args.endpoints:
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        sock.bind((host, port))
        sock.listen(128)
        sock.setblocking(False)
        listeners.append((sock, (host, port)))

    with open(args.netns, "rb") as handle:
        os.setns(handle.fileno(), os.CLONE_NEWNET)

    selector = selectors.DefaultSelector()
    for sock, target in listeners:
        selector.register(sock, selectors.EVENT_READ, target)
    print("ioa-netns-forward: forwarding " +
          " ".join(f"{h}:{p}" for _, (h, p) in listeners) + f" into {args.netns}", flush=True)
    while True:
        for key, _ in selector.select():
            try:
                client, _ = key.fileobj.accept()
            except BlockingIOError:
                continue
            client.setblocking(True)
            threading.Thread(target=serve, args=(client, key.data), daemon=True).start()


if __name__ == "__main__":
    main()

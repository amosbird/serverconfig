#!/usr/bin/env bash
# netmode — network mode controller
#
# Policy *inputs*, not policy mechanism. The routing layout lives in exactly
# one place — scripts/network-reconfigure — and this tool never installs a rule
# itself. It records an intent and asks for reconvergence.
#
# Earlier versions reimplemented the whole rule layout here, which meant two
# sources of truth that drifted apart: `netmode status` reported "IOA: OFF"
# while the IOA rules were in fact installed, because network-reconfigure had
# put them there and netmode only knew about its own state files. State is now
# derived from the kernel, and mode files only steer the reconciler.
#
# Usage:
#   netmode status          Show current routing & DNS state
#   netmode cn on|off       China-direct routing (on by default)
#   netmode dns MODE        SmartDNS profile: travel | ioa | office
#   netmode office          Office LAN: intranet reachable without the tunnel
#   netmode apply           Re-run the reconciler now
#   netmode reset           Drop all custom rules and reconverge

set -euo pipefail

STATE_DIR="/run/netmode"
# CN routing is on by default, so the marker records the *exception*. Recording
# the positive case instead would be wrong: the state would be recreated on the
# next link change and `cn off` would silently undo itself.
CN_DISABLED="$STATE_DIR/cn-disabled"
DNS_MODE_STATE="$STATE_DIR/dns-mode"

NETMODE_CONF_DIR="/home/amos/git/serverconfig/network/smartdns"
SMARTDNS_MODE_FILE="/etc/smartdns/mode.conf"
RECONFIGURE="/home/amos/scripts/network-reconfigure"

# Priorities owned by the reconciler; used here only to report state.
P_UNDERLAY=500
P_IOA=2500
P_CN=4000
P_ESCAPE=4500

ensure_root() {
    if ((UID != 0)) && [[ -z "${SUDO_UID:-}" ]]; then
        exec sudo "$0" "$@"
    fi
}

notify() {
    local user_id
    user_id=$(id -u "${SUDO_USER:-amos}" 2>/dev/null || echo 1000)
    sudo -u "${SUDO_USER:-amos}" \
        DISPLAY=:0 DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$user_id/bus" \
        notify-send -a "netmode" "$*" 2>/dev/null || true
}

# Single entry point to the routing layout.
reconverge() { "$RECONFIGURE"; }

dns_mode() {
    local mode="$1" src="$NETMODE_CONF_DIR/mode-${mode}.conf"
    if [ ! -f "$src" ]; then
        echo "ERROR: DNS mode config not found: $src" >&2
        return 1
    fi
    mkdir -p "$STATE_DIR"
    cp "$src" "$SMARTDNS_MODE_FILE"
    systemctl restart smartdns 2>/dev/null || true
    echo "$mode" > "$DNS_MODE_STATE"
    echo "  DNS mode: $mode"
}

# --- Commands ---

cmd_status() {
    local n
    echo "=== netmode status ==="
    printf "  DNS:      %s\n" \
        "$(cat "$DNS_MODE_STATE" 2>/dev/null || echo 'travel (default)')"

    # Reported from the kernel, never from a state file: the routing table is
    # the only thing that is actually true.
    n=$(ip rule show pref "$P_UNDERLAY" | wc -l)
    printf "  underlay: %s rules, %s routes\n" \
        "$n" "$(ip route show table 500 2>/dev/null | wc -l)"

    n=$(ip rule show pref "$P_IOA" | wc -l)
    if [ "$n" -gt 0 ] && ip route show table ioa 2>/dev/null | grep -q .; then
        printf "  IOA:      ON (%s rules, tunnel %s)\n" "$n" \
            "$(ip -4 addr show tun0 &>/dev/null && echo up || echo DOWN)"
    else
        printf "  IOA:      OFF\n"
    fi

    if [ -e "$CN_DISABLED" ]; then
        printf "  CN:       OFF (disabled via 'netmode cn off')\n"
    elif ip rule show pref "$P_CN" | grep -q .; then
        printf "  CN:       ON (%s routes)\n" \
            "$(ip route show table cn 2>/dev/null | wc -l)"
    else
        printf "  CN:       OFF\n"
    fi

    if ip rule show pref "$P_ESCAPE" | grep -q .; then
        printf "  escape:   ACTIVE — exit node unusable, bypassing\n"
    else
        printf "  escape:   inactive\n"
    fi

    echo ""
    echo "  Default route: $(ip -4 route show default | head -1)"
    printf "  DNS resolves:  %s\n" \
        "$(dig +short +timeout=2 google.com @127.0.0.1 2>/dev/null | head -1 || echo FAILED)"
}

cmd_cn() {
    mkdir -p "$STATE_DIR"
    case "$1" in
        on)  rm -f "$CN_DISABLED"; reconverge; notify "CN routing enabled" ;;
        off) touch "$CN_DISABLED"; reconverge; notify "CN routing disabled" ;;
        *)   echo "Usage: netmode cn on|off" >&2; return 1 ;;
    esac
}

cmd_office() {
    # On the office LAN the intranet is directly reachable, so only DNS changes;
    # the reconciler keeps the IOA rules harmlessly in place (table ioa has no
    # route while the tunnel is down).
    dns_mode office
    notify "Office mode (wired LAN)"
}

cmd_dns() {
    case "${1:-}" in
        travel|ioa|office) dns_mode "$1" ;;
        *)
            echo "Usage: netmode dns travel|ioa|office" >&2
            echo "  Current: $(cat "$DNS_MODE_STATE" 2>/dev/null || echo travel)" >&2
            return 1
            ;;
    esac
}

cmd_reset() {
    rm -f "$CN_DISABLED"
    dns_mode travel
    reconverge
    notify "Routing reset to defaults"
}

# --- Main ---

ensure_root "$@"

case "${1:-}" in
    status) cmd_status ;;
    cn)     cmd_cn "${2:-}" ;;
    office) cmd_office ;;
    dns)    cmd_dns "${2:-}" ;;
    apply)  reconverge ;;
    reset)  cmd_reset ;;
    *)
        cat >&2 <<'EOF'
Usage: netmode {status|cn on|off|dns MODE|office|apply|reset}

  status  — show routing & DNS state, read from the kernel
  cn on   — China-direct routing via the physical gateway (default)
  cn off  — send China traffic through the exit node instead
  dns     — SmartDNS profile: travel | ioa | office
  office  — office LAN: intranet DNS, tunnel not needed
  apply   — re-run the reconciler now
  reset   — defaults, then reconverge

Routing rules are owned by network-reconfigure and applied automatically on
every link change; this tool only records intent and asks it to re-run.
EOF
        exit 1
        ;;
esac

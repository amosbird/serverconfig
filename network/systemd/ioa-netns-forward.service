# Keep the host addresses iOA used to serve on (127.0.0.1:12639 for corkscrew, the PAC file and
# browsers; 56100/56101 for the GUI) answering now that iOA listens inside netns `ioa`.
[Unit]
Description=Forward host loopback ports into the iOA namespace
Requires=ioa-netns.service
After=ioa-netns.service

[Service]
ExecStart=/usr/local/lib/ioa/ioa-netns-forward --netns /run/netns/ioa \
    127.0.0.1:12639 127.0.0.1:12649 127.0.0.1:12679 127.0.0.1:12759 127.0.0.1:12769 \
    127.0.0.1:12101 127.0.0.1:56100 127.0.0.1:56101
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target

#!/usr/bin/env bash
# ioa-netns — create or remove the network namespace iOA runs in.
#
# Usage: ioa-netns up | down | status
#
# Topology: veth-ioa (host, 169.254.170.1/30) <-> veth-ioa-ns (in netns `ioa`, 169.254.170.2/30).
# Inside the namespace there is one default route via the host end and nothing else, so iOA sees a
# single uplink whose address never changes. The host masquerades that traffic onto whatever
# physical device carries main's default, and policy routing keeps it off the Tailscale exit node.
#
# Everything here is idempotent: `up` converges an existing namespace, `down` tolerates partial state.
set -euo pipefail

NS=${IOA_NETNS:-ioa}
HOST_IF=${IOA_NETNS_HOST_IF:-veth-ioa}
NS_IF=${IOA_NETNS_NS_IF:-veth-ioa-ns}
HOST_ADDR=${IOA_NETNS_HOST_ADDR:-169.254.170.1}
NS_ADDR=${IOA_NETNS_NS_ADDR:-169.254.170.2}
PREFIX=${IOA_NETNS_PREFIX:-30}
NET=${IOA_NETNS_NET:-169.254.170.0/30}
# Below Tailscale's 5210-5270 and the repository's 1000 band, above nothing that matters.
RULE_PREF=${IOA_NETNS_RULE_PREF:-900}
RULE_RETURN_PREF=${IOA_NETNS_RULE_RETURN_PREF:-900}
RULE_STOP_PREF=${IOA_NETNS_RULE_STOP_PREF:-901}
# Ahead of RULE_PREF: while the office wire is 802.1X-authorized, network-reconfigure keeps its
# default in this table (and flushes it otherwise, so the lookup falls through to main).
RULE_UNDERLAY_PREF=${IOA_NETNS_RULE_UNDERLAY_PREF:-899}
UNDERLAY_TABLE=${IOA_NETNS_UNDERLAY_TABLE:-19}
NFT_TABLE=${IOA_NETNS_NFT_TABLE:-ioa_netns}
TUNNEL_TABLE=${IOA_NETNS_TUNNEL_TABLE:-ioa}
TUN_IF=${IOA_NETNS_TUN_IF:-tun0}
# Inside the namespace, where nothing else has rules.
NS_RULE_PREF=${IOA_NETNS_NS_RULE_PREF:-100}
IP=${IP_OVERRIDE:-ip}
NFT=${NFT_OVERRIDE:-nft}
SYSCTL=${SYSCTL_OVERRIDE:-sysctl}

log() { printf 'ioa-netns: %s\n' "$*"; }

in_ns() { "$IP" netns exec "$NS" "$@"; }

ns_exists() { "$IP" netns list | awk '{print $1}' | grep -qx "$NS"; }

up() {
    ns_exists || "$IP" netns add "$NS"
    in_ns "$IP" link set lo up
    if ! "$IP" link show "$HOST_IF" >/dev/null 2>&1; then
        "$IP" link add "$HOST_IF" type veth peer name "$NS_IF" netns "$NS"
    fi
    "$IP" addr replace "$HOST_ADDR/$PREFIX" dev "$HOST_IF"
    "$IP" link set "$HOST_IF" up
    in_ns "$IP" addr replace "$NS_ADDR/$PREFIX" dev "$NS_IF"
    in_ns "$IP" link set "$NS_IF" up
    in_ns "$IP" route replace default via "$HOST_ADDR" dev "$NS_IF"
    # SmartGateAgent's tunnel default goes to table ioa in here too (scripts/overrides/ip), so iOA's
    # own traffic keeps the uplink, exactly as on the host before. Only what the host sends in is
    # looked up there; with no tunnel the table is empty and that traffic falls through to the
    # uplink default, where the forward filter below refuses it.
    in_ns "$IP" -4 rule del pref "$NS_RULE_PREF" 2>/dev/null || true
    in_ns "$IP" -4 rule add pref "$NS_RULE_PREF" iif "$NS_IF" lookup "$TUNNEL_TABLE"

    # Forwarding has to be on for the host end and for the uplink, because replies enter on the
    # uplink and are forwarded back to the namespace. Inside, the namespace forwards between the
    # veth and tun0 for the host's tunnel traffic.
    "$SYSCTL" -q -w "net.ipv4.conf.$HOST_IF.forwarding=1"
    "$SYSCTL" -q -w net.ipv4.ip_forward=1
    # Loose reverse-path check: replies from the uplink come back on a different device than the
    # namespace's traffic left by, and strict mode would drop them.
    "$SYSCTL" -q -w "net.ipv4.conf.$HOST_IF.rp_filter=2"
    # The namespace's DNS is the host's SmartDNS on 127.0.0.1:53 (see the DNAT below); delivering a
    # packet that arrives on the veth to a loopback address needs route_localnet on that device.
    "$SYSCTL" -q -w "net.ipv4.conf.$HOST_IF.route_localnet=1"

    # Namespace traffic looks up main (the physical default), never the Tailscale exit node table.
    # It is matched by the input device, not by source address: the host end of the veth carries a
    # /30 address too, and a `from` rule would also catch the host's own sockets the moment they
    # pick that address as the source for a route through the veth, sending them to main instead of
    # table ioa. The stop rule makes a missing physical route fail closed, immediately and visibly
    # to iOA, instead of falling through to the exit node at 5270. The `to` rule is for the return
    # path: replies are de-masqueraded to the namespace address before the routing decision, and
    # without it the host's catch-all would send them into the exit node instead of back over the
    # veth.
    # The office wire comes first, exactly like iOA's control traffic used to (pref 400): at an
    # office desk the iOA cloud names resolve to intranet addresses only that wire reaches, and iOA
    # decides it is "outer net" if it is sent out of Wi-Fi.
    reconcile_rule "$RULE_UNDERLAY_PREF" "iif $HOST_IF lookup $UNDERLAY_TABLE"
    reconcile_rule "$RULE_PREF" "iif $HOST_IF lookup main"
    reconcile_rule "$RULE_RETURN_PREF" "to $NET lookup main"
    reconcile_rule "$RULE_STOP_PREF" "iif $HOST_IF prohibit"

    "$NFT" -f - <<EOF
destroy table ip $NFT_TABLE
add table ip $NFT_TABLE
add chain ip $NFT_TABLE postrouting { type nat hook postrouting priority srcnat; policy accept; }
add rule ip $NFT_TABLE postrouting ip saddr $NET oifname != "$HOST_IF" masquerade
add chain ip $NFT_TABLE prerouting { type nat hook prerouting priority dstnat; policy accept; }
add rule ip $NFT_TABLE prerouting iifname "$HOST_IF" ip daddr $HOST_ADDR meta l4proto { tcp, udp } th dport 53 dnat to 127.0.0.1
EOF

    # The host reaches the tunnel through the namespace. Host policy keeps deciding what is iOA
    # traffic (pref 1150/1151 send it to table `ioa`); table `ioa` now hands all of it to the
    # namespace end of the veth. Inside, it is forwarded into tun0 and masqueraded to the tun0
    # address, the source SmartGateAgent's tunnel expects, so replies come back the same way.
    # Host traffic may only leave the namespace through the tunnel. Without tun0 (iOA stopped or
    # logged out) the namespace's default points back at the host, which would carry intranet
    # destinations out of the physical uplink; the forward filter refuses them at once instead.
    "$IP" route replace default via "$NS_ADDR" dev "$HOST_IF" table "$TUNNEL_TABLE"
    # Whether a new namespace forwards depends on what it inherited; it must forward between the
    # veth and tun0, so say so explicitly.
    in_ns "$SYSCTL" -q -w net.ipv4.ip_forward=1
    in_ns "$SYSCTL" -q -w "net.ipv4.conf.$NS_IF.rp_filter=2"
    # The refusals below are only immediate if they are sent: ICMP rate limiting otherwise swallows
    # them and the host's sockets wait out their own timeout. The namespace sends no other ICMP.
    in_ns "$SYSCTL" -q -w net.ipv4.icmp_ratelimit=0
    # DNS. iOA.bin and SmartGateAgent ask 127.0.0.1:53, the host's SmartDNS (resolv.conf is pinned
    # to it and must stay pinned, see network/resolv-pin). In the namespace nothing listens there, so
    # those queries are sent to the host end of the veth, which hands them to SmartDNS. A loopback
    # source may not leave on the veth without route_localnet and is masqueraded to NS_ADDR.
    in_ns "$SYSCTL" -q -w "net.ipv4.conf.$NS_IF.route_localnet=1"
    in_ns "$NFT" -f - <<EOF
destroy table ip $NFT_TABLE
add table ip $NFT_TABLE
add chain ip $NFT_TABLE postrouting { type nat hook postrouting priority srcnat; policy accept; }
add rule ip $NFT_TABLE postrouting iifname "$NS_IF" oifname != "$NS_IF" masquerade
add rule ip $NFT_TABLE postrouting ip saddr 127.0.0.0/8 oifname "$NS_IF" masquerade
add chain ip $NFT_TABLE output { type nat hook output priority dstnat; policy accept; }
add rule ip $NFT_TABLE output ip daddr 127.0.0.1 meta l4proto { tcp, udp } th dport 53 dnat to $HOST_ADDR
# The host's queries to iOA's own resolver (on the tunnel address, so local here) arrive from the
# veth. Rewrite their source to the address they are sent to, the source they had while tun0 was on
# the host, so the resolver sees the same peer as before and never needs to answer the veth.
add chain ip $NFT_TABLE input { type nat hook input priority srcnat; policy accept; }
add rule ip $NFT_TABLE input iifname "$NS_IF" ip daddr != $NS_ADDR snat ip to ip daddr
add chain ip $NFT_TABLE forward { type filter hook forward priority filter; policy accept; }
add rule ip $NFT_TABLE forward iifname "$NS_IF" oifname != "$TUN_IF" meta l4proto tcp reject with tcp reset
add rule ip $NFT_TABLE forward iifname "$NS_IF" oifname != "$TUN_IF" reject with icmp type admin-prohibited
EOF
    log "up: $NS ($NS_ADDR) via $HOST_IF ($HOST_ADDR)"
}

reconcile_rule() {
    local pref=$1 spec=$2 err
    # The kernel refuses an identical rule with EEXIST, so a re-run adds nothing, while two different
    # rules can still share a priority. Comparing `ip rule show` text instead breaks on table names:
    # it prints `lookup wired_underlay` for a rule added as `lookup 19`.
    # shellcheck disable=SC2086
    err=$("$IP" -4 rule add pref "$pref" $spec 2>&1) || [[ $err == *'File exists'* ]] || {
        printf '%s\n' "$err" >&2
        return 1
    }
}

down() {
    "$NFT" delete table ip "$NFT_TABLE" 2>/dev/null || true
    # Deleting the veth also drops the table route through it; the route is only left behind if the
    # link is already gone, so it is not removed separately.
    local pref
    for pref in "$RULE_UNDERLAY_PREF" "$RULE_PREF" "$RULE_RETURN_PREF" "$RULE_STOP_PREF"; do
        while "$IP" -4 rule del pref "$pref" 2>/dev/null; do :; done
    done
    "$IP" link del "$HOST_IF" 2>/dev/null || true
    ! ns_exists || "$IP" netns del "$NS"
    log "down"
}

status() {
    ns_exists && log "namespace $NS present" || { log "namespace $NS absent"; return 1; }
    "$IP" -br addr show "$HOST_IF" 2>/dev/null || log "host link $HOST_IF missing"
    in_ns "$IP" -br addr
    in_ns "$IP" route
    "$IP" -4 rule show pref "$RULE_UNDERLAY_PREF"
    "$IP" -4 rule show pref "$RULE_PREF"
    "$IP" -4 rule show pref "$RULE_STOP_PREF"
}

case ${1:-} in
    up) up ;;
    down) down ;;
    status) status ;;
    *) echo "usage: $0 up|down|status" >&2; exit 2 ;;
esac

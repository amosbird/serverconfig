#!/usr/bin/env bash

export PATH=/home/amos/scripts/overrides:$PATH

ip_bin=${SMARTGATE_IP_BIN:-ip}
agent=${SMARTGATE_AGENT_BIN:-/usr/lib/iOA/bin/SmartGateAgent.bin}
retry=${SMARTGATE_RETRY_SECONDS:-1}
lock=${SMARTGATE_LOCK_FILE:-/run/smartgateagent-wrapper.lock}

exec 9>"$lock"
flock -n 9 || exit 0

until "$ip_bin" -4 route show table main default |
    grep -qE ' dev (en|eth|wl)'; do
    sleep "$retry" 9>&-
done

exec -a SmartGateAgent "$agent" "$@"

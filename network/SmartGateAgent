#!/usr/bin/env bash

# Wrapper around the versioned SmartGateAgent ELF.
#
# The agent must look exactly as the vendor launches it
# (`/usr/lib/iOA/bin/SmartGateAgent -logpath=...` from iOA.bin), because two
# processes look for it, and each looks in a different place:
# 1. iOA.bin probes liveness with `killall SmartGateAgent`, which matches
#    /proc/*/comm. comm is the executable basename truncated to 15 chars, so
#    exec'ing SmartGateAgent.bin yields comm=SmartGateAgent. and killall never
#    finds it. Exec a same-FS hardlink whose basename is exactly SmartGateAgent.
# 2. iOALinux (the GUI, since 1.0.3.88) scans /proc/*/cmdline and only counts
#    the agent when argv[0] is that full launch path. With a bare
#    argv[0]=SmartGateAgent it logged `No SmartGateAgent Runing` every 5s and
#    re-sent the agent3 mode each time. That made the agent tear down and rebuild
#    tables 20/230 and the tun0 default 17k times a day.
# The agent resolves conf.yaml from cwd, which is why the cwd is the bin dir.
# Assets such as error.html and root.crt resolve from the executable's real
# directory, .real, where they have never existed under any argv[0].

export PATH=/home/amos/scripts/overrides:$PATH

ip_bin=${SMARTGATE_IP_BIN:-ip}
agent=${SMARTGATE_AGENT_BIN:-/usr/lib/iOA/bin/SmartGateAgent.bin}
retry=${SMARTGATE_RETRY_SECONDS:-1}
lock=${SMARTGATE_LOCK_FILE:-/run/smartgateagent-wrapper.lock}
bindir=${SMARTGATE_BINDIR:-/usr/lib/iOA/bin}
realdir=${SMARTGATE_REALDIR:-$bindir/.real}
real=$realdir/SmartGateAgent
argv0=${SMARTGATE_ARGV0:-/usr/lib/iOA/bin/SmartGateAgent}

exec 9>"$lock"
flock -n 9 || exit 0

until "$ip_bin" -4 route show table main default |
    grep -qE ' dev (en|eth|wl)'; do
    sleep "$retry" 9>&-
done

mkdir -p "$realdir"
target=$(readlink -f "$agent")
ln -f "$target" "$real"

cd "$bindir" || exit 1
exec -a "$argv0" "$real" "$@"
